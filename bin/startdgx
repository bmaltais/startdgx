SHA_RE = re.compile(r"^[0-9a-f]{64}\Z")

# Read-only, for uninstall: what the engine made under the user's home. Model quadlets carry the engine's header;
# its network quadlet has none, so it's known by its name and network. JSON comes back base64'd, to parse here.
USER_PROBE = 'echo "user=$(id -un)"\necho "home=$HOME"\n'
UNINSTALL_PROBE = USER_PROBE + f'''
q=$HOME/{QUADLET_DIR}
for f in "$q"/omarchy-agent-local-model-*.container; do
  if [ -f "$f" ] && head -1 "$f" | grep -qF -e '{QUADLET_HEADER}' -e '{LEGACY_QUADLET_HEADER}'; then echo "quadlet=${{f##*/}}"; sed -n 's/^Image=/image=/p' "$f"; fi
done
if grep -qsx 'NetworkName={NETWORK}' "$q/{NETWORK}.network"; then echo quadlet={NETWORK}.network; fi
if [ -f ~/{UNINSTALL_IMAGES} ]; then sed 's/^/image=/' ~/{UNINSTALL_IMAGES}; fi
if [ -f ~/{ENGINE_CONFIG}/shares.json ]; then echo "shares=$(base64 -w0 <~/{ENGINE_CONFIG}/shares.json)"; fi
if command -v tailscale >/dev/null; then
  if serve=$(tailscale serve status --json 2>/dev/null); then echo "serve=$(printf '%s' "$serve" | base64 -w0)"; else echo serve=error; fi
fi
if command -v podman >/dev/null; then
  echo podman=yes
  if podman network exists {NETWORK}; then echo network=yes; fi
  if podman secret inspect {SECRET} >/dev/null 2>&1; then echo secret=yes; fi
fi
for path in {ENGINE_DIR} {ENGINE_STATE} {ENGINE_CONFIG} {ENGINE_DATA} {SHARE_UNIT}; do
  if [ -e "$HOME/$path" ]; then echo "exists=$path"; fi
done
if [ -d ~/{ENGINE_DATA} ]; then echo "models_bytes=$(du -sb ~/{ENGINE_DATA} | cut -f1)"; fi
if [ -f ~/{COMFYUI_RECORDS} ]; then echo "comfyui=$(grep -o '"path"' ~/{COMFYUI_RECORDS} | wc -l | tr -d ' ')"; fi
if [ -f ~/{FUGUE_HELPER_RECORD} ]; then echo fugue_helper=1; fi
if [ -d ~/{ENGINE_RECIPES} ]; then echo "recipes=$(ls ~/{ENGINE_RECIPES}/*.toml 2>/dev/null | wc -l | tr -d ' ')"; fi
exit 0
'''

# Read-only, for delete --dry-run: what the engine's remove of the recipe (argv[1]) would free, as its _remove_files
# counts it: each blob that no other model's files link and that nothing else holds, and for a setup in progress the
# half-downloaded files its record lists. Prints {"set_up", "setting_up", "bytes"}.
REMOVE_PROBE = f'''
import json, os, re, sys
rid, home = sys.argv[1], os.path.expanduser("~")
data, state = os.path.join(home, "{ENGINE_DATA}"), os.path.join(home, "{ENGINE_STATE}")
def stats(top):
  for directory, _, names in os.walk(top):
    for name in names:
      try:
        yield os.stat(os.path.join(directory, name))
      except OSError:
        pass
mine, others = {{}}, set()
models = os.path.join(data, "models")
for entry in sorted(os.listdir(models)) if os.path.isdir(models) else []:
  for info in stats(os.path.join(models, entry)):
    key = (info.st_dev, info.st_ino)
    if entry == rid:
      mine[key] = mine.get(key, 0) + 1
    else:
      others.add(key)
freed = 0
for info in stats(os.path.join(data, "blobs")):
  key = (info.st_dev, info.st_ino)
  if key not in others and info.st_nlink - mine.get(key, 0) == 1:
    freed += info.st_size
set_up = os.path.exists(os.path.join(state, "models", rid + ".json"))
try:
  with open(os.path.join(state, "installing", rid + ".json")) as handle:
    record = json.load(handle)
except (OSError, ValueError):
  record = None
setting_up = not set_up and isinstance(record, dict)
for name in (record.get("partials") or []) if setting_up else []:
  if isinstance(name, str) and re.fullmatch(r"[0-9a-f]{{40}}|[0-9a-f]{{64}}", name.removesuffix(".part")):
    path = os.path.join(data, "staging", name)
    if os.path.isfile(path):
      freed += os.path.getsize(path)
print(json.dumps({{"set_up": set_up, "setting_up": setting_up, "bytes": freed}}))
'''

# Read-only: prints key=value lines about the host. Bash, since python3 may be one of the missing tools.
PROBE = USER_PROBE + r'''
echo "gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
echo "dgx_name=$(sed -n 's/^DGX_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/dgx-release 2>/dev/null | head -1)"
for tool in @PACKAGES@; do
  if command -v "$tool" >/dev/null; then echo "$tool=yes"; else echo "$tool=no"; fi
done
echo "linger=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)"
echo "podman_major=$(podman version --format '{{.Client.Version}}' 2>/dev/null | cut -d. -f1)"
if grep -qs additionalGids /var/run/cdi/nvidia.yaml; then echo var_cdi_gids=yes; else echo var_cdi_gids=no; fi
if grep -qs '^\*[[:space:]]*hard[[:space:]]*memlock[[:space:]]*unlimited' /etc/security/limits.d/*.conf; then
  echo memlock_limits=yes; else echo memlock_limits=no; fi
for path in @ROOT_FILES@; do
  if [ -e "$path" ]; then
    if head -2 "$path" | grep -qF -e @RDMA_HEADER@ -e @COMPAT_HEADER@; then owner=engine; else owner=other; fi
    echo "file:$path=$(sha256sum <"$path" | cut -c1-64) $owner"
  else
    echo "file:$path="
  fi
done
link=@AGENT_LINK@
if [ -L "$link" ]; then echo link_kind=symlink; echo "link_target=$(readlink "$link")"
elif [ -e "$link" ]; then echo link_kind=file; echo link_target=; echo "link_sha=$(sha256sum <"$link" | cut -c1-64)"
else echo link_kind=none; echo link_target=; fi
engine=$HOME/@ENGINE_DIR@
if [ -f "$engine/agent_local.py" ]; then echo "engine=$(sha256sum <"$engine/agent_local.py" | cut -c1-64)"
elif [ -d "$engine" ]; then echo engine=present
else echo engine=; fi
# Who tailscale lets run serve without root ("?": not readable by this user); nothing when tailscale isn't there.
if command -v tailscale >/dev/null; then
  if prefs=$(tailscale debug prefs 2>/dev/null); then
    echo "operator=$(printf '%s' "$prefs" | sed -n 's/.*"OperatorUser": *"\([^"]*\)".*/\1/p' | head -1)"
  else echo 'operator=?'; fi
fi
'''
for name, value in (("PACKAGES", " ".join(PACKAGES)), ("ROOT_FILES", " ".join(ROOT_FILES)), ("RDMA_HEADER", shlex.quote(RDMA_HEADER)),
                    ("COMPAT_HEADER", shlex.quote(COMPAT_HEADER)), ("AGENT_LINK", AGENT_LINK), ("ENGINE_DIR", ENGINE_DIR)):
  PROBE = PROBE.replace(f"@{name}@", value)


# Discover's probe: the install's own read-only PROBE, plus whether startdgx's manifest is there.
DISCOVER_PROBE = PROBE + f'if [ -f "$HOME/{STARTDGX_DIR}/manifest.json" ]; then echo startdgx=yes; else echo startdgx=; fi\n'


class Error(Exception):
  pass


# Terminal controls a host could print to act on this terminal (an OSC 52 clipboard write, a CSI that redraws it):
# C0 but newline and tab, DEL, and C1. Everything startdgx passes on from a host goes through clean().
CONTROLS = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")
# What the root script prints reaches a terminal through a pty, where a line ends in a carriage return too.
TTY_CONTROLS = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")


def clean(text):
  return CONTROLS.sub("", text)


# The commands running now (discover runs several at once, in threads), so a signal can end them all; and whether
# startdgx is stopping, after which none starts.
CHILDREN = set()
STOPPING = False


def run_process(cmd, stdin=None, timeout=None):
  """subprocess.run for a command whose output comes from a host: text with undecodable bytes replaced, and
  terminal controls taken out of stdout and stderr. It is ended with startdgx (stop_children)."""
  if STOPPING:
    raise Error("startdgx is stopping")
  with subprocess.Popen(cmd, stdin=subprocess.PIPE if stdin is not None else None, stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE, text=True, errors="replace") as proc:
    CHILDREN.add(proc)
    try:
      out, err = proc.communicate(stdin, timeout=timeout)
    except BaseException:
      proc.kill()
      raise
    finally:
      CHILDREN.discard(proc)
  return subprocess.CompletedProcess(cmd, proc.returncode, clean(out), clean(err))


def stop_children(signum, _frame):
  """On SIGTERM, SIGINT or SIGHUP (a shell restart ends the panel's processes): end every command startdgx runs, so
  no ssh is left behind, then exit."""
  global STOPPING
  STOPPING = True
  for proc in list(CHILDREN):
    with contextlib.suppress(OSError):
      proc.kill()
  raise SystemExit(128 + signum)


def run_on_tty(cmd):
  """Runs cmd on a pty of its own, relaying this terminal's input to it (sudo's password prompt) and its output back
  without terminal controls; returns its exit code."""
  decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
  # What was printed here before goes first: the relay writes to the terminal directly.
  sys.stdout.flush()
  sys.stderr.flush()

  def read(fd):
    while True:
      data = os.read(fd, 4096)
      if not data:
        return data
      shown = TTY_CONTROLS.sub("", decoder.decode(data)).encode()
      # An empty answer would read as the end of the output.
      if shown:
        return shown

  return os.waitstatus_to_exitcode(pty.spawn(cmd, read))


def config_dir():
  return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "startdgx")


def config_path():
  # Demo mode keeps its own machines, so the real list is never read or written.
  return os.path.join(demo_dir() if DEMO else config_dir(), "hosts.json")


def load_hosts():
  try:
    with open(config_path()) as f:
      return json.load(f)
  except FileNotFoundError:
    return {}


@contextlib.contextmanager
def hosts_changing():
  """The hosts to change, saved when the block ends; one change at a time, so an add and a forget running at once
  (the panel runs them in parallel) never lose each other's."""
  os.makedirs(os.path.dirname(config_path()), exist_ok=True)
  with open(config_path() + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    hosts = load_hosts()
    yield hosts
    write_json(config_path(), hosts)


def target(host):
  if host not in load_hosts():
    raise Error(f"{host} isn't added. Run: startdgx add {host}")
  if not TARGET_RE.match(host):
    raise Error("Not an SSH target")
  return host


def ssh(host, *argv, timeout=None, check=True):
  return ssh_raw(host, f"{ENGINE} {shlex.join(argv)}", timeout=timeout, check=check, what=argv[0])


def ssh_raw(host, command, stdin=None, timeout=None, check=True, what="command", opts=SSH_OPTS):
  """Runs a fixed shell command on the host; anything variable in it must already be shlex-quoted."""
  cmd = ["ssh", *opts, "--", host, command]
  try:
    result = run_process(cmd, stdin=stdin, timeout=timeout)
  except subprocess.TimeoutExpired as error:
    raise Error(f"{host} didn't answer in time") from error
  if check and result.returncode == 255:
    raise_ssh_failure(host, result.stderr, what)
  if check and result.returncode != 0:
    lines = (result.stderr.strip().splitlines() or [f"{what} failed on {host}"])
    raise Error(lines[-1].removeprefix("Error: "))
  return result


def raise_ssh_failure(host, stderr, what):
  """The Error for an ssh that itself failed (exit 255), with ssh's own reason when it gave one."""
  raise Error(ssh_failure(host, stderr) if stderr.strip() else f"{what} failed on {host}")


def ssh_target(host):
  if not TARGET_RE.match(host) or host.startswith("-"):
    raise Error("Name the machine as SSH reaches it, e.g. user@spark-1234.local")
  return host


def recipe(value):
  if not RECIPE_RE.match(value):
    raise Error("Not a recipe id")
  return value


def cmd_add(args):
  profile = json.loads(ssh(ssh_target(args.host), "profile").stdout)
  with hosts_changing() as hosts:
    hosts[args.host] = {"profile": profile}
  print(f"{args.host} added")


def cmd_remove_host(args):
  with hosts_changing() as hosts:
    if hosts.pop(args.host, None) is None:
      raise Error(f"{args.host} isn't added")
  print(f"{args.host} removed from startdgx")


def cmd_hosts(args):
  hosts = load_hosts()
  if args.json:
    print(json.dumps(hosts, indent=2))
  for host in hosts if not args.json else ():
    print(host)


def passthrough(*engine_args):
  def run(args):
    out = ssh(target(args.host), *engine_args, *(recipe(args.model),) if getattr(args, "model", None) else (), timeout=args.timeout)
    sys.stdout.write(out.stdout)
  return run


ENGINE_TAG_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)-dgx\.(\d+)$")
MANIFEST_MARK = "#manifest"
HELD_MARK = "#held"
MEMORY_MARK = "#memory"
COMFYUI_MARK = "#comfyui"
# The managed ComfyUI installs that are running, and what each holds and where it listens (read off its command line's
# --port and --listen): one "KiB<TAB>port<TAB>bind<TAB>path" line apiece. It reads the records
# and each install's pid file, nothing else, so a poll costs a few file reads (the real status call is comfyui status).
COMFYUI_RSS = (f"f=$HOME/{COMFYUI_RECORDS}; if [ -f \"$f\" ]; then sed -n 's/^ *\"path\": *\"\\(.*\\)\",*$/\\1/p' \"$f\" | "
               "while IFS= read -r p; do pid=$(cat \"$p/.state/comfyui.pid\" 2>/dev/null); "
               "c=$([ -n \"$pid\" ] && tr '\\0' ' ' </proc/$pid/cmdline 2>/dev/null); "
               "case \"$c\" in *main.py*) "
               "printf '%s\\t%s\\t%s\\t%s\\n' \"$(sed -n 's/^VmRSS:[[:space:]]*\\([0-9]*\\).*/\\1/p' /proc/$pid/status)\" "
               "\"$(printf '%s' \"$c\" | sed -n 's/.*--port \\([0-9][0-9]*\\).*/\\1/p')\" "
               "\"$(printf '%s' \"$c\" | sed -n 's/.*--listen \\([^ ]*\\).*/\\1/p')\" \"$p\";; esac; done; fi;")


def engine_update(host_tag, pinned=None):
  """{"from", "to"} when the engine startdgx installed on the host is an older release than the pin, else None: a
  tag that isn't a release of the fork's, or a newer one (updating would downgrade it), is left alone."""
  pinned = pinned or ENGINE_TAG
  old, new = ENGINE_TAG_RE.match(host_tag or ""), ENGINE_TAG_RE.match(pinned)
  if old and new and tuple(map(int, old.groups())) < tuple(map(int, new.groups())):
    return {"from": host_tag, "to": pinned}
  return None


def cmd_status(args):
  # The manifest's engine tag and the host's MemAvailable ride on the status call, so a poll stays one ssh. MemAvailable
  # is the number the engine's own fit check uses, and it counts what a process outside the engine (ComfyUI, say) holds.
  host = target(args.host)
  out = ssh_raw(host, f"{ENGINE} status --json; rc=$?; if [ $rc = 0 ]; then echo; echo '{MANIFEST_MARK}'; "
                      f"grep -m1 '\"tag\"' {MANIFEST} 2>/dev/null; echo '{HELD_MARK}'; {ENGINE} memory --json 2>/dev/null; echo '{MEMORY_MARK}'; "
                      f"sed -n 's/^MemAvailable: *\\([0-9]*\\).*/\\1/p' /proc/meminfo 2>/dev/null; echo '{COMFYUI_MARK}'; {COMFYUI_RSS} fi; exit $rc",
                timeout=args.timeout, what="status").stdout
  status, _, rest = out.partition(f"\n{MANIFEST_MARK}\n")
  manifest, _, rest = rest.partition(f"{HELD_MARK}\n")
  held, _, rest = rest.partition(f"{MEMORY_MARK}\n")
  memory, _, comfy = rest.partition(f"{COMFYUI_MARK}\n")
  tag = re.search(r'"tag":\s*"([^"]*)"', manifest)
  update = engine_update(tag[1]) if tag else None
  kib = re.match(r"\d+", memory.strip())
  try:
    document = json.loads(status)
  except ValueError:
    document = None
  extra = {}
  if update:
    extra["engine_update"] = update
  if kib:
    extra["ram_available_gib"] = round(int(kib[0]) / 1048576, 1)
  running = [line.split("\t", 3) for line in comfy.splitlines() if line.count("\t") >= 3]
  if running:
    extra["comfyui"] = [{"path": path, "rss_mib": round(int(rss) / 1024), "port": int(port) if port.isdigit() else None, "bind": bind}
                        for rss, port, bind, path in running if rss.isdigit()]
  # What each running model holds now (the engine's `memory --json`, v0.9.0 on): an older engine answers nothing here.
  try:
    live = json.loads(held.strip() or "null")
  except ValueError:
    live = None
  if isinstance(document, dict) and isinstance(live, dict) and isinstance(document.get("models"), dict):
    models = {rid: ({**row, "live_ram_gib": live[rid]} if isinstance(row, dict) and isinstance(live.get(rid), (int, float)) else row)
              for rid, row in document["models"].items()}
    extra["models"] = models
  if extra and isinstance(document, dict):
    sys.stdout.write(json.dumps({**document, **extra}) + "\n")
  else:
    sys.stdout.write(status)


def cmd_list(args):
  sys.stdout.write(ssh(target(args.host), "list", "--json", timeout=args.timeout).stdout)


def cmd_start(args):
  host, rid = target(args.host), recipe(args.model)
  # Weights on a model store whose disk is gone are a folder link to nothing: the engine would fail on its mount.
  storage_run(host, args, "mounted", rid)
  sys.stdout.write(ssh(host, "start", rid, timeout=args.timeout).stdout)


def cmd_stop(args):
  argv = ["stop"] + ([recipe(args.model)] if args.model else [])
  sys.stdout.write(ssh(target(args.host), *argv, timeout=args.timeout).stdout)


def cmd_use(args):
  # --ctx picks one of the contexts the recipe has measured (see variants); on a model already set up the engine
  # restarts it with that one.
  # --yes is the engine's for a recipe of yours: it downloads what the recipe names and runs it, so it is sent only when
  # the person said so (the panel after its confirmation card).
  ctx = (["--ctx", str(args.ctx)] if args.ctx else []) + (["--yes"] if args.yes else [])
  if not args.detach:
    sys.stdout.write(ssh(target(args.host), "use", recipe(args.model), *ctx, timeout=args.timeout or 3600).stdout)
    return
  # The engine runs the setup in a transient user unit and returns, or says one is already running (and starts no
  # second); its last line says which, and it is the one line the panel shows.
  out = ssh(target(args.host), "use", recipe(args.model), *ctx, "--detach", timeout=args.timeout or 120).stdout
  print((out.strip().splitlines() or [f"Setting up {args.model} in the background"])[-1])


def cmd_update(args):
  # The engine's update sets a model up again from the catalog the machine has now (the old one keeps running until the new
  # one has started; files that didn't change aren't fetched again). It runs in a transient unit and returns, as use --detach
  # does, so the panel follows the download from the status poll (update_progress); its last line is the one line shown.
  out = ssh(target(args.host), "update", recipe(args.model), "--detach", timeout=args.timeout or 120).stdout
  print((out.strip().splitlines() or [f"Updating {args.model} in the background"])[-1])


# Read-only, for variants: the [[variant]] entries of the recipe (argv[1]) in the engine's recipes folder or the user's,
# largest context first (with each one's source: measured unless the recipe says otherwise). Prints a JSON list, or nothing for a recipe the host doesn't have.
VARIANTS_PROBE = f'''
import json, os, sys, tomllib
recipe = None
# The engine's own recipes, then the user's: a user recipe's id never clashes with a curated one.
for folder in ("{ENGINE_DIR}/recipes/", "{ENGINE_STATE}/recipes/"):
  try:
    with open(os.path.expanduser("~/" + folder + sys.argv[1] + ".toml"), "rb") as handle:
      recipe = tomllib.load(handle)
    break
  except OSError:
    pass
if recipe is None:
  sys.exit(0)
# What the person confirmed (the engine's recipes-confirmed.json: recipe id -> "ctx/ram/gpu" keys, the numbers as the repr of
# the float, as its variant_key writes them: 0.1 and 0.10 are one number, and 20 is 20.0).
try:
  with open(os.path.expanduser("~/{ENGINE_STATE}/recipes-confirmed.json")) as handle:
    confirmed = json.load(handle).get(sys.argv[1], [])
except (OSError, ValueError, AttributeError):
  confirmed = []
def key(v):
  return f"{{v['ctx']}}/{{float(v['peak_ram_gib'])!r}}/{{float(v['peak_gpu_gib'])!r}}"
out = [{{"ctx": v["ctx"], "peak_ram_gib": v["peak_ram_gib"], "peak_gpu_gib": v["peak_gpu_gib"], "source": v.get("source", "measured"),
        "confirmed": v.get("source") == "estimated" and key(v) in confirmed}} for v in recipe.get("variant", [])]
print(json.dumps(sorted(out, key=lambda v: (-v["ctx"], -v["peak_ram_gib"]))))
'''


def parse_variants(text):
  try:
    found = json.loads(text.strip().splitlines()[-1])
    return [{"ctx": int(v["ctx"]), "peak_ram_gib": float(v["peak_ram_gib"]), "peak_gpu_gib": float(v["peak_gpu_gib"]),
             "source": str(v.get("source", "measured")), "confirmed": v.get("confirmed") is True} for v in found] if isinstance(found, list) else None
  except (ValueError, IndexError, KeyError, TypeError):
    return None


def print_variants(variants, as_json):
  if as_json:
    print(json.dumps(variants))
    return
  for v in variants:
    print(f"{v['ctx']}  {v['peak_ram_gib']:g} GiB RAM  {v['peak_gpu_gib']:g} GiB GPU  {v['source']}{' (confirmed)' if v.get('confirmed') else ''}")


def cmd_variants(args):
  host, rid = target(args.host), recipe(args.model)
  out = ssh_raw(host, f"python3 -I - {shlex.quote(rid)}", stdin=VARIANTS_PROBE, timeout=args.timeout, what="probe").stdout
  variants = parse_variants(out) if out.strip() else None
  if not variants:
    raise Error(f"{host} has no measured contexts for {rid}")
  print_variants(variants, args.json)


def cmd_share(args):
  host, rid = target(args.host), recipe(args.model)
  result = ssh(host, "share", rid, *(["--off"] if args.off else []), timeout=args.timeout, check=False)
  if result.returncode == 0:
    sys.stdout.write(result.stdout)
    return
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, "share")
  # The engine saves a share before it publishes it, so one that failed to publish (Serve isn't enabled, no operator)
  # would read as shared with no route: take it back, best effort, and say why in one line (its message spans several).
  reason = " ".join(result.stderr.split()).removeprefix("Error: ") or f"share failed on {host}"
  if "didn't answer" in reason:
    # tailscale serve waits for a click when the tailnet hasn't enabled Serve, and the engine gives up on it after 10 s.
    reason = f"{reason.rstrip('.')}. Serve may not be enabled on the tailnet: enable it at {SERVE_ENABLE_URL}, then share again"
  if args.off:
    raise Error(reason)
  with contextlib.suppress(Error):
    ssh(host, "share", rid, "--off", timeout=60, check=False)
  raise Error(f"{rid} is not shared: {reason}")


# ---- user recipes ------------------------------------------------------------------------------------------
# A recipe the user wrote (a .toml on this computer) goes to the engine's `recipe validate` / `recipe add` on stdin: the
# engine takes the recipe's id from the file's name, so the host gets a copy named for it in a folder of its own.
RECIPE_MAX_BYTES = 256 * 1024
RECIPE_SEND = 'd=$(mktemp -d) && cat > "$d"/{rid}.toml && {engine} recipe {verb} "$d"/{rid}.toml; rc=$?; rm -rf "$d"; exit $rc'


def read_recipe_file(path):
  """(id, text) of a recipe file on this computer, or an Error saying why it can't be one."""
  path = os.path.expanduser(path)
  name = os.path.basename(path)
  if not name.endswith(".toml"):
    raise Error("A recipe file ends in .toml, and its name (without it) is the recipe's id")
  rid = name[:-len(".toml")]
  if not RID_RE.match(rid):
    raise Error(f"{name} can't be a recipe: its id (the name without .toml) is lower-case letters, digits, dots and dashes")
  try:
    if not os.path.isfile(path):
      raise Error(f"{path} isn't a file")
    if os.path.getsize(path) > RECIPE_MAX_BYTES:
      raise Error(f"{name} is too big to be a recipe")
    with open(path, encoding="utf-8") as handle:
      return rid, handle.read()
  except UnicodeDecodeError as error:
    raise Error(f"{name} isn't UTF-8 text") from error
  except OSError as error:
    raise Error(f"{name} can't be read: {error.strerror}") from error


def engine_lines(*streams):
  """What the engine printed, as separate cleaned lines without the Error: it puts before a message."""
  lines = [line.strip().removeprefix("Error: ") for stream in streams for line in clean(stream).splitlines() if line.strip()]
  return [line for line in lines if line]


def recipe_result(ok, rid, errors=(), message=""):
  """The answer of recipe validate and add: { ok, id, errors, message }."""
  return {"ok": ok, "id": rid, "errors": list(errors), "message": message}


def print_recipe_result(result, as_json):
  """validate's and add's answer: JSON for the panel (exit 0, the machine answered), else the message, or the engine's
  errors one to a line on stderr and exit 1."""
  if as_json:
    print(json.dumps(result))
    return 0
  if result["ok"]:
    print(result["message"])
    return 0
  for line in result["errors"]:
    print(line, file=sys.stderr)
  return 1


def recipe_send(host, verb, rid, text, timeout):
  """The engine's validate or add of a recipe's text on a host (already a target), as recipe_result's dict."""
  result = ssh_raw(host, RECIPE_SEND.format(rid=rid, engine=ENGINE, verb=verb), stdin=text, timeout=timeout, check=False, what=f"recipe {verb}")
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, f"recipe {verb}")
  if result.returncode != 0:
    # The engine rejected it: validate prints its errors on stdout, add's on stderr; all of them are the answer.
    return recipe_result(False, rid, engine_lines(result.stdout, result.stderr) or [f"recipe {verb} failed on {host}"])
  return recipe_result(True, rid, message=(engine_lines(result.stdout) or [f"Recipe {rid} {'is valid' if verb == 'validate' else 'added'}"])[-1])


def cmd_recipe_send(args):
  host = target(args.host)
  rid, text = read_recipe_file(args.file)
  return print_recipe_result(recipe_send(host, args.verb, rid, text, args.timeout), args.json)


def cmd_recipe_list(args):
  sys.stdout.write(ssh(target(args.host), "recipe", "list", *(["--json"] if args.json else []), timeout=args.timeout).stdout)


def cmd_recipe_remove(args):
  host, rid = target(args.host), recipe(args.id)
  result = ssh_raw(host, f"{ENGINE} {shlex.join(['recipe', 'remove', rid])}", timeout=args.timeout, check=False, what="recipe remove")
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, "recipe remove")
  if result.returncode != 0:
    # The engine says which model uses the recipe; keep all of its message, on one line.
    raise Error(" ".join(engine_lines(result.stdout, result.stderr)) or f"recipe remove failed on {host}")
  sys.stdout.write(result.stdout)


def cmd_recipe_measure(args):
  """The engine's measure: it loads the recipe at a context, benches it and records what it showed. Without --yes it
  only says what it would download and load (its own dry run); with it, it runs, which takes minutes."""
  host, rid = target(args.host), recipe(args.id)
  argv = ["measure", rid, "--ctx", str(args.ctx)] + (["--yes"] if args.yes else [])
  sys.stdout.write(clean(ssh(host, *argv, timeout=args.timeout or (3600 if args.yes else 60)).stdout))


def cmd_recipe_confirm(args):
  sys.stdout.write(clean(ssh(target(args.host), "recipe", "confirm", recipe(args.id), timeout=args.timeout).stdout))


# add-context: the text of a recipe of yours on the host (the engine has no edit call), printed as it is; exit 3 when
# the host has none of that id among yours.
RECIPE_TEXT_PROBE = f'''
import os, sys
try:
  with open(os.path.expanduser("~/{ENGINE_STATE}/recipes/" + sys.argv[1] + ".toml"), encoding="utf-8") as handle:
    sys.stdout.write(handle.read())
except OSError:
  sys.exit(3)
'''


def recipe_with_context(text, ctx):
  """A recipe's text with one more drafted [[variant]] at `ctx`, its placeholder numbers those of the variant that needs
  the most memory (a drafted variant never counts as fitting, so they only stand in until Measure… writes the real
  ones). An Error when the recipe has that context already or no variant to take numbers from."""
  try:
    variants = tomllib.loads(text).get("variant", [])
  except tomllib.TOMLDecodeError as error:
    raise Error(f"the recipe on the machine isn't valid TOML: {error}") from error
  if any(v.get("ctx") == ctx for v in variants):
    raise Error(f"it has a {ctx // 1024}K context already")
  if not variants:
    raise Error("it has no [[variant]] to take placeholder numbers from")
  top = max(variants, key=lambda v: (float(v["peak_ram_gib"]), float(v["peak_gpu_gib"])))
  return (text.rstrip("\n") + f"\n\n[[variant]]\nctx = {ctx}\npeak_ram_gib = {float(top['peak_ram_gib'])!r}\n"
          f"peak_gpu_gib = {float(top['peak_gpu_gib'])!r}\nsource = \"drafted\"\n")


def recipe_without_context(text, ctx):
  """A recipe's text without its [[variant]] blocks at `ctx`; an Error when it has none there or it would be left with no variant."""
  lines = text.split("\n")
  blocks, start = [], None
  for n, line in enumerate(lines + ["[end]"]):
    if start is not None and line.strip().startswith("["):
      blocks.append((start, n))
      start = None
    if line.strip() == "[[variant]]":
      start = n
  doomed = []
  for a, b in blocks:
    try:
      if tomllib.loads("[[variant]]\n" + "\n".join(lines[a + 1:b]).replace("\t", " ")).get("variant", [{}])[0].get("ctx") == ctx:
        doomed.append((a, b))
    except tomllib.TOMLDecodeError:
      continue
  if not doomed:
    raise Error(f"it has no {ctx // 1024}K context")
  if len(doomed) == len(blocks):
    raise Error("that is its only context: a recipe needs at least one")
  keep = [line for n, line in enumerate(lines) if not any(a <= n < b for a, b in doomed)]
  return "\n".join(keep).rstrip("\n") + "\n"


def fetch_recipe_text(host, rid, timeout, what):
  """The text of a recipe of yours as the host has it (the engine has no show call)."""
  result = ssh_raw(host, f"python3 -I - {shlex.quote(rid)}", stdin=RECIPE_TEXT_PROBE, timeout=timeout, check=False, what=what)
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, what)
  if result.returncode == 3:
    raise Error(f"No recipe of yours named '{rid}' on {host}")
  if result.returncode != 0:
    raise Error(" ".join(engine_lines(result.stderr)) or f"{what} failed on {host}")
  return result.stdout


def cmd_recipe_context(args):
  """Adds a context size to a recipe of yours, or with --remove takes one away: the host's copy changed and put back
  through the engine's own recipe add (it validates, writes atomically, and refuses while a model uses the recipe)."""
  host, rid = target(args.host), recipe(args.id)
  if args.ctx < 1024:
    raise Error("A context is a number of tokens, 1024 or more")
  text = fetch_recipe_text(host, rid, args.timeout, "recipe context")
  try:
    text = recipe_without_context(text, args.ctx) if args.remove else recipe_with_context(text, args.ctx)
  except Error as error:
    raise Error(f"{rid}: {error}") from error
  answer = recipe_send(host, "add", rid, text, args.timeout)
  if not answer["ok"]:
    raise Error(" ".join(answer["errors"]))
  print(f"Removed the {args.ctx // 1024}K context from {rid}" if args.remove
        else f"Added a {args.ctx // 1024}K context to {rid}, drafted: measure it before it counts as fitting")


def fix_prompt(host, rid, path):
  try:
    with open(AUTHOR_BRIEF, encoding="utf-8") as handle:
      brief = handle.read()
  except OSError as error:
    raise Error(f"The authoring brief {os.path.normpath(AUTHOR_BRIEF)} can't be read: {error.strerror}") from error
  return (f"{brief}\nTHIS TASK\nHost: {host}\nA recipe of the person's is already on the machine and something is wrong with it: fix it.\n"
          f"File: {path} (a copy of recipe {rid} as the machine has it; edit this copy)\n"
          f"Find the fault first: run startdgx recipe validate {host} {path}, then startdgx recipe measure {host} {rid} --ctx N without --yes "
          f"for a context the recipe has (it prints what would be downloaded and fails with the engine's reason when the files don't match, "
          f"for one). Fix the file, validate it again, then put it back with startdgx recipe add {host} {path} (it replaces the machine's copy; "
          f"the engine refuses while a model is set up from the recipe, which the person must remove first). Say what you changed.\n")


def cmd_recipe_fix(args):
  host, rid = target(args.host), recipe(args.id)
  agent = agent_command()
  if DEMO:
    path = os.path.join(demo_dir(), "fixes", f"{rid}.toml")
  else:
    path = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "startdgx", "fixes", f"{rid}.toml")
    text = fetch_recipe_text(host, rid, 60, "recipe fix")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as handle:
      handle.write(text)
  argv = agent + [fix_prompt(host, rid, path)]
  if DEMO:
    print(f"Demo: would run '{shlex.join(argv)}' in a terminal")
    return
  sys.stdout.flush()
  try:
    if args.here:
      os.execvp(argv[0], argv)
    os.execvp(LAUNCHER, [LAUNCHER, shlex.join(argv)])
  except OSError as error:
    raise Error(f"Can't start {argv[0] if args.here else LAUNCHER}: {error.strerror}") from error


def cmd_recipe(args):
  return {"validate": cmd_recipe_send, "add": cmd_recipe_send, "list": cmd_recipe_list, "remove": cmd_recipe_remove,
          "measure": cmd_recipe_measure, "confirm": cmd_recipe_confirm, "context": cmd_recipe_context,
          "fix": cmd_recipe_fix, "draft": cmd_recipe_draft, "author": cmd_recipe_author}[args.verb](args)


# For storage, run on the host with python3 -I - MODE [PATH]. The disks mounted there that could hold a model store, and
# the store in use, if one is set (STORE_CONFIG). A disk counts when it is mounted, isn't on the root device's physical
# disk (the efi partition too) and isn't a loop or a snap; it is usable when its filesystem keeps symlinks and
# permissions. A store is present when its marker file is: an unmounted disk leaves an empty mount point, which would
# otherwise take the writes meant for it. The mode "list" is read-only and prints one JSON line; "set" and "unset" print
# nothing, and fail with an "Error:" line on stderr.
STORE_CONFIG = ".local/share/startdgx/store.json"
STORE_MARKER = ".startdgx-store"
STORE_FILESYSTEMS = ("ext4", "xfs", "btrfs")
STORE_PRELUDE = '''
import json, os, subprocess, sys
CONFIG, MARKER, DATA = os.path.expanduser("~/@CONFIG@"), "@MARKER@", os.path.expanduser("~/@DATA@")
def fail(text):
  print("Error: " + text, file=sys.stderr)
  sys.exit(1)
def current():
  try:
    return json.load(open(CONFIG))["path"]
  except (OSError, ValueError, KeyError, TypeError):
    return None
'''
STORAGE_SCRIPT = STORE_PRELUDE + '''
def discover():
  out = json.loads(subprocess.run(["lsblk", "-J", "-b", "-o", "NAME,TYPE,TRAN,FSTYPE,MOUNTPOINT,FSSIZE,FSAVAIL"], capture_output=True, text=True, check=True).stdout)
  flat = []
  def walk(node, top):
    for dev in node:
      owner = top or dev
      flat.append((owner, dev))
      walk(dev.get("children") or [], owner)
  walk(out["blockdevices"], None)
  root = next((top["name"] for top, dev in flat if dev.get("mountpoint") == "/"), None)
  disks = []
  for top, dev in flat:
    mount = dev.get("mountpoint")
    if not mount or mount == "/" or top["name"] == root or dev.get("type") == "loop" or mount.startswith("/snap/"):
      continue
    fstype = dev.get("fstype") or ""
    usable = fstype in @FILESYSTEMS@
    disks.append({"mount": mount, "bus": dev.get("tran") or top.get("tran") or "", "fstype": fstype, "size": int(dev.get("fssize") or 0),
                  "free": int(dev.get("fsavail") or 0), "usable": usable,
                  "reason": "" if usable else (fstype or "this filesystem") + " cannot hold symlinks and permissions; use ext4, xfs or btrfs"})
  return disks
mode = sys.argv[1]
def tree_size(root):
  return sum(os.path.getsize(os.path.join(f, n)) for f, _, names in os.walk(root) for n in names)
def models_found(path, present):
  found = []
  base = os.path.join(DATA, "models")
  for rid in sorted(os.listdir(base)) if os.path.isdir(base) else []:
    states, size = set(), 0
    for fs in sorted(n for n in os.listdir(os.path.join(base, rid)) if "." not in n):
      here = os.path.join(base, rid, fs)
      copy = os.path.join(path, rid, fs) if path and present else None
      if os.path.islink(here):
        state = "usb" if copy and os.path.isdir(copy) else "usb-missing"
        size = None if state == "usb-missing" or size is None else size + tree_size(copy)
      elif os.path.isdir(here):
        state = "both" if copy and os.path.isdir(copy) else "nvme"
        size = None if size is None else size + tree_size(here)
      else:
        continue
      states.add(state)
    if states:
      found.append({"id": rid, "location": states.pop() if len(states) == 1 else "mixed", "bytes": size})
  return found
def linked_into(path):
  # How many files of the engine's blobs and models link into the store at PATH.
  linked = 0
  for folder, _, names in os.walk(os.path.join(DATA, "blobs")):
    for name in names:
      full = os.path.join(folder, name)
      if os.path.islink(full) and os.path.realpath(full).startswith(os.path.realpath(path) + "/"):
        linked += 1
  models = os.path.join(DATA, "models")
  for rid in os.listdir(models) if os.path.isdir(models) else []:
    for name in os.listdir(os.path.join(models, rid)):
      full = os.path.join(models, rid, name)
      if os.path.islink(full) and os.path.realpath(full).startswith(os.path.realpath(path) + "/"):
        linked += 1
  return linked
if mode == "list":
  disks = discover()
  path = current()
  present = bool(path) and os.path.exists(os.path.join(path, MARKER))
  store = {"path": path, "present": present} if path else None
  print(json.dumps({"store": store, "disks": disks, "models": models_found(path, present)}))
elif mode == "mounted":
  # The store counts as mounted when its marker is there, as everywhere else: an unmounted disk may leave a folder behind.
  path = current()
  base = os.path.join(DATA, "models", sys.argv[2])
  for name in os.listdir(base) if os.path.isdir(base) else []:
    on_disk = path and os.path.exists(os.path.join(path, MARKER)) and os.path.isdir(os.path.join(base, name))
    if os.path.islink(os.path.join(base, name)) and not on_disk:
      fail(sys.argv[2] + "'s weights are on the model store, whose disk isn't mounted")
elif mode == "forget":
  import shutil
  path = current()
  if path and os.path.exists(os.path.join(path, MARKER)):
    shutil.rmtree(os.path.join(path, sys.argv[2]), ignore_errors=True)
  elif path:
    print("The model store isn't mounted; what it holds of " + sys.argv[2] + " stays there")
elif mode == "set":
  disks = discover()
  path = sys.argv[2]
  if not os.path.isabs(path) or os.path.normpath(path) != path:
    fail("Give the store as an absolute path without .. or a trailing slash")
  real = os.path.realpath(path)
  home = max((d for d in disks if real == d["mount"] or real.startswith(d["mount"].rstrip("/") + "/")), key=lambda d: len(d["mount"]), default=None)
  if home is None:
    fail(path + " isn't on an external disk; the root disk is where the models already are")
  if not home["usable"]:
    fail(home["mount"] + ": " + home["reason"])
  old = current()
  if old and os.path.realpath(old) != real:
    linked = linked_into(old)
    if linked:
      fail(str(linked) + " model file(s) are on the current store, " + old + "; move those models back first")
  os.makedirs(path, exist_ok=True)
  open(os.path.join(path, MARKER), "a").close()
  os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
  with open(CONFIG + ".new", "w") as f:
    json.dump({"path": path}, f)
  os.replace(CONFIG + ".new", CONFIG)
elif mode == "unset":
  path = current()
  if path:
    linked = linked_into(path)
    if linked:
      fail(str(linked) + " model file(s) are on the store; move those models back first")
    os.remove(CONFIG)
'''.replace("@FILESYSTEMS@", repr(STORE_FILESYSTEMS))
STORE_PRELUDE = STORE_PRELUDE.replace("@CONFIG@", STORE_CONFIG).replace("@MARKER@", STORE_MARKER).replace("@DATA@", ENGINE_DATA)
STORAGE_SCRIPT = STORAGE_SCRIPT.replace("@CONFIG@", STORE_CONFIG).replace("@MARKER@", STORE_MARKER).replace("@DATA@", ENGINE_DATA)

# For move, run on the host with python3 -I - RID DIRECTION HOST. A model's weights live in folders under the engine's
# models/RID, one per fileset, hard-linked to blobs/. The container mounts only that folder, so a link to each file
# would dangle in it; a link to the folder is followed by the mount. "usb" copies a fileset to STORE/RID/FILESET, checks
# every byte, makes the folder a link to the copy, and points the blobs it freed at the copy (the engine looks for them
# when it sets a recipe up again). Only a stopped model moves, and the old files go only after the copy is verified.
MOVE_SCRIPT = STORE_PRELUDE + '''
import hashlib, shutil
rid, direction, host = sys.argv[1:4]
store = current()
if not store:
  fail("No model store is set; set one with: startdgx storage " + host + " --set PATH")
if not os.path.exists(os.path.join(store, MARKER)):
  fail("The model store " + store + " isn't mounted")
base = os.path.join(DATA, "models", rid)
if not os.path.isdir(base):
  fail(rid + " isn't set up")
unit = subprocess.run(["systemctl", "--user", "is-active", "omarchy-agent-local-model-" + rid + ".service"], capture_output=True, text=True).stdout.strip()
if unit in ("active", "activating", "deactivating", "reloading"):
  fail(rid + " is running; stop it first")
def digest(path):
  h = hashlib.sha256()
  with open(path, "rb") as f:
    for chunk in iter(lambda: f.read(1 << 24), b""):
      h.update(chunk)
  return h.hexdigest()
def files(root):
  for folder, _, names in os.walk(root):
    for name in names:
      yield os.path.relpath(os.path.join(folder, name), root)
def size_of(root):
  return sum(os.path.getsize(os.path.join(root, f)) for f in files(root))
# A move that stopped between steps leaves one of two folders beside the fileset: X.moving, the old files kept while the
# link goes in, or X.returning, the files built before they replace the link. If X is gone they are the model's files.
for name in sorted(os.listdir(base)):
  for suffix in (".moving", ".returning"):
    if name.endswith(suffix):
      left, fileset = os.path.join(base, name), os.path.join(base, name[:-len(suffix)])
      if not os.path.lexists(fileset):
        os.rename(left, fileset)
      else:
        shutil.rmtree(left)
filesets = sorted(n for n in os.listdir(base) if "." not in n and os.path.isdir(os.path.join(base, n)))
if direction == "usb":
  total, freed, kept, moved = 0, 0, 0, False
  for fs in filesets:
    here, there = os.path.join(base, fs), os.path.join(store, rid, fs)
    if os.path.islink(here):
      continue
    total += size_of(here)
    part = there + ".partial"
    try:
      shutil.rmtree(part, ignore_errors=True)
      os.makedirs(part)
      for rel in files(here):
        os.makedirs(os.path.dirname(os.path.join(part, rel)), exist_ok=True)
        shutil.copyfile(os.path.join(here, rel), os.path.join(part, rel))
        if digest(os.path.join(here, rel)) != digest(os.path.join(part, rel)):
          raise OSError("the copy of " + rel + " differs from the original")
      os.sync()
      shutil.rmtree(there, ignore_errors=True)
      os.rename(part, there)
    except OSError as error:
      shutil.rmtree(part, ignore_errors=True)
      fail("Couldn't copy " + rid + " to the store: " + str(error))
    blobs = {}
    for folder, _, names in os.walk(os.path.join(DATA, "blobs")):
      for name in names:
        # A blob that is a link (to the store, which may be unmounted) is nobody's hard link.
        info = os.lstat(os.path.join(folder, name))
        if not os.path.islink(os.path.join(folder, name)):
          blobs[(info.st_dev, info.st_ino)] = os.path.join(folder, name)
    linked, leaving = {}, []
    for rel in files(here):
      info = os.stat(os.path.join(here, rel))
      blob = blobs.get((info.st_dev, info.st_ino))
      if blob:
        linked[os.path.join(there, rel)] = blob
      leaving.append((info.st_size, info.st_nlink, blob))
    os.rename(here, here + ".moving")
    os.symlink(there, here)
    shutil.rmtree(here + ".moving")
    replaced = set()
    for copy, blob in linked.items():
      if os.path.isfile(blob) and not os.path.islink(blob) and os.stat(blob).st_nlink == 1:
        os.symlink(copy, blob + ".tmp")
        os.replace(blob + ".tmp", blob)
        replaced.add(blob)
    # What the internal disk got back: a file nothing else links, or a blob nothing else links now. A blob another model's
    # folder still links stays, and so does its space.
    for size, nlinks, blob in leaving:
      if (blob in replaced) if blob else nlinks == 1:
        freed += size
      else:
        kept += size
    moved = True
  print("moved " + str(total) + " " + str(freed) + " " + str(kept) if moved else "already")
else:
  total, moved = 0, False
  for fs in filesets:
    here, there = os.path.join(base, fs), os.path.join(store, rid, fs)
    if not os.path.islink(here):
      continue
    if not os.path.isdir(there):
      fail("The store has no copy of " + rid + " (" + there + ")")
    total += size_of(there)
    back = here + ".returning"
    tmps = []
    parked = {}
    for folder, _, names in os.walk(os.path.join(DATA, "blobs")):
      for name in names:
        blob = os.path.join(folder, name)
        if os.path.islink(blob):
          parked[os.readlink(blob)] = blob
    try:
      shutil.rmtree(back, ignore_errors=True)
      os.makedirs(back)
      for rel in files(there):
        source, dest = os.path.join(there, rel), os.path.join(back, rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        blob = parked.get(source)
        tmps.append((blob or dest) + ".tmp")
        shutil.copyfile(source, (blob or dest) + ".tmp")
        if digest(source) != digest((blob or dest) + ".tmp"):
          raise OSError("the copy of " + rel + " differs from the store's")
        os.replace((blob or dest) + ".tmp", blob or dest)
        if blob:
          os.link(blob, dest)
      os.sync()
    except OSError as error:
      shutil.rmtree(back, ignore_errors=True)
      for tmp in tmps:
        if os.path.exists(tmp):
          os.remove(tmp)
      fail("Couldn't copy " + rid + " back from the store: " + str(error))
    os.remove(here)
    os.rename(back, here)
    moved = True
  print("moved " + str(total) if moved else "already")
'''


def storage_run(host, args, *argv):
  return ssh_raw(host, shlex.join(["python3", "-I", "-", *argv]), stdin=STORAGE_SCRIPT, timeout=args.timeout, what="storage").stdout


def cmd_storage(args):
  host = target(args.host)
  if args.set or args.unset:
    storage_run(host, args, *(["set", args.set] if args.set else ["unset"]))
    return
  out = storage_run(host, args, "list")
  try:
    found = json.loads(out.strip().splitlines()[-1])
    found["store"], found["disks"], found["models"]
  except (ValueError, IndexError, KeyError, TypeError) as error:
    raise Error(f"{host} gave an answer startdgx can't read") from error
  print_storage(found, args.json)


def print_storage(found, as_json):
  if as_json:
    print(json.dumps(found))
    return
  store = found["store"]
  print("Model store: " + (f"{store['path']}" + ("" if store["present"] else " (not mounted)") if store else "none (models stay on the internal disk)"))
  for disk in found["disks"]:
    note = "" if disk["usable"] else f"  not usable: {disk['reason']}"
    print(f"  {disk['mount']}  {disk['bus'] or '?'} {disk['fstype']}  {size_text(disk['free'])} free of {size_text(disk['size'])}{note}")


def cmd_move(args):
  host = target(args.host)
  out = ssh_raw(host, shlex.join(["python3", "-I", "-", recipe(args.model), args.to, host]), stdin=MOVE_SCRIPT, timeout=args.timeout, what="move").stdout
  found = out.split()
  if not found or found[0] not in ("moved", "already"):
    raise Error(f"{host} gave an answer startdgx can't read")
  kept = int(found[3]) if len(found) > 3 else 0
  print_moved(args.model, args.to, int(found[1]) if found[0] == "moved" else None, int(found[2]) if len(found) > 2 else 0, kept)


def print_moved(model, to, moved_bytes, freed=0, kept=0):
  where = "the store" if to == "usb" else "the internal disk"
  if moved_bytes is None:
    print(f"{model}: already on {where}")
  elif kept:
    print(f"{model}: on {where} ({size_text(moved_bytes)}), freeing {size_text(freed)} on the internal disk; "
          f"{size_text(kept)} is shared with another model and stays there")
  else:
    print(f"{model}: on {where} ({size_text(moved_bytes)})")


# destination: where a model's files should end up (the internal disk, or the machine's model store), chosen before the first download. The
# engine downloads to the internal disk and has no say about the store, so this is only the person's choice, kept on this computer; the panel
# acts on it when a setup finishes (it moves the model, as the move command does). Nothing on any machine is read or changed here.
def destination_path():
  return os.path.join(demo_dir() if DEMO else os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "startdgx"),
                      "destinations.json")


def destination_load():
  try:
    with open(destination_path()) as handle:
      found = json.load(handle)
  except (OSError, ValueError):
    return {}
  return found if isinstance(found, dict) else {}


def cmd_destination(args):
  found = destination_load()
  mine = found.get(args.host) if isinstance(found.get(args.host), dict) else {}
  if args.to:
    rid = recipe(args.model)
    if args.to == "usb":
      mine[rid] = "usb"
    else:
      mine.pop(rid, None)
    found[args.host] = mine
    path = destination_path()
    try:
      os.makedirs(os.path.dirname(path), exist_ok=True)
      with open(path + ".tmp", "w") as handle:
        json.dump(found, handle, indent=2)
      os.replace(path + ".tmp", path)
    except OSError as error:
      raise Error(f"{path} can't be written: {error.strerror}") from error
  if args.model:
    print(json.dumps({"to": mine.get(recipe(args.model), "nvme")}) if args.json else mine.get(recipe(args.model), "nvme"))
  else:
    print(json.dumps({k: v for k, v in mine.items() if v == "usb"}) if args.json else "\n".join(f"{k}: {v}" for k, v in sorted(mine.items())))


def cmd_delete(args):
  if args.dry_run:
    rid, host = recipe(args.model), target(args.host)
    out = ssh_raw(host, f"python3 -I - {shlex.quote(rid)}", stdin=REMOVE_PROBE, timeout=args.timeout, what="probe").stdout
    try:
      found = json.loads(out.strip().splitlines()[-1])
      plan = {"recipe": rid, "setting_up": bool(found["setting_up"]), "bytes": int(found["bytes"])}
      set_up = bool(found["set_up"])
    except (ValueError, IndexError, KeyError, TypeError) as error:
      raise Error(f"{host} gave an answer startdgx can't read") from error
    if not (set_up or plan["setting_up"]):
      raise Error(f"{rid} isn't set up on {host}")
    print_remove_plan(plan, args.json)
    return
  host, rid = target(args.host), recipe(args.model)
  sys.stdout.write(ssh(host, "remove", rid, timeout=args.timeout).stdout)
  # The engine knows nothing of the model store: what it kept of this model there goes too.
  sys.stdout.write(storage_run(host, args, "forget", rid))


def print_remove_plan(plan, as_json):
  if as_json:
    print(json.dumps(plan))
  elif plan["setting_up"]:
    print(f"Cancelling the setup of {plan['recipe']} would delete the {size_text(plan['bytes'])} downloaded so far")
  else:
    print(f"Removing {plan['recipe']} would free {size_text(plan['bytes'])}")


def probe(host):
  """The host's state as a dict, from the read-only PROBE; a key given twice keeps its last value."""
  out = ssh_raw(host, "bash -s", stdin=PROBE, timeout=60, what="probe").stdout
  return checked_user(host, parse_probe(out))


def parse_probe(out):
  return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


def checked_user(host, state):
  """A probe's state, once its user and home are known to be safe to put in scripts and paths."""
  if not USER_RE.match(state.get("user", "")) or not HOME_RE.match(state.get("home", "")):
    raise Error(f"{host} reported an unexpected user or home directory")
  return state


def is_spark(state):
  return "GB10" in state.get("gpu", "") or "Spark" in state.get("dgx_name", "")


def tailnet_peers():
  """The online Linux peers in `tailscale status --json`, as sorted unique short names."""
  try:
    result = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=30, check=False)
  except (OSError, subprocess.TimeoutExpired) as error:
    raise Error(f"Can't run tailscale: {error}") from error
  if result.returncode != 0:
    raise Error((result.stderr.strip().splitlines() or ["tailscale status failed"])[-1])
  try:
    peers = json.loads(result.stdout).get("Peer") or {}
    names = {clean(str((p.get("DNSName") or "").split(".")[0] or p.get("HostName") or ""))
             for p in peers.values() if p.get("Online") and str(p.get("OS", "")).lower() == "linux"}
  except (ValueError, AttributeError) as error:
    raise Error("tailscale status gave unexpected JSON") from error
  return sorted(names - {""})


def discover_peer(name, user, timeout, added, deadline, limit):
  """One peer's record. Pure: it reads nothing shared and writes nothing, so peers can be probed in parallel. A probe
  never runs past discover's deadline (time.monotonic())."""
  host = f"{user}@{name}"
  record = {"name": name, "target": host, "reachable": False, "reason": None, "spark": None, "installed": None, "engine": None,
            "added": host in added}
  if not TARGET_RE.match(name) or name.startswith("-") or not TARGET_RE.match(host):
    record["reason"] = "not a valid ssh name"
    return record
  left = deadline - time.monotonic()
  if left < 1:
    record["reason"] = f"not asked: discover's time limit ({limit} s) ran out"
    return record
  try:
    result = ssh_raw(host, "bash -s", stdin=DISCOVER_PROBE, timeout=min(timeout, left), check=False, what="probe", opts=DISCOVER_SSH_OPTS)
  except Error as error:
    record["reason"] = str(error)
    return record
  if result.returncode != 0:
    record["reason"] = ssh_failure(host, result.stderr)
    return record
  state = parse_probe(result.stdout)
  record.update(reachable=True, spark=is_spark(state), installed=bool(state.get("startdgx")), engine=bool(state.get("engine")))
  return record


def ssh_failure(host, stderr):
  """Why a BatchMode ssh failed, in words that say what to do: its last line, unless it is one ssh says vaguely."""
  if "Permission denied" in stderr:
    return f"ssh needs a key: run ssh-copy-id {host}"
  if "Host key verification failed" in stderr and "host key is known" in stderr:
    return f"ssh hasn't seen {host}'s host key yet: Add machine's tailnet list saves it, or run ssh {host} once"
  if "Host key verification failed" in stderr:
    return f"its host key changed since this machine last saw it: check why before you trust it (ssh {host} says more)"
  return (stderr.strip().splitlines() or ["ssh failed"])[-1]


def discover_peers(user, timeout, limit):
  names, added = tailnet_peers(), set(load_hosts())
  deadline = time.monotonic() + limit
  with concurrent.futures.ThreadPoolExecutor(max_workers=DISCOVER_WORKERS) as pool:
    return list(pool.map(lambda name: discover_peer(name, user, timeout, added, deadline, limit), names))


def cmd_discover(args):
  user = args.user or ("demo" if DEMO else getpass.getuser())
  if not TARGET_RE.match(user) or user.startswith("-") or "@" in user:
    raise Error("Not a valid user name")
  records = demo_peers(user) if DEMO else discover_peers(user, args.timeout, args.limit)
  if args.json:
    print(json.dumps(records, indent=2))
    return
  for r in records:
    if not r["reachable"]:
      print(f"{r['name']}  {r['target']}  unreachable ({r['reason']})")
    else:
      flags = [("spark" if r["spark"] else "not a Spark"), ("installed" if r["installed"] else "not installed"),
               ("engine" if r["engine"] else "no engine"), ("added" if r["added"] else "not added")]
      print(f"{r['name']}  {r['target']}  {', '.join(flags)}")


def operator_step_needed(state):
  """Whether tailscale is on the host and its operator is anyone but the user: the engine runs tailscale serve as
  the user, which tailscale refuses unless they are the operator."""
  return "operator" in state and state["operator"] != state["user"]


def engine_entry(state):
  return f"{state['home']}/{ENGINE_DIR}/omarchy-local-ai"


def plan(state, args):
  """What an install would change, predicted from the probe with HOST_SETUP's own conditions."""
  steps = [f"copy the engine from {os.path.abspath(args.engine_path)}" if args.engine_path else f"clone {ENGINE_REPO} at {ENGINE_TAG}"]
  if state.get("memlock_limits") != "yes":
    steps.append(f"create {ROOT_FILES[0]} (unlimited locked memory)")
  if not state.get(f"file:{ROOT_FILES[1]}"):
    steps.append(f"create {ROOT_FILES[1]} (unlimited locked memory for user services)")
  missing = [tool for tool in PACKAGES if state.get(tool) != "yes"]
  if missing:
    steps.append(f"install {' '.join(missing)}")
  major = state.get("podman_major", "")
  if (not major.isdigit() or int(major) < 5) and state.get("var_cdi_gids") == "yes":
    steps.append(f"write the Podman 4 CDI compat: {', '.join(ROOT_FILES[2:])}")
  if state.get("linger") != "yes":
    steps.append(f"enable linger for {state['user']}")
  if state.get("link_target") != engine_entry(state):
    steps.append(f"link {AGENT_LINK} -> {engine_entry(state)}")
  if operator_step_needed(state):
    now = state["operator"]
    steps.append(f"set the tailscale operator to {state['user']}" + (f" (now {now})" if now not in ("", "?") else ""))
  steps += [f"copy the engine to ~/{ENGINE_DIR}", f"write {MANIFEST}", f"add {args.host} to startdgx"]
  return steps


@contextlib.contextmanager
def engine_source(args):
  """A checkout of the engine on this machine: --engine-path, or the pinned tag cloned into a temporary directory."""
  if args.engine_path:
    path = os.path.abspath(args.engine_path)
    if not os.path.isfile(os.path.join(path, "agent_local.py")):
      raise Error(f"{path} isn't an omarchy-local-ai checkout (no agent_local.py)")
    yield path
    return
  with tempfile.TemporaryDirectory(prefix="startdgx-engine-") as tmp:
    path = os.path.join(tmp, "engine")
    clone = subprocess.run(["git", "clone", "-q", "--depth", "1", "--branch", ENGINE_TAG, "--", ENGINE_REPO, path],
                           capture_output=True, text=True, check=False)
    if clone.returncode != 0:
      raise Error(f"Can't clone {ENGINE_REPO} at {ENGINE_TAG}: {clone.stderr.strip()[-400:]}")
    yield path


def engine_setup_script(src):
  """The engine's own root setup, HOST_SETUP (with its CDI compat) then MACHINE_SETUP_TAIL, read from its
  agent_local.py without running any of it."""
  path = os.path.join(src, "agent_local.py")
  try:
    with open(path) as f:
      tree = ast.parse(f.read(), path)
  except (OSError, SyntaxError) as error:
    raise Error(f"Can't read the engine's host setup in {path}: {error}") from error
  found = {target.id: node.value.value for node in tree.body if isinstance(node, ast.Assign)
           and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)
           for target in node.targets if isinstance(target, ast.Name)}
  missing = [name for name in ("HOST_SETUP", "CDI_COMPAT", "MACHINE_SETUP_TAIL") if name not in found]
  if missing:
    raise Error(f"The engine in {src} has no {', '.join(missing)}: is it older than machine add?")
  return found["HOST_SETUP"].replace("@CDI_COMPAT@", found["CDI_COMPAT"]) + found["MACHINE_SETUP_TAIL"]


def run_root(host, script, argv, doing):
  """Runs a script as root on the host in one sudo call, with argv as its $0 and arguments; sudo asks for the
  password on this terminal."""
  remote = shlex.join(["sudo", "bash", "-c", script, *argv])
  if run_on_tty(["ssh", "-t", *SSH_OPTS, "--", host, remote]) != 0:
    raise Error(f"{doing} {host} as root failed (see above)")


def sync_engine(host, src):
  ssh_raw(host, f"mkdir -p ~/{ENGINE_DIR}", what="mkdir")
  copy = subprocess.run(["rsync", "-a", "--delete", "--exclude=.git", "--exclude=__pycache__", "-e", shlex.join(["ssh", *SSH_OPTS]),
                         src + "/", f"{host}:{ENGINE_DIR}/"], capture_output=True, text=True, check=False)
  if copy.returncode != 0:
    raise Error(f"Copying the engine to {host} failed: {copy.stderr.strip()[-400:]}")


NAMED_KINDS = ("package", "linger", "operator")


def snapshot(state):
  """Everything the install may create or change, by (kind, path or name), as it is in this probe."""
  items = {}
  for path in ROOT_FILES:
    sha, _, owner = state.get(f"file:{path}", "").partition(" ")
    items[("file", path)] = {"exists": bool(sha), "sha256": sha or None, "engine_header": owner == "engine"}
  for tool in PACKAGES:
    items[("package", tool)] = {"installed": state.get(tool) == "yes"}
  items[("linger", state["user"])] = {"linger": state.get("linger", "")}
  items[("symlink", AGENT_LINK)] = {"type": state.get("link_kind", "none"), "target": state.get("link_target") or None}
  if state.get("link_kind") == "file":
    items[("symlink", AGENT_LINK)]["sha256"] = state.get("link_sha") or None
  if state.get("operator", "?") != "?":
    items[("operator", "tailscale")] = {"operator": state["operator"]}
  engine = state.get("engine", "")
  items[("engine", f"{state['home']}/{ENGINE_DIR}")] = {"exists": bool(engine), "agent_local_sha256": engine if len(engine) == 64 else None}
  return items


def item_key(item):
  return (item["kind"], item.get("path") or item.get("name"))


def with_backup(key, previous, home):
  """The pre-state, plus where BACKUP copied it when it was a file the root setup overwrites."""
  existed = previous.get("exists") or previous.get("type") == "file"
  if key in BACKUPS and existed:
    return {**previous, "backup": f"{home}/{BACKUP_DIR}/{BACKUPS[key]}"}
  if key[0] == "engine" and existed:
    return {**previous, "backup": f"{home}/{ENGINE_BACKUP}"}
  return previous


def existed(kind, snap):
  """Whether the item was there in this snapshot; a snapshot that doesn't say counts as there."""
  if kind == "package":
    return snap.get("installed") is not False
  if kind == "linger":
    return snap.get("linger") == "yes"
  if kind == "symlink":
    return snap.get("type") != "none"
  if kind == "operator":
    return bool(snap.get("operator"))
  return snap.get("exists") is not False


def build_manifest(old, before, now, engine):
  """The manifest after an install: each item keeps the earliest `previous` any install recorded, and differs
  from that now either because the install created it (it wasn't there) or because it changed what was there."""
  earliest = {item_key(item): item["previous"] for item in old.get("items", [])}
  start, current = snapshot(before), snapshot(now)
  items = []
  for (kind, ref), state in current.items():
    if (kind, ref) not in start and (kind, ref) not in earliest:
      continue
    previous = earliest.get((kind, ref)) or with_backup((kind, ref), start[(kind, ref)], before["home"])
    differs, was = {k: v for k, v in previous.items() if k != "backup"} != state, existed(kind, previous)
    items.append({"kind": kind, "name" if kind in NAMED_KINDS else "path": ref, "created_by_us": differs and not was,
                  "changed_by_us": differs and was, "previous": previous})
  items += [item for item in old.get("items", []) if item_key(item) not in current]
  stamp = datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds")
  return {"schema_version": 1, "engine": engine, "installed_at": old.get("installed_at") or stamp, "updated_at": stamp,
          "pre_state": old.get("pre_state") or before, "items": items}


def read_manifest(host):
  text = ssh_raw(host, f"cat {MANIFEST} 2>/dev/null || true", what="cat").stdout
  try:
    return json.loads(text) if text.strip() else {}
  except ValueError as error:
    raise Error(f"{host}:{MANIFEST} isn't valid JSON; move it aside to install again") from error


def write_manifest(host, manifest):
  tmp = MANIFEST + ".tmp"
  ssh_raw(host, f"mkdir -p {os.path.dirname(MANIFEST)} && cat > {tmp} && mv {tmp} {MANIFEST}",
          stdin=json.dumps(manifest, indent=2) + "\n", what="manifest")


def engine_record(args, state):
  local = os.path.abspath(args.engine_path) if args.engine_path else None
  return {"repo": None if local else ENGINE_REPO, "tag": None if local else ENGINE_TAG, "local_checkout": local,
          "path": f"{state['home']}/{ENGINE_DIR}"}


# Appended to the engine's root script (its $1 is the user): a failure is said, not fatal, since the models work without it.
SET_OPERATOR = '''
if command -v tailscale >/dev/null && ! tailscale set --operator="$1"; then
  echo "Couldn't set the tailscale operator; sharing a model will fail until: sudo tailscale set --operator=$1" >&2
fi
'''


def cmd_install(args):
  host = ssh_target(args.host)
  before = probe(host)
  if not is_spark(before):
    raise Error(f"{host} isn't a DGX Spark (no GB10 GPU and no DGX Spark in /etc/dgx-release)")
  old = read_manifest(host)
  # An engine there without a manifest isn't one startdgx installed; one with a manifest is ours, or backed up.
  replace = bool(before.get("engine")) and not old
  if replace and not args.replace_engine:
    raise Error(f"{host} already has an engine startdgx didn't install, in ~/{ENGINE_DIR}. Run install with --replace-engine "
                f"to back it up to ~/{ENGINE_BACKUP} and replace it (uninstall puts it back)")
  if args.dry_run:
    print(f"Would, on {host}:")
    for step in ([f"back up the engine ~/{ENGINE_DIR} to ~/{ENGINE_BACKUP}"] if replace else []) + plan(before, args):
      print(f"  {step}")
    return
  with engine_source(args) as src:
    script, engine = engine_setup_script(src), engine_record(args, before)
    if operator_step_needed(before):
      script += SET_OPERATOR
    # Recorded before anything changes, so an install that fails halfway still knows what was there.
    ssh_raw(host, "bash -s -- startdgx-backup", stdin=BACKUP + (BACKUP_ENGINE if replace else ""), what="backup")
    write_manifest(host, build_manifest(old, before, before, engine))
    try:
      print(f"Preparing {host} (sudo there asks for your password)")
      run_root(host, script, ["startdgx-install", before["user"], engine_entry(before)], "Preparing")
      print(f"Copying the engine to {host}")
      sync_engine(host, src)
    except BaseException:
      # What a failed root script or copy changed is recorded too, so an uninstall can still undo it.
      try:
        write_manifest(host, build_manifest(old, before, probe(host), engine))
      except Error as error:
        print(f"Warning: can't record what the failed install changed ({error}); "
              f"{host}:{MANIFEST} has only what was there before", file=sys.stderr)
      raise
    write_manifest(host, build_manifest(old, before, probe(host), engine))
  print(f"Install recorded in {host}:{MANIFEST}")
  cmd_add(args)


def uninstall_probe(host):
  """What the engine set up for the user since the install, from the read-only UNINSTALL_PROBE: single values
  by key, and the repeated ones (quadlet, image, exists) as lists."""
  out = ssh_raw(host, "bash -s -- startdgx-uninstall-probe", stdin=UNINSTALL_PROBE, timeout=60, what="probe").stdout
  state = {"quadlet": [], "image": [], "exists": []}
  for key, _, value in (line.partition("=") for line in out.splitlines() if "=" in line):
    if key in ("quadlet", "image", "exists"):
      state[key].append(value)
    else:
      state[key] = value
  return checked_user(host, state)


def decoded_json(text):
  try:
    return json.loads(base64.b64decode(text, validate=True))
  except ValueError:
    return None


def shared_recipes(state):
  shares = decoded_json(state.get("shares", ""))
  recipes = shares.get("recipes") if isinstance(shares, dict) else None
  return sorted({rid for rid in recipes if isinstance(rid, str) and RID_RE.match(rid)}) if isinstance(recipes, list) else []


def serve_paths(state):
  """Our routes in the tailscale serve config: /local-ai and what is under it, on any name."""
  config = decoded_json(state.get("serve", ""))
  webs = config.get("Web") if isinstance(config, dict) else None
  paths = set()
  for web in webs.values() if isinstance(webs, dict) else ():
    handlers = web.get("Handlers") if isinstance(web, dict) else None
    paths |= {path for path in handlers or () if isinstance(path, str) and SERVE_PATH_RE.match(path)}
  return sorted(paths)


def size_text(n):
  for unit, size in (("GiB", 2**30), ("MiB", 2**20), ("KiB", 2**10)):
    if n >= size:
      return f"{n / size:.1f} {unit}"
  return f"{n} B"


def engine_is_ours(manifest, state):
  """Whether the install created the engine; what an engine that was there before set up isn't startdgx's."""
  return ("engine", f"{state['home']}/{ENGINE_DIR}") in ours(manifest, "created_by_us")


def ours_recipes(manifest, state):
  """How many recipes of the user's the engine startdgx installed holds; 0 where the engine isn't startdgx's (what it
  holds isn't ours to keep or delete), so the plan's steps, its kept lines and its count agree."""
  count = state.get("recipes", "")
  return int(count) if count.isdigit() and engine_is_ours(manifest, state) else 0


def uninstall_state_text(keeping, recipes=0):
  """The uninstall step for the engine's state dir, which holds the user's recipes."""
  if keeping:
    return f"delete ~/{ENGINE_STATE} except your recipes (the engine's state)"
  return f"delete ~/{ENGINE_STATE} (the engine's state{', with your recipes' if recipes else ''})"


def uninstall_recipes_kept():
  return f"keep your recipes in ~/{ENGINE_RECIPES} (--delete-recipes deletes them)"


def user_plan(manifest, state, args):
  """The steps under the user's home, in order, and what is kept: each step is (what it does, its shell).
  Units stop first; the engine goes last, since the units' hooks call it."""
  q, exists = shlex.quote, set(state["exists"])
  steps, kept = [], []
  if not engine_is_ours(manifest, state):
    return replaced_engine_plan(manifest, state, args)
  if ENGINE_DIR in exists:
    for rid in shared_recipes(state):
      steps.append((f"stop sharing {rid} (omarchy-local-ai share {rid} --off)",
                    f'"$HOME"/{ENGINE_DIR}/omarchy-local-ai share {rid} --off || echo "  share {rid} --off failed; its route goes below" >&2'))
  steps.append(("stop the engine's units (omarchy-agent-local-*.service)", "systemctl --user stop 'omarchy-agent-local-*.service'"))
  for path in serve_paths(state):
    steps.append((f"remove the tailscale serve route {path}", f"serve_off {q(path)}"))
  if state.get("serve") == "error":
    kept.append("tailscale serve status failed: remove any /local-ai routes yourself (tailscale serve status)")
  quadlets = [name for name in dict.fromkeys(state["quadlet"]) if QUADLET_RE.match(name)]
  images = [image for image in dict.fromkeys(state["image"]) if IMAGE_RE.match(image)]
  if images and quadlets:
    # The quadlets name the images; a rerun after a failure past this point finds them here.
    steps.append((None, f"mkdir -p ~/{STARTDGX_DIR} && printf '%s\\n' {' '.join(map(q, images))} >~/{UNINSTALL_IMAGES}"))
  for name in quadlets:
    steps.append((f"remove ~/{QUADLET_DIR}/{name}", f"rm -f ~/{QUADLET_DIR}/{name}"))
  if SHARE_UNIT in exists:
    steps.append((f"remove ~/{SHARE_UNIT}", f"rm -f ~/{SHARE_UNIT}"))
  if quadlets or SHARE_UNIT in exists:
    steps.append(("reload the user's systemd", "systemctl --user daemon-reload; systemctl --user reset-failed 'omarchy-agent-local-*' || true"))
  if state.get("network") == "yes":
    steps.append((f"remove the podman network {NETWORK}", f"podman network rm {NETWORK} >/dev/null"))
  if state.get("secret") == "yes":
    steps.append((f"remove the podman secret {SECRET}", f"podman secret rm {SECRET} >/dev/null"))
  for image in images if state.get("podman") == "yes" else ():
    steps.append((f"remove the image {image} unless a container uses it",
                  f'if podman image exists {q(image)}; then if [ -n "$(podman ps -a -q --filter ancestor={q(image)})" ]; then '
                  f'echo "  kept {image}: a container uses it"; else podman image rm {q(image)} >/dev/null; fi; fi'))
  recipes = ours_recipes(manifest, state)
  for path, what in ((ENGINE_STATE, "state"), (ENGINE_CONFIG, "key, overlays and shares")):
    if path not in exists:
      continue
    if path == ENGINE_STATE and recipes and not args.delete_recipes:
      steps.append((uninstall_state_text(True), f"find ~/{path} -mindepth 1 -maxdepth 1 ! -name recipes ! -name recipes-confirmed.json -exec rm -rf {{}} +"))
      kept.append(uninstall_recipes_kept())
    else:
      steps.append((uninstall_state_text(False, recipes), f"rm -rf ~/{path}") if path == ENGINE_STATE
                   else (f"delete ~/{path} (the engine's {what})", f"rm -rf ~/{path}"))
  if ENGINE_DATA in exists:
    size = state.get("models_bytes", "")
    weights = f"~/{ENGINE_DATA} ({size_text(int(size)) if size.isdigit() else 'unknown size'} of model weights"
    if args.delete_models:
      steps.append((f"delete {weights})", f"rm -rf ~/{ENGINE_DATA}"))
    else:
      kept.append(f"keep {weights}; --delete-models deletes them)")
  if ENGINE_DIR in exists:
    steps.append((f"delete the engine ~/{ENGINE_DIR}", f"rm -rf ~/{ENGINE_DIR}"))
  parents = " ".join(f"~/{path}" for path in SHARED_PARENTS)
  steps.append((f"remove {parents} where empty",
                f'for dir in {parents}; do if [ -d "$dir" ]; then rmdir --ignore-fail-on-non-empty "$dir"; fi; done'))
  return steps, kept


def fugue_helper_steps(state):
  """The step that removes the Fugue helper startdgx installed (its record is there): the host script's remove, which deletes
  only the files its record says startdgx created."""
  if state.get("fugue_helper") != "1":
    return []
  heredoc = "STARTDGX_FUGUE_HELPER_SCRIPT"
  return [(FUGUE_HELPER_REMOVE_TEXT, f"python3 -I - fugue-helper remove <<'{heredoc}'\n{fugue_helper_script({'lenient': True})}{heredoc}")]


def replaced_engine_plan(manifest, state, args):
  """The user's steps where the engine was there before the install: what it set up isn't startdgx's to remove,
  so the only step puts back the engine --replace-engine replaced."""
  engine, backup = f"{state['home']}/{ENGINE_DIR}", f"{state['home']}/{ENGINE_BACKUP}"
  steps, kept = [], [f"left what the engine set up under ~ (its units, quadlets, network, secret, images, state, config, key, "
                     f"shares and models): the engine in ~/{ENGINE_DIR} was there before the install, so they aren't startdgx's to remove"]
  item = ours(manifest, "changed_by_us").get(("engine", engine))
  if item:
    put_back = f"rm -rf {engine} && cp -a {backup} {engine}"
    sha = str(previous_of(item).get("agent_local_sha256"))
    if SHA_RE.match(sha):
      steps.append((f"put back the engine that was there before, from {backup}", restore(f"{engine}/agent_local.py", f"{backup}/agent_local.py", sha, put_back)))
    else:
      steps.append((f"put back the engine that was there before, from {backup}",
                    f'if [ -d {backup} ]; then {put_back}; else echo "  left {engine}: its backup {backup} is missing" >&2; failed=1; fi'))
  if args.delete_models:
    kept.append("--delete-models deletes nothing here: the models are the engine's, which was there before")
  return steps, kept


def previous_of(item):
  previous = item.get("previous")
  return previous if isinstance(previous, dict) else {}


def ours(manifest, flag):
  """The manifest's items it marks with flag, by key: created_by_us for what wasn't there before the install,
  changed_by_us for what was. The manifest is the user's to edit, so an item whose `previous` disagrees is left out."""
  return {item_key(item): item for item in manifest["items"] if isinstance(item, dict) and "kind" in item and item.get(flag) is True
          and existed(item["kind"], previous_of(item)) == (flag == "changed_by_us")}


def sha_of(path):
  return f'"$(sha256sum 2>/dev/null <{shlex.quote(path)} | cut -c1-64)"'


def restore(path, backup, sha, put_back):
  """Shell that runs put_back when backup is still the file that was at path before the install; one already put
  back counts as done, and a backup that is missing or changed fails the script once the other steps have run, so
  the backups and the manifest stay."""
  return (f"if [ {sha_of(path)} = {sha} ] && [ ! -L {path} ]; then :; elif [ {sha_of(backup)} = {sha} ]; then {put_back}; "
          f'else echo "  left {path}: its backup {backup} is missing or changed" >&2; failed=1; fi')


def removable_packages(manifest):
  """The packages the install added that --remove-packages may remove: never python3, which the system needs."""
  created = ours(manifest, "created_by_us")
  return [name for name in PACKAGES if ("package", name) in created and name != "python3"]


APT_REMOVES = re.compile(r"^Remv ([^ :]+)")


def check_apt_removal(host, packages):
  """Refuses, before anything changes, a removal that would take more than the named packages with them."""
  names = " ".join(packages)
  out = ssh_raw(host, "bash -s -- startdgx-apt-check", stdin=f"LC_ALL=C apt-get -s remove {names}\n", timeout=60, what="apt-get -s remove").stdout
  extra = sorted({match[1] for match in map(APT_REMOVES.match, out.splitlines()) if match} - set(packages))
  if extra:
    raise Error(f"Removing {names} would also remove {' '.join(extra)}; run uninstall without --remove-packages, or remove them yourself")


def root_plan(manifest, state, args):
  """The root steps, which undo only what the manifest marks created_by_us or changed_by_us, and what is kept.
  Only paths and names of our own are acted on, each checked again on the host: the manifest is the user's to edit."""
  q, home, user = shlex.quote, state["home"], state["user"]
  created, changed = ours(manifest, "created_by_us"), ours(manifest, "changed_by_us")
  steps, kept = [], []
  limits, user_conf, compat, dropin, cdi = ROOT_FILES
  # How each file the engine writes is known to be its own, so that a created one is removed only while it still is.
  own = {limits: f"head -1 {limits} | grep -qF {q(RDMA_HEADER)}", user_conf: f"head -1 {user_conf} | grep -qF {q(RDMA_HEADER)}",
         compat: f"head -2 {compat} | grep -qF {q(COMPAT_HEADER)}", dropin: f"grep -qx {q('ExecStartPost=' + compat)} {dropin}", cdi: "true"}
  for path in ROOT_FILES:
    if ("file", path) in created:
      steps.append((f"remove {path}", f'if [ ! -e {path} ]; then :; elif {own[path]}; then rm -f {path}; '
                                     f'else echo "  left {path}: it is no longer the one the install wrote"; fi'))
      if path == dropin:
        steps.append((None, f"if [ -d {os.path.dirname(dropin)} ]; then rmdir --ignore-fail-on-non-empty {os.path.dirname(dropin)}; fi"))
      if path == user_conf:
        # A running manager keeps the default until it re-reads its config, as the engine's setup made it do.
        steps.append((f"re-execute {user}'s systemd to drop it", f"if pgrep -u {q(user)} -x systemd >/dev/null; then "
                                                                 f"systemctl --user -M {q(user + '@')} daemon-reexec || "
                                                                 f'echo "  couldn\'t: it drops it when it next starts" >&2; fi'))
    elif ("file", path) in changed:
      sha, backup = str(previous_of(changed[("file", path)]).get("sha256")), f"{home}/{BACKUP_DIR}/{BACKUPS[('file', path)]}"
      if SHA_RE.match(sha):
        steps.append((f"restore {path} from {backup}", restore(path, backup, sha, f"mkdir -p {os.path.dirname(path)} && cp {q(backup)} {path}")))
      else:
        kept.append(f"keep {path}: the manifest has no checksum for the one before")
  if {("file", compat), ("file", dropin)} & (created.keys() | changed.keys()):
    steps.append(("reload systemd", "systemctl daemon-reload"))
  if ("linger", user) in created:
    steps.append((f"disable linger for {user}", f"loginctl disable-linger {q(user)}"))
  for link in (AGENT_LINK, LEGACY_AGENT_LINK):
    at_engine = f'[ "$(readlink {link})" = {q(engine_entry(state))} ]'
    left = f'echo "  left {link}: it no longer points at the engine"'
    if ("symlink", link) in created:
      steps.append((f"remove {link}", f"if {at_engine}; then rm -f {link}; elif [ -L {link} ] || [ -e {link} ]; then {left}; fi"))
    elif ("symlink", link) in changed:
      previous, backup = previous_of(changed[("symlink", link)]), f"{home}/{BACKUP_DIR}/{BACKUPS[('symlink', link)]}"
      target, sha = str(previous.get("target")), str(previous.get("sha256"))
      # What was there goes with the manifest and backups, so a link that can't go back fails the script to keep them.
      stuck = f'{left[:-1]}; put back what was there, then run uninstall again" >&2; failed=1'
      if previous.get("type") == "symlink" and HOME_RE.match(target):
        steps.append((f"point {link} back at {target}", f'if [ "$(readlink {link})" = {q(target)} ]; then :; '
                                                              f"elif {at_engine}; then ln -sfn {q(target)} {link}; else {stuck}; fi"))
      elif previous.get("type") == "file" and SHA_RE.match(sha):
        put_back = f"if {at_engine}; then rm -f {link} && cp {q(backup)} {link}; else {stuck}; fi"
        steps.append((f"restore {link} from {backup}", restore(link, backup, sha, put_back)))
      else:
        kept.append(f"keep {link}: the manifest doesn't say what was there before")
  steps += operator_steps(created, changed, user, kept)
  if ("package", "python3") in created:
    kept.append("keep python3: the system needs it, so it's never removed")
  packages = removable_packages(manifest)
  if packages and args.remove_packages:
    names, others = " ".join(packages), " ".join(f"-e {name}" for name in packages)
    steps.append((f"remove the packages {names}",
                  f'extra=$(LC_ALL=C apt-get -s remove {names} | sed -n "s/^Remv \\([^ :]*\\).*/\\1/p" | grep -vx {others} || true); '
                  f'if [ -n "$extra" ]; then echo "  kept {names}: apt would also remove" $extra >&2; failed=1; '
                  f"else DEBIAN_FRONTEND=noninteractive apt-get remove -y -qq {names}; fi"))
  elif packages:
    kept.append(f"keep the packages {' '.join(packages)} (the install added them; --remove-packages removes them)")
  return steps, kept


def operator_steps(created, changed, user, kept):
  """Puts the tailscale operator back to what it was, while it is still the user the install made it."""
  q, key = shlex.quote, ("operator", "tailscale")
  if key not in created and key not in changed:
    return []
  previous = "" if key in created else str(previous_of(changed[key]).get("operator"))
  if previous and not USER_RE.match(previous):
    kept.append("keep the tailscale operator: the manifest doesn't name a valid one before")
    return []
  now = "$(tailscale debug prefs | sed -n 's/.*\"OperatorUser\": *\"\\([^\"]*\\)\".*/\\1/p' | head -1)"
  what = f"set the tailscale operator back to {previous}" if previous else "clear the tailscale operator"
  return [(what, f'if ! command -v tailscale >/dev/null; then :; elif [ "{now}" = {q(user)} ]; then tailscale set --operator={previous}; '
                 f'else echo "  left the tailscale operator: it is no longer {user}"; fi')]


def step_script(steps, preamble=""):
  """A bash script that says each step, then runs it, and stops at the first that fails; a step that sets failed
  lets the others run, then fails the script."""
  lines = ["set -eu", "failed=0", preamble]
  for what, shell in steps:
    lines += ([f"echo {shlex.quote('  ' + what)}"] if what else []) + [shell]
  return "\n".join(lines + ['exit "$failed"']) + "\n"


SERVE_OFF = '''serve_off() {
  if ! out=$(tailscale serve --yes --set-path "$1" off 2>&1); then
    case ${out,,} in *"not found"*) ;; *) echo "$out" >&2; return 1;; esac
  fi
}'''
FINISH = f"rm -rf ~/{BACKUP_DIR} && rm -f {MANIFEST} ~/{UNINSTALL_IMAGES} && rmdir --ignore-fail-on-non-empty ~/{STARTDGX_DIR}\n"


def cmd_uninstall(args):
  host = ssh_target(args.host)
  manifest = read_manifest(host)
  if not manifest:
    raise Error(f"No install manifest on {host} ({MANIFEST}): startdgx install didn't set it up, or it's already uninstalled")
  if not isinstance(manifest, dict) or not isinstance(manifest.get("items"), list):
    raise Error(f"{host}:{MANIFEST} isn't an install manifest")
  state = uninstall_probe(host)
  pre = manifest.get("pre_state") or {}
  if (pre.get("user"), pre.get("home")) != (state["user"], state["home"]):
    raise Error(f"The manifest on {host} is for {pre.get('user')} ({pre.get('home')}), not {state['user']} ({state['home']})")
  user_steps, user_kept = user_plan(manifest, state, args)
  root_steps, root_kept = root_plan(manifest, state, args)
  user_steps = fugue_helper_steps(state) + user_steps
  managed = state.get("comfyui", "0")
  if managed.isdigit() and int(managed):
    user_kept.append(f"keep the {managed} ComfyUI install(s) startdgx manages, with their folders and ~/{COMFYUI_RECORDS}; startdgx comfyui forget drops one")
  if args.remove_packages and removable_packages(manifest):
    check_apt_removal(host, removable_packages(manifest))
  final = [f"delete {MANIFEST} and the backups", f"forget {host} here"]
  if args.dry_run and args.json:
    weights = state.get("models_bytes", "")
    print(json.dumps({
      "host": host,
      "steps": [what for what, _ in user_steps if what] + [f"as root: {what}" for what, _ in root_steps] + final,
      "kept": user_kept + root_kept,
      "manual": manual_steps(host),
      # What --delete-models would delete (None: nothing, or weights that are another engine's), and the packages
      # --remove-packages would remove.
      "models_bytes": int(weights) if ENGINE_DATA in state["exists"] and weights.isdigit() and engine_is_ours(manifest, state) else None,
      "packages": removable_packages(manifest),
      "recipes": ours_recipes(manifest, state),
    }))
    return
  if args.dry_run:
    print(f"Would, on {host}:")
    for what in [what for what, _ in user_steps if what] + [f"as root: {what}" for what, _ in root_steps] + final:
      print(f"  {what}")
    for what in user_kept + root_kept:
      print(f"  {what}")
    print_manual_steps(host)
    return
  # The manifest and backups go only once everything else has, so a rerun after a failure finds them.
  if engine_is_ours(manifest, state):
    print(f"Removing what the engine set up on {host}")
  elif user_steps:
    print(f"Putting back the engine that was on {host} before the install")
  run_steps(host, "user", step_script(user_steps, SERVE_OFF), args.timeout)
  if root_steps:
    print(f"Restoring {host} as root (sudo there asks for your password)")
    run_root(host, step_script(root_steps), ["startdgx-uninstall"], "Restoring")
  run_steps(host, "finish", FINISH, args.timeout)
  for what in user_kept + root_kept:
    print(f"  {what}")
  if ENGINE_DATA in state["exists"] and not args.delete_models and engine_is_ours(manifest, state):
    print(f"  to delete the weights later: ssh {host} rm -rf ~/{ENGINE_DATA}")
  print(f"Uninstalled from {host}")
  print_manual_steps(host)
  if host in load_hosts():
    cmd_remove_host(args)


def manual_steps(host):
  """What uninstall can't do from here: the paired clients and the host's SSH access are someone else's."""
  return [f"on each Omarchy machine paired with {host}, run: omarchy models forget <its tailnet name>",
          f"{host}:~/.ssh/authorized_keys still has the keys of the machines that reach it over SSH (this one, and any "
          "Omarchy machine that paired with it); remove their lines yourself if they shouldn't any more"]


def print_manual_steps(host):
  print("Left for you to do:")
  for step in manual_steps(host):
    print(f"  {step}")


def run_steps(host, phase, script, timeout):
  result = ssh_raw(host, f"bash -s -- startdgx-uninstall-{phase}", stdin=script, timeout=timeout, check=False)
  sys.stdout.write(result.stdout)
  sys.stderr.write(result.stderr)
  if result.returncode != 0:
    raise Error(f"Uninstall stopped on {host} (see above); run it again once that's fixed")


LAUNCHER = "omarchy-launch-floating-terminal-with-presentation"
# The commands launch may open a terminal on, and whether each takes a model.
LAUNCH_VERBS = {"install": False, "uninstall": False, "logs": True, "author": True, "fix": True}


def cmd_launch(args):
  """Opens a floating terminal on one of the commands that need one (sudo asks for a password in install and uninstall; author
  runs an agent). The launcher runs its argument as shell, so it is built only from checked words, each quoted."""
  if args.verb not in LAUNCH_VERBS:
    raise Error(f"launch: '{args.verb}' isn't one of {', '.join(LAUNCH_VERBS)}")
  if args.model and not LAUNCH_VERBS[args.verb]:
    raise Error(f"launch {args.verb} takes no model")
  if args.replace_engine and args.verb != "install":
    raise Error("--replace-engine goes only with launch install")
  if (args.delete_models or args.remove_packages or args.delete_recipes) and args.verb != "uninstall":
    raise Error("--delete-models, --remove-packages and --delete-recipes go only with launch uninstall")
  if args.verb == "author":
    # The model slot holds the Hugging Face repo; the terminal runs recipe author, so the draft's errors and the agent show there.
    if not valid_repo(args.model):
      raise Error("launch author takes a repo as OWNER/NAME")
    argv = [os.path.realpath(__file__), "recipe", "author", ssh_target(args.host), "--agent", "--here", "--", args.model]
    return open_terminal(argv)
  if args.verb == "fix":
    # The model slot holds the recipe's id; the terminal runs recipe fix, so what it finds and the agent show there.
    argv = [os.path.realpath(__file__), "recipe", "fix", ssh_target(args.host), "--here", "--", recipe(args.model)]
    return open_terminal(argv)
  argv = [os.path.realpath(__file__), args.verb, ssh_target(args.host)]
  argv += [recipe(args.model)] if args.model else []
  argv += ["--replace-engine"] if args.replace_engine else []
  argv += ["--delete-models"] if args.delete_models else []
  argv += ["--remove-packages"] if args.remove_packages else []
  argv += ["--delete-recipes"] if args.delete_recipes else []
  open_terminal(argv)


def open_terminal(argv):
  if DEMO:
    print(f"Demo: would run '{shlex.join(argv[1:])}' in a terminal")
    return
  try:
    os.execvp(LAUNCHER, [LAUNCHER, shlex.join(argv)])
  except OSError as error:
    raise Error(f"Can't open a terminal with {LAUNCHER}: {error.strerror}") from error


def cmd_engine(args):
  if args.json:
    print(json.dumps({"repo": ENGINE_REPO, "tag": ENGINE_TAG, "comfyui_repo": COMFYUI_REPO, "comfyui_tag": COMFYUI_TAG}))
  else:
    print(f"{ENGINE_REPO} {ENGINE_TAG}")


# self-update: the plugin updates itself, on this computer (no host, no ssh). It is `omarchy plugin update` for this one plugin,
# which the panel can ask for: fetch the repo's HEAD, fast-forward the folder to it, validate it (rolling back if it fails), and
# with --restart restart the Omarchy shell a moment later, which is what loads the new files (the shell keeps running the old
# ones until then). A folder that is not a git checkout (a copy made by scripts/reload) or that has edits is refused, with why.
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SELF_UPDATE_CHANGES = 8


def self_git(*argv, check=False):
  env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_SSH_COMMAND=os.environ.get("GIT_SSH_COMMAND", "ssh -oBatchMode=yes"))
  try:
    run = subprocess.run(["git", "-C", PLUGIN_DIR, *argv], capture_output=True, text=True, timeout=60, env=env)
  except (OSError, subprocess.SubprocessError) as error:
    raise Error(f"git didn't run: {error}") from error
  if check and run.returncode != 0:
    raise Error(f"git {argv[0]} failed: {(run.stderr.strip() or run.stdout.strip())[-300:]}")
  return run


def self_state(fetch=True):
  """The plugin folder against its repo's HEAD: { managed, why, commit, subject, behind, changes, dirty }."""
  if DEMO:
    return {"managed": True, "why": "", "commit": "d2efd47", "subject": "Picker: a model is listed once", "behind": 2, "dirty": False,
            "changes": ["Set up shares the model on the tailnet", "A model is listed once in the picker"]}
  inside = self_git("rev-parse", "--is-inside-work-tree")
  top = self_git("rev-parse", "--show-toplevel").stdout.strip()
  if inside.returncode != 0 or os.path.realpath(top) != PLUGIN_DIR:
    return {"managed": False, "why": "This copy of the plugin was not installed with `omarchy plugin add`, so it can't update itself. Add it again, or update the checkout it was copied from.",
            "commit": "", "subject": "", "behind": 0, "changes": [], "dirty": False}
  head = self_git("log", "-1", "--format=%h%n%s").stdout.splitlines()
  state = {"managed": True, "why": "", "commit": head[0] if head else "", "subject": head[1] if len(head) > 1 else "", "behind": 0, "changes": [],
           "dirty": bool(self_git("status", "--porcelain").stdout.strip())}
  if fetch:
    fetched = self_git("fetch", "--quiet", "origin", "HEAD")
    if fetched.returncode != 0:
      raise Error(f"Can't reach the plugin's repository: {(fetched.stderr.strip() or 'fetch failed')[-200:]}")
    state["behind"] = int(self_git("rev-list", "--count", "HEAD..FETCH_HEAD", check=True).stdout.strip() or 0)
    state["changes"] = self_git("log", f"--max-count={SELF_UPDATE_CHANGES}", "--format=%s", "HEAD..FETCH_HEAD").stdout.splitlines()
  return state


def cmd_self_update(args):
  state = self_state()
  result = dict(state, ok=True, updated=False, restarting=False)
  if not args.check and state["managed"] and state["behind"] > 0:
    if state["dirty"]:
      raise Error(f"The plugin's folder has local changes ({PLUGIN_DIR}), so it was not updated. Stash or discard them, then try again.")
    if DEMO:
      result.update(updated=True, behind=0)
    else:
      before = self_git("rev-parse", "HEAD", check=True).stdout.strip()
      if self_git("merge", "--ff-only", "FETCH_HEAD").returncode != 0:
        raise Error("The plugin can't be fast-forwarded: its history has diverged from the repository's. Nothing was changed.")
      validate = shutil.which("omarchy-plugin-validate")
      if validate and subprocess.run([validate, PLUGIN_DIR], capture_output=True).returncode != 0:
        self_git("reset", "--hard", before)
        raise Error("The new version failed Omarchy's plugin validation, so it was rolled back.")
      after = self_state(fetch=False)
      result.update(updated=True, commit=after["commit"], subject=after["subject"], behind=0)
    if args.restart and not DEMO:
      # The shell loads a plugin once, when it starts: restart it a moment after this answer is out, detached so it outlives this process.
      subprocess.Popen(["sh", "-c", "sleep 2; exec omarchy-restart-shell"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
      result["restarting"] = True
  if args.json:
    print(json.dumps(result))
  elif not state["managed"]:
    print(state["why"])
  elif result["updated"]:
    print(f"Updated to {result['commit']}." + (" Restarting the shell." if result["restarting"] else " Restart the shell to load it: omarchy-restart-shell"))
  elif state["behind"] > 0:
    print(f"{state['behind']} newer change(s) at {state['commit']}: " + "; ".join(state["changes"]))
  else:
    print(f"Up to date at {state['commit']}.")


# hf search: the anonymous Hugging Face API, read-only, on this computer (no host, no ssh). The base address is
# STARTDGX_HF_BASE: a URL, or a folder of fixtures (api/models.json, api/models/OWNER/NAME/tree/main.json and
# OWNER/NAME/raw/main/config.json) for tests; demo mode always uses the folder in demo/hf and never the network.
HF_DEFAULT_BASE = "https://huggingface.co"
HF_LIMIT = 50
HF_WORKERS = 8
HF_TIMEOUT = 20
HF_CACHE_SECONDS = 3600
KNOWN_FAMILIES = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "known-families.json")
HF_LABEL_RE = re.compile(r"abliterated|uncensored", re.I)


def hf_get(base, path, query=None, strict=True):
  """A JSON document from the Hugging Face API, or None when the repo has no such file. Errors: rate limited, offline,
  and (when strict) any other HTTP error; a per-repo fetch is not strict, so one broken repo is skipped."""
  if not hf_is_network(base):
    local = os.path.join(base.removeprefix("file://"), *path.split("/"))
    try:
      with open(local if local.endswith(".json") else local + ".json") as f:
        return json.load(f)
    except (OSError, ValueError):
      return None
  url = f"{base.rstrip('/')}/{path}" + (f"?{query}" if query else "")
  request = urllib.request.Request(url, headers={"User-Agent": "startdgx", "Accept": "application/json"})
  try:
    with urllib.request.urlopen(request, timeout=HF_TIMEOUT) as response:
      return json.load(response)
  except urllib.error.HTTPError as error:
    if error.code == 429:
      try:
        wait = max(1, -(-int(error.headers.get("Retry-After") or 60) // 60))
      except ValueError:
        wait = 1
      raise Error(f"Hugging Face is limiting requests, try again in {wait} minute{'s' if wait != 1 else ''}") from error
    if error.code in (401, 403, 404) or not strict:
      return None
    raise Error(f"Hugging Face answered {error.code}") from error
  except ValueError:
    return None
  except (urllib.error.URLError, OSError) as error:
    raise Error("Can't reach Hugging Face: check the network") from error


def hf_base():
  """Where the Hugging Face API is read from: the bundled fixtures in demo mode, else STARTDGX_HF_BASE, else Hugging Face."""
  return os.path.join(DEMO_FIXTURES, "hf") if DEMO else os.environ.get("STARTDGX_HF_BASE") or HF_DEFAULT_BASE


def hf_is_network(base):
  return bool(re.match(r"^https?://", base))


def valid_repo(repo):
  """Whether `repo` is a Hugging Face OWNER/NAME that is safe in a URL and a path (no part of only dots)."""
  return isinstance(repo, str) and bool(DRAFT_REPO_RE.fullmatch(repo)) and not any(set(part) == {"."} for part in repo.split("/"))


def hf_known_families():
  with open(KNOWN_FAMILIES) as f:
    return set(json.load(f)["families"])


def hf_is_affine_4bit(config):
  quantization = config.get("quantization") if isinstance(config, dict) else None
  return isinstance(quantization, dict) and quantization.get("mode") == "affine" and quantization.get("bits") == 4


def hf_passes_find(config, known):
  """Whether a repo's config.json is what Find lists: MLX affine 4-bit of an architecture in `known`."""
  archs = config.get("architectures") if isinstance(config, dict) else None
  return hf_is_affine_4bit(config) and isinstance(archs, list) and bool(known.intersection(a for a in archs if isinstance(a, str)))


def hf_weights_bytes(tree):
  """The size of a repo's .safetensors files, from its file tree; 0 when it lists none."""
  return sum(e["size"] for e in (tree if isinstance(tree, list) else []) if isinstance(e, dict) and str(e.get("path", "")).endswith(".safetensors") and isinstance(e.get("size"), int))


def hf_base_model(card):
  """The card's base model (the first of a list), or None."""
  base_model = card.get("base_model")
  return (base_model[0] if base_model else None) if isinstance(base_model, list) else base_model


def hf_row(base, item):
  """A listing item whose config passed, as its row; the weights' size is the repo's .safetensors files."""
  repo = item["id"]
  card = item.get("cardData") or {}
  tree = hf_get(base, f"api/models/{repo}/tree/main", strict=False)
  label = HF_LABEL_RE.search(" ".join([repo, *(item.get("tags") or [])]))
  return {"repo": repo, "params": (item.get("safetensors") or {}).get("total"),
          "size_bytes": hf_weights_bytes(tree) or None,
          "license": card.get("license"), "base_model": hf_base_model(card), "label": label.group(0).lower() if label else None,
          "recipe_id": draft_id(repo)}


def hf_search(base, query):
  known = hf_known_families()
  fields = "".join(f"&expand[]={f}" for f in ("safetensors", "gated", "cardData", "tags"))
  listing = hf_get(base, "api/models", f"filter=mlx&search={urllib.parse.quote(query)}&limit={HF_LIMIT}&sort=downloads&direction=-1{fields}")
  if not isinstance(listing, list):
    raise Error("Hugging Face gave an answer startdgx can't read")
  items = [i for i in listing if isinstance(i, dict) and valid_repo(i.get("id")) and not i.get("gated")]

  def check(item):
    config = hf_get(base, f"{item['id']}/raw/main/config.json", strict=False)
    return hf_row(base, item) if hf_passes_find(config, known) else None

  with concurrent.futures.ThreadPoolExecutor(HF_WORKERS) as pool:
    return [row for row in pool.map(check, items) if row]


def hf_line(row):
  size = f"{row['size_bytes'] / 2**30:.1f} GiB" if row["size_bytes"] else "-"
  params = f"{row['params'] / 1e9:.1f}B" if row["params"] else "-"
  cells = [row["repo"], params, size, row["license"] or "-", row["base_model"] or "-"] + ([f"[{row['label']}]"] if row["label"] else [])
  return "  ".join(cells)


def hf_cache_file(base, query):
  root = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
  return os.path.join(root, "startdgx", "hf-search", hashlib.sha256(f"{base}\n{query}".encode()).hexdigest() + ".json")


def hf_cached_search(base, query):
  """The rows for a query, from the last hour's answer when there is one (network bases only; STARTDGX_HF_NOW holds the
  clock, in seconds, for tests). Only a good answer is cached, never a failure."""
  if not hf_is_network(base):
    return hf_search(base, query)
  now = float(os.environ.get("STARTDGX_HF_NOW") or time.time())
  path = hf_cache_file(base, query)
  try:
    with open(path) as f:
      cached = json.load(f)
    if isinstance(cached.get("rows"), list) and 0 <= now - cached["at"] < HF_CACHE_SECONDS:
      return cached["rows"]
  except (OSError, ValueError, KeyError, TypeError, AttributeError):
    pass
  rows = hf_search(base, query)
  try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
      json.dump({"at": now, "rows": rows}, f)
    os.replace(path + ".tmp", path)
  except OSError:
    pass
  return rows


def cmd_hf_search(args):
  rows = hf_cached_search(hf_base(), args.query)
  if args.json:
    print(json.dumps(rows))
  elif rows:
    print("\n".join(hf_line(row) for row in rows))
  else:
    print("No known-family MLX 4-bit repos matched", file=sys.stderr)


# recipe draft: a complete user recipe for one repo that passes the same checks as a search row, in the shape of the curated
# TensorFold MLX recipes. Every value comes from the Hugging Face API (the pinned commit, the license, the weights' size); the
# variant is `drafted` with its memory placeholders equal to the weights' size, which never count as fitting (ADR 0001).
DRAFT_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
DRAFT_CTX = 8192
DRAFT_FILES = ["*.safetensors", "*.json", "chat_template.jinja"]
# What a card's license may be to go into a draft: a license id, never free text (it is written into a file the engine reads).
DRAFT_LICENSE_RE = re.compile(r"[A-Za-z0-9._+-]{1,64}")
DRAFT_FREE_LICENSES = re.compile(r"^(apache-2\.0|mit|isc|unlicense|cc0-1\.0|cc-by-4\.0|bsd(-[0-9a-z]+)*|bsl-1\.0|mpl-2\.0)$")
DRAFT_TEMPLATE = """# Written by startdgx from {repo}. The memory numbers are placeholders (the weights' size, or the estimate of the list it came from). A `drafted`
# variant never counts as fitting: measure it (recipe measure) or confirm numbers of your own. An `estimated` one counts once it is confirmed.
name = {name}
summary = {summary}
runtime = "tensorfold"
{vision_input}
[[hardware]]
gpu = "nvidia-gb10"
ram_class = 128

# MLX affine 4-bit export. The server loads the directory.
[[artifacts]]
repo = {repo_q}
revision = "{revision}"
license = {license}
files = {files}
dest = "target"
model = "."

[[variant]]
ctx = {ctx}
peak_ram_gib = {gib}
peak_gpu_gib = {gib}
source = "{source}"
{vision_server}"""


# A repo with a vision_config gets what the curated vision recipes declare: the image input, and the server arguments that load the
# vision tower (TensorFold's --vision, with the curated recipes' limit of 50 images a request). The runtime needs nothing more.
DRAFT_VISION_INPUT = '# Screenshots and photos through the checkpoint\'s vision tower, which --vision loads.\ninput = ["text", "image"]\n'
DRAFT_VISION_SERVER = '\n[server]\nargs = ["--vision", "--vision-max-images", "50"]\n'


def draft_server_block(parallel, vision):
  """The recipe's [server] table: how many requests at once (--parallel) and the vision flags, or nothing."""
  args = (["--parallel", str(parallel)] if parallel else []) + (["--vision", "--vision-max-images", "50"] if vision else [])
  return "\n[server]\nargs = [" + ", ".join(f'"{a}"' for a in args) + "]\n" if args else ""


def draft_id(repo):
  slug = re.sub(r"[^a-z0-9.]+", "-", repo.split("/", 1)[1].lower())
  slug = re.sub(r"(-\.|\.-|\.\.)+", "-", slug).strip("-.")
  return slug if slug.endswith("tensorfold") else f"{slug}-tensorfold"


def draft_name(repo):
  name = re.sub(r"[-_ ]*MLX[-_ ]*4-?bit.*$", "", repo.split("/", 1)[1], flags=re.I) or repo.split("/", 1)[1]
  return re.sub(r"[-_]+", " ", name).strip()


def draft_license(info):
  card = info.get("cardData") or {}
  value = card.get("license")
  if not isinstance(value, str) or not value.strip():
    value = next((t[len("license:"):] for t in info.get("tags") or [] if isinstance(t, str) and t.startswith("license:")), None)
  return value.strip() if isinstance(value, str) and DRAFT_LICENSE_RE.fullmatch(value.strip()) else None


def toml_str(value):
  """A TOML basic string: JSON's escapes are TOML's, except that TOML forbids a raw DEL and rejects the surrogate pairs JSON
  makes of characters beyond the BMP, so the text is kept as it is (the file is UTF-8)."""
  return json.dumps(value, ensure_ascii=False).replace("\x7f", "\\u007f")


def draft_marker(path):
  return os.path.join(os.path.dirname(path), f".{os.path.basename(path)}.sha256")


def draft_unedited(path):
  """Whether `path` is a draft startdgx wrote and nobody has changed since (its text still has the hash it recorded)."""
  try:
    if os.path.islink(path):
      return False
    with open(draft_marker(path), encoding="ascii") as marker, open(path, "rb") as draft:
      return marker.read().strip() == hashlib.sha256(draft.read()).hexdigest()
  except OSError:
    return False


def draft_discard(path):
  """Removes a draft startdgx wrote and nobody edited, with its hash: a try that failed afterwards leaves nothing to block a retry."""
  if draft_unedited(path):
    for name in (path, draft_marker(path)):
      with contextlib.suppress(OSError):
        os.remove(name)


def hf_draft_source(base, repo, revision=None):
  """(commit sha, license or None, weights' bytes, config) of a repo that passes the checks a search row passes, else an Error.
  `revision` (a commit sha) reads that commit instead of main, and the sha comes back only if Hugging Face confirms it."""
  ref = revision or "main"
  info = hf_get(base, f"api/models/{repo}/revision/{revision}" if revision else f"api/models/{repo}")
  if not isinstance(info, dict) or info.get("id") != repo:
    raise Error(f"{repo} wasn't found on Hugging Face (or needs a login)" + (f" at {revision[:12]}" if revision else ""))
  if info.get("gated"):
    raise Error(f"{repo} is gated: startdgx doesn't use Hugging Face tokens, so it can't download it")
  config = hf_get(base, f"{repo}/raw/{ref}/config.json")
  if not hf_passes_find(config, hf_known_families()):
    raise Error(f"{repo} is outside what Find on Hugging Face lists: its config.json must say MLX affine 4-bit of a known family")
  sha = info.get("sha")
  if not isinstance(sha, str) or not re.match(r"^[0-9a-f]{40}$", sha) or (revision and sha != revision):
    raise Error(f"Hugging Face gave no commit for {repo}" + (f" matching {revision[:12]}" if revision else ""))
  size = hf_weights_bytes(hf_get(base, f"api/models/{repo}/tree/{ref}"))
  if not size:
    raise Error(f"{repo} has no .safetensors weights")
  return sha, draft_license(info), size, config


DRAFT_DRAFTER_RE = re.compile(r"draft|eagle|mtp|speculat", re.I)


def draft_judgement(repo, config):
  """What in this repo the template can't settle, so an agent should look: ["drafter", "server"]. A vision_config is not one:
  the template sets the image input and the vision server arguments itself."""
  why = []
  nextn = config.get("num_nextn_predict_layers")
  if DRAFT_DRAFTER_RE.search(repo.split("/", 1)[1]) or (isinstance(nextn, int) and nextn > 0):
    why.append("drafter")
  if config.get("rope_scaling"):
    why.append("server")
  return why


JUDGEMENT_TEXT = {"drafter": "it is, or carries, a speculative drafter (the template has no field for one)",
                  "server": "its config scales positions (rope_scaling), which may need server arguments the template cannot set"}


def draft_host_rows(host):
  """The recipes a machine has, curated and the user's, by id."""
  if DEMO:
    with demo_state() as state:
      return {r["id"]: r for r in demo_host(state, host)["list"]}
  try:
    rows = json.loads(ssh(target(host), "recipe", "list", "--json", timeout=60).stdout)
    return {r["id"]: r for r in rows}
  except (ValueError, KeyError, TypeError) as error:
    raise Error(f"{host} gave a recipe list startdgx can't read") from error


def draft_variant_sources(host, rid):
  """The source of each variant of a recipe the machine has."""
  if DEMO:
    with demo_state() as state:
      return [v["source"] for v in demo_variants_of(demo_host(state, host), rid)]
  out = ssh_raw(target(host), f"python3 -I - {shlex.quote(rid)}", stdin=VARIANTS_PROBE, timeout=60, what="probe").stdout
  return [v["source"] for v in (parse_variants(out) if out.strip() else None) or []]


def draft_check_host(host, rid, force=False):
  """Nothing when the machine has no recipe `rid`; True when it has one of yours that is only a draft (placeholders, nothing worth keeping:
  adding replaces it), or any one of yours no model is set up from when `force` (an update, which discards what was measured); else an
  Error, for a recipe that holds more (curated, set up, measured, or numbers you confirmed)."""
  row = draft_host_rows(host).get(rid)
  if row is None:
    return None
  if row.get("user") is True and row.get("installed") is not True:
    if force:
      return True
    sources = draft_variant_sources(host, rid)
    if sources and all(source == "drafted" for source in sources):
      return True
    # An estimate startdgx wrote from TensorFold's list is as good as a draft: nothing of yours is lost by replacing it.
    if sources and all(source == "estimated" for source in sources) and rid in (tf_added_load().get(host) or {}):
      return True
  raise Error(f"{host} already has a recipe '{rid}' that holds more than a draft (it is curated, measured, set up, or has numbers you confirmed): "
              "remove it first in Add recipe…, or pick another id with --id")


def draft_validate(host, rid, text):
  """The host's engine validates the draft (as the Add recipe path does), else an Error with its errors."""
  result = demo_recipe_check(host, "validate", rid, text) if DEMO else recipe_send(target(host), "validate", rid, text, 60)
  if not result["ok"]:
    raise Error(f"{host}'s engine rejects the draft: " + "; ".join(result["errors"]))


def draft_recipe(args, replace=False):
  """Writes the draft and returns its result dict, for cmd_recipe_draft and cmd_recipe_author. With a host, the host's engine
  validates it first, and a draft it rejects is removed. `replace` lets it take the place of a draft startdgx wrote and nobody
  edited, so a try that failed afterwards can be repeated; any other file in the way is never touched."""
  repo = args.repo
  if not valid_repo(repo):
    raise Error("Name the repo as OWNER/NAME, e.g. TensorFold/Qwen3.8-27B-MLX-4bit")
  rid = args.id or draft_id(repo)
  if not RID_RE.match(rid):
    raise Error(f"'{rid}' can't be a recipe id (lower-case letters, digits, dots and dashes): pick one with --id")
  sha, license_id, size, config = hf_draft_source(hf_base(), repo, getattr(args, "revision", None))
  replaces = bool(args.host) and draft_check_host(args.host, rid, getattr(args, "replace", False)) is True
  out = args.out or os.path.join(demo_dir() if DEMO else os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                                                                       "startdgx"), "drafts")
  path = os.path.join(out, f"{rid}.toml")
  if os.path.lexists(path) and not (replace and draft_unedited(path)):
    raise Error(f"{path} already exists: pick another id with --id, or delete the file")
  gib = getattr(args, "estimate_gib", None) or -(-size * 10 // 2**30) / 10
  variant_source = getattr(args, "variant_source", "drafted")
  summary_text = getattr(args, "summary", None)
  if getattr(args, "size_estimate", False) and variant_source == "drafted":
    # --estimated on a repo outside TensorFold's list: nobody has estimated it, so the figure is the weights plus a margin for the
    # context and the runtime (a guess, said so in the summary), and the person's add stands for confirming it.
    gib = -(-int((size * 1.2 / 2**30 + 2) * 10) // 1) / 10
    variant_source = "estimated"
    summary_text = f"Added from {repo}: MLX 4-bit on TensorFold. Its memory numbers are a guess from the size of its files (1.2 times the weights plus 2 GiB), not measured."
  warnings = []
  if license_id is None:
    warnings.append("License unknown: Hugging Face reports none startdgx can use for this repo, so read its model card before you use it")
  elif not DRAFT_FREE_LICENSES.match(license_id.lower()):
    warnings.append(f"License '{license_id}' may restrict use: read its terms before you use it")
  vision = getattr(args, "vision", None)
  vision = bool(config.get("vision_config")) if vision is None else vision
  ctx = getattr(args, "context", None) or DRAFT_CTX
  parallel = getattr(args, "parallel", None)
  text = DRAFT_TEMPLATE.format(repo=repo, name=toml_str(draft_name(repo)), repo_q=toml_str(repo), revision=sha,
                               summary=toml_str(summary_text or f"Drafted from {repo}: MLX 4-bit on TensorFold. The memory numbers are placeholders until it is measured."),
                               license=toml_str(license_id or "unknown"), files=toml_str(DRAFT_FILES), ctx=ctx, gib=gib, source=variant_source,
                               vision_input=DRAFT_VISION_INPUT if vision else "", vision_server=draft_server_block(parallel, vision))
  data = text.encode("utf-8")
  try:
    os.makedirs(out, exist_ok=True)
    if os.path.lexists(path):
      os.remove(path)
    with open(path, "xb") as handle:
      handle.write(data)
    with open(draft_marker(path), "w", encoding="ascii") as marker:
      marker.write(hashlib.sha256(data).hexdigest() + "\n")
  except OSError as error:
    for name in (path, draft_marker(path)):
      with contextlib.suppress(OSError):
        os.remove(name)
    raise Error(f"{path} can't be written: {error.strerror}") from error
  if args.host:
    try:
      draft_validate(args.host, rid, text)
    except Error:
      draft_discard(path)
      raise
  result = {"ok": True, "id": rid, "repo": repo, "path": path, "revision": sha, "license": license_id or "unknown", "weights_bytes": size,
            "placeholder_gib": gib, "source": variant_source, "warnings": warnings, "judgement": draft_judgement(repo, config),
            "name": draft_name(repo), "ctx": ctx, "replaces_draft": replaces}
  return result


# ---- TensorFold's recipe list --------------------------------------------------------------------------------
# tensorfold.dev publishes what runs on a machine class as /recipes/catalog.json. startdgx reads it from this computer (read-only,
# like Hugging Face), lists what it has for one DGX Spark (128 GB) and what changed since the last look, and drafts a recipe from
# an entry through `recipe draft`: the catalog's memory figure is an estimate, so the draft's variant is `drafted` and never counts
# as fitting until a measuring run (docs/adr/0001). The list is a third party's: every field is checked and printed as plain text.

TF_DEFAULT_CATALOG = "https://tensorfold.dev/recipes/catalog.json"
TF_DEVICE = "dgx-spark"
TF_MAX_BYTES = 8 * 2**20
TF_CHECKPOINT_RE = re.compile(r"^https://huggingface\.co/([A-Za-z0-9._-]+/[A-Za-z0-9._-]+)/tree/([0-9a-f]{40})$")
TF_FORMAT = "MLX 4-bit"  # the one format the pinned TensorFold runtime is set up for: the others need a runtime startdgx doesn't pin


def tf_clean(text, limit=80):
  """A third party's text as one safe line: no control characters, bounded."""
  return re.sub(r"[\x00-\x1f\x7f]", "", text)[:limit] if isinstance(text, str) else ""


def tf_source():
  return os.path.join(DEMO_FIXTURES, "tensorfold", "catalog.json") if DEMO else os.environ.get("STARTDGX_TENSORFOLD_CATALOG") or TF_DEFAULT_CATALOG


def tf_catalog():
  """The parsed catalog document, else an Error."""
  source = tf_source()
  try:
    if re.match(r"^https?://", source):
      request = urllib.request.Request(source, headers={"User-Agent": "startdgx", "Accept": "application/json"})
      with urllib.request.urlopen(request, timeout=HF_TIMEOUT) as response:
        raw = response.read(TF_MAX_BYTES + 1)
    else:
      with open(source, "rb") as handle:
        raw = handle.read(TF_MAX_BYTES + 1)
  except urllib.error.HTTPError as error:
    raise Error(f"tensorfold.dev answered {error.code}") from error
  except (urllib.error.URLError, OSError) as error:
    raise Error("Can't reach tensorfold.dev: check the network") from error
  if len(raw) > TF_MAX_BYTES:
    raise Error("tensorfold.dev's list is larger than startdgx reads")
  try:
    document = json.loads(raw)
  except ValueError:
    document = None
  if not isinstance(document, dict) or document.get("schemaVersion") != 1 or not isinstance(document.get("records"), list):
    raise Error("tensorfold.dev's list is not in a form startdgx reads (schemaVersion 1)")
  return document


def tf_number(value):
  return value if isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0 else None


TF_INPUTS = ("text", "images", "video")


def tf_settings(settings):
  """The choices a list entry offers, {defaults: {context, parallel, input}, contexts, requests, inputs}, or None when it offers none
  or says something startdgx can't read. Contexts and requests are positive integers, inputs are from TF_INPUTS, and each default is one of its choices."""
  if not isinstance(settings, dict) or not isinstance(settings.get("defaults"), dict):
    return None
  def whole(values):
    return [v for v in values if isinstance(v, int) and not isinstance(v, bool) and v > 0] if isinstance(values, list) else []
  contexts, requests = whole(settings.get("contexts")), whole(settings.get("requests"))
  inputs = [v for v in settings.get("inputs", []) if v in TF_INPUTS] if isinstance(settings.get("inputs"), list) else []
  d = settings["defaults"]
  if not (contexts and requests and inputs and d.get("context") in contexts and d.get("parallel") in requests and d.get("input") in inputs):
    return None
  return {"defaults": {"context": d["context"], "parallel": d["parallel"], "input": d["input"]}, "contexts": contexts, "requests": requests, "inputs": inputs}


def tf_rows(document):
  """One row per catalog record that has a deployment for one DGX Spark: {id, name, format, estimate_gb, weight_gb, repo, revision,
  url, draftable, reason}. A record whose checkpoint is not a pinned Hugging Face commit is listed, and not draftable."""
  rows = []
  for record in document["records"]:
    deployment = record.get("deployments", {}).get(TF_DEVICE) if isinstance(record, dict) and isinstance(record.get("deployments"), dict) else None
    if not isinstance(deployment, dict) or not isinstance(record.get("id"), str) or not RID_RE.match(record["id"]):
      continue
    fmt = tf_clean(deployment.get("format"))
    match = TF_CHECKPOINT_RE.match(deployment.get("checkpoint", "")) if isinstance(deployment.get("checkpoint"), str) else None
    repo, revision = (match.group(1), match.group(2)) if match and valid_repo(match.group(1)) else (None, None)
    base_format = fmt.split(" \u00b7 ")[0]
    reason = "" if repo and base_format == TF_FORMAT else (f"{base_format or 'its format'} needs a newer TensorFold runtime than the engine has" if repo else "no pinned Hugging Face checkpoint")
    source = record.get("source")
    rows.append({"id": record["id"], "name": tf_clean(record.get("name")) or record["id"], "format": fmt, "estimate_gb": tf_number(deployment.get("estimateGB")),
                 "weight_gb": tf_number(deployment.get("weightGB")), "repo": repo, "revision": revision, "recipe_id": draft_id(repo) if repo else "", "settings": tf_settings(deployment.get("settings")),
                 "url": source if isinstance(source, str) and source.startswith("https://") else "", "draftable": reason == "", "reason": reason})
  return rows


def tf_added_path():
  return os.path.join(demo_dir() if DEMO else os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "startdgx"),
                      "tensorfold-added.json")


def tf_added_load():
  """What was added to each machine from the list, {host: {recipe id: {entry, revision, context, parallel, input}}}: the commit and the
  choices, so a later look can tell that the list has moved on."""
  try:
    with open(tf_added_path()) as handle:
      added = json.load(handle)
  except (OSError, ValueError):
    return {}
  return added if isinstance(added, dict) else {}


def tf_added_save(host, rid, record):
  path = tf_added_path()
  added = tf_added_load()
  added.setdefault(host, {})
  if not isinstance(added[host], dict):
    added[host] = {}
  added[host][rid] = record
  try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as handle:
      json.dump(added, handle, indent=2)
    os.replace(path + ".tmp", path)
  except OSError as error:
    raise Error(f"{path} can't be written: {error.strerror}") from error


def tf_seen_path():
  return os.path.join(demo_dir() if DEMO else os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "startdgx"),
                      "tensorfold-seen.json")


def tf_seen():
  """The last saved look, {id: revision or ""}, or None when there is none."""
  try:
    with open(tf_seen_path()) as handle:
      seen = json.load(handle)
  except (OSError, ValueError):
    return None
  return seen if isinstance(seen, dict) else None


def tf_save_seen(rows):
  path = tf_seen_path()
  try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as handle:
      json.dump({r["id"]: r["revision"] or "" for r in rows}, handle, indent=2)
    os.replace(path + ".tmp", path)
  except OSError as error:
    raise Error(f"{path} can't be written: {error.strerror}") from error


def tf_status(row, seen):
  """"new" for an entry the last saved look didn't have, "changed" for one pinned to another commit, else "" (also with no saved look)."""
  if seen is None:
    return ""
  if row["id"] not in seen:
    return "new"
  return "changed" if (row["revision"] or "") != seen[row["id"]] else ""


def cmd_tensorfold_list(args):
  rows = tf_rows(tf_catalog())
  seen = tf_seen()
  mine = tf_added_load().get(args.host, {}) if args.host else {}
  for row in rows:
    row["status"] = tf_status(row, seen)
    # What this machine was last given from the entry, and whether the list has moved on since (another commit).
    added = next((dict(rec, recipe_id=rid) for rid, rec in mine.items() if isinstance(rec, dict) and rec.get("entry") == row["id"]), None)
    row["added"] = added
    row["outdated"] = bool(added and row["revision"] and added.get("revision") != row["revision"])
  if args.update:
    tf_save_seen(rows)
  if args.json:
    print(json.dumps({"device": TF_DEVICE, "first_look": seen is None, "recipes": rows}))
    return
  print(f"tensorfold.dev, one DGX Spark (128 GB): {len(rows)} recipes" + ("" if seen is not None else " (no earlier look saved: --update saves this one, and later runs say what is new or changed)"))
  for row in rows:
    memory = f"{row['estimate_gb']:g} GB estimated" if row["estimate_gb"] else "memory not estimated"
    mark = {"new": " [new]", "changed": " [changed]"}.get(row["status"], "") + (" [update available for " + args.host + "]" if row["outdated"] else "")
    print(f"  {row['id']}{mark}: {row['name']}, {row['format']}, {memory}" + (f"; draft it with: startdgx tensorfold draft {row['id']}" if row["draftable"] else f"; not draftable: {row['reason']}"))
  if args.update:
    print("Saved this look.")


def cmd_tensorfold_draft(args):
  rows = {r["id"]: r for r in tf_rows(tf_catalog())}
  row = rows.get(args.entry)
  if row is None:
    raise Error(f"tensorfold.dev has no recipe '{args.entry}' for one DGX Spark: list them with startdgx tensorfold list")
  if not row["draftable"]:
    raise Error(f"{row['name']} can't be drafted: {row['reason']}")
  settings, chosen = row["settings"], {}
  for key, value, choices in (("context", args.context, settings and settings["contexts"]), ("parallel", args.parallel, settings and settings["requests"]),
                              ("input", args.input, settings and settings["inputs"])):
    if value is None:
      continue
    if not choices:
      raise Error(f"{row['name']} offers no choice of {key}")
    if value not in choices:
      raise Error(f"{row['name']} offers {key} {', '.join(map(str, choices))}, not {value}")
    chosen[key] = value
  # What the recipe will carry, for the record of this add: the choices, or the entry's defaults for the ones not made.
  applied = {key: chosen.get(key, settings["defaults"][key] if settings else None) for key in ("context", "parallel", "input")}
  args.vision = None if "input" not in chosen else chosen["input"] != "text"
  args.context = chosen.get("context") or (settings["defaults"]["context"] if settings else None)
  args.parallel = chosen.get("parallel") if chosen.get("parallel") not in (None, settings and settings["defaults"]["parallel"]) else None
  customized = {k: v for k, v in chosen.items() if settings and v != settings["defaults"][k]}
  estimate = row["estimate_gb"]
  basis = f"tensorfold.dev's estimate of {estimate:g} GB" if estimate else "the weights' size"
  args.repo, args.revision, args.estimate_gib = row["repo"], row["revision"], estimate
  # --estimated: the list's own estimate is the variant's numbers, as the person's say-so (the panel confirms them with the add). An entry
  # without an estimate has nothing to stand on, so it stays drafted.
  args.variant_source = "estimated" if args.estimated and estimate else "drafted"
  how = (" with " + ", ".join(f"{k} {v}" for k, v in customized.items())) if customized else ""
  args.summary = (f"From tensorfold.dev's list ({row['name']}, {row['format']}{how}). Its memory numbers are {basis}, not measured." if args.variant_source == "estimated"
                  else f"Drafted from tensorfold.dev's list ({row['name']}, {row['format']}{how}). The memory numbers are placeholders from {basis}, never a fit until it is measured.")
  result = draft_recipe(args, replace=True)
  if args.host:
    tf_added_save(args.host, result["id"], {"entry": row["id"], "revision": row["revision"], **applied,
                                            "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")})
  if args.json:
    print(json.dumps(result))
    return
  print_draft(result)
  print(f"  Its memory is {basis}; " + ("confirm it with `recipe confirm`, and measure it later for real numbers." if args.variant_source == "estimated" else "measure it before it counts as fitting."))



def print_draft(result):
  print(f"Drafted {result['id']} from {result['repo']} at {result['revision'][:12]}: {result['path']}")
  if result["source"] == "estimated":
    print(f"  license {result['license']}; weights {size_text(result['weights_bytes'])}; the variant is estimated at {result['placeholder_gib']} GiB: it counts as fitting once you confirm it (recipe confirm)")
  else:
    print(f"  license {result['license']}; weights {size_text(result['weights_bytes'])}; the variant is drafted, with {result['placeholder_gib']} GiB placeholders that never count as fitting")
  for warning in result["warnings"]:
    print(f"  Warning: {warning}")


def cmd_recipe_draft(args):
  result = draft_recipe(args, replace=True)
  if args.json:
    print(json.dumps(result))
    return
  print_draft(result)
  print(f"  next: startdgx recipe add HOST {result['path']}")


# recipe author: the draft, then an agent for what needs judgement (or on request). The agent runs in Omarchy's floating terminal, the
# same launcher `launch` uses, and is given the authoring brief (a plain-text file at the plugin root: the installer drops docs/ and
# *.md) with the host, the repo and the draft's path. The command is `agent_command` in ~/.config/startdgx/config.json (default claude).
AUTHOR_BRIEF = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "recipe-authoring-brief.txt")
DEFAULT_AGENT_COMMAND = "claude"


def agent_command():
  path = os.path.join(config_dir(), "config.json")
  try:
    with open(path, encoding="utf-8") as handle:
      value = json.load(handle).get("agent_command", DEFAULT_AGENT_COMMAND)
  except FileNotFoundError:
    return shlex.split(DEFAULT_AGENT_COMMAND)
  except (OSError, ValueError, AttributeError) as error:
    raise Error(f"{path} can't be read as a JSON object") from error
  try:
    words = shlex.split(value) if isinstance(value, str) else []
  except ValueError:
    words = []
  if not words:
    raise Error(f"agent_command in {path} must be a command line, e.g. \"claude\"")
  return words


def author_prompt(host, result):
  try:
    with open(AUTHOR_BRIEF, encoding="utf-8") as handle:
      brief = handle.read()
  except OSError as error:
    raise Error(f"The authoring brief {os.path.normpath(AUTHOR_BRIEF)} can't be read: {error.strerror}") from error
  why = "; ".join(f"{w}: {JUDGEMENT_TEXT[w]}" for w in result["judgement"]) or "none found by the template; the person asked for you"
  return (f"{brief}\nTHIS TASK\nHost: {host}\nRepo: {result['repo']}\nDraft: {result['path']} (recipe id {result['id']})\n"
          f"Why you were started: {why}\n")


def cmd_recipe_author(args):
  agent = agent_command()
  result = draft_recipe(args)
  run = args.agent or bool(result["judgement"])
  if args.json:
    print(json.dumps(dict(result, agent=run)))
  else:
    print_draft(result)
    for w in result["judgement"]:
      print(f"  Needs judgement: {JUDGEMENT_TEXT[w]}")
  if not run:
    if not args.json:
      print(f"  next: startdgx recipe add {args.host} {result['path']}, or start an agent on it: startdgx recipe author {args.host} {args.repo} --id {result['id']} --agent")
    return
  try:
    argv = agent + [author_prompt(args.host, result)]
    if DEMO:
      print(f"Demo: would run '{shlex.join(argv)}' in a terminal")
      return
    sys.stdout.flush()
    try:
      if args.here:
        os.execvp(argv[0], argv)
      os.execvp(LAUNCHER, [LAUNCHER, shlex.join(argv)])
    except OSError as error:
      raise Error(f"Can't start {argv[0] if args.here else LAUNCHER}: {error.strerror}") from error
  except Error:
    draft_discard(result["path"])  # no agent ever saw it, so a retry is not blocked by it
    raise


# Demo mode (STARTDGX_DEMO=1, or the marker file ~/.config/startdgx/demo/ENABLED): the commands serve the fixtures in
# demo/ and change a copy of them under $XDG_STATE_HOME/startdgx-demo, so the panel can be clicked through, and no
# process is ever run. Starts, stops, setups and removals take effect over time, as on a real host: each row is
# advanced from its timestamps whenever it is read, and only the commands that change something write.
DEMO = False
DEMO_FIXTURES = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "demo")
DEMO_RATE = 1_200_000_000  # bytes a second that a demo setup downloads at
DEMO_WAIT_MS = 2000  # how long a demo setup waits before it downloads, as the engine's waits for its lock and unit


DEMO_USB = "/media/demo/usb"


def demo_enabled():
  return os.environ.get("STARTDGX_DEMO") == "1" or os.path.exists(os.path.join(config_dir(), "demo", "ENABLED"))


def demo_dir():
  base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
  return os.path.join(base, "startdgx-demo")


def demo_now_ms():
  """The demo's clock; STARTDGX_DEMO_NOW (seconds since the epoch) holds it still, for tests."""
  return int(float(os.environ.get("STARTDGX_DEMO_NOW") or time.time()) * 1000)


def wall():
  """Makes every way to run a process fail with an Error, so a hole in demo mode can't reach a machine."""
  def refused(name):
    def run(*args, **kwargs):
      raise Error(f"demo mode runs nothing ({name})")
    return run
  for name in ("run", "Popen", "call", "check_call", "check_output", "getoutput", "getstatusoutput"):
    setattr(subprocess, name, refused(f"subprocess.{name}"))
  for name in [n for n in dir(os) if n.startswith(("exec", "spawn", "posix_spawn"))] + ["system", "popen", "fork", "forkpty"]:
    if callable(getattr(os, name, None)):
      setattr(os, name, refused(f"os.{name}"))


def read_fixture(*path):
  with open(os.path.join(DEMO_FIXTURES, *path)) as f:
    return json.load(f)


def write_json(path, doc):
  tmp = f"{path}.{os.getpid()}.tmp"
  with open(tmp, "w") as f:
    json.dump(doc, f, indent=2)
    f.write("\n")
  os.replace(tmp, path)


@contextlib.contextmanager
def demo_state(write=False):
  """The demo's machines by short name, each {status, list}; seeded from the fixtures on first use. A machine with
  no state doesn't answer."""
  folder = demo_dir()
  os.makedirs(folder, exist_ok=True)
  with open(os.path.join(folder, ".lock"), "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    path = os.path.join(folder, "state.json")
    try:
      with open(path) as f:
        state = json.load(f)
    except FileNotFoundError:
      state, write = demo_seed(folder), True
    yield state
    if write:
      write_json(path, state)


def demo_seed(folder):
  now = demo_now_ms()
  if not os.path.exists(os.path.join(folder, "hosts.json")):
    write_json(os.path.join(folder, "hosts.json"), read_fixture("hosts.json"))
  state = {"hosts": {}}
  for name in sorted(os.listdir(os.path.join(DEMO_FIXTURES, "hosts"))):
    status, listing = read_fixture("hosts", name, "status.json"), read_fixture("hosts", name, "list.json")
    for rid, row in status["models"].items():
      if row["unit"] == "installing":
        row["since_ms"] = row["since_ms"] or now
        row["_progress_ms"] = now
        row["_then"] = demo_model_row(status, listing, rid)
      elif row["unit"] in ("activating", "deactivating", "removing"):
        row["since_ms"] = row["since_ms"] or now
    # A machine with the file needs-setup has an engine startdgx didn't install, and isn't set up as root.
    needs_setup = os.path.exists(os.path.join(DEMO_FIXTURES, "hosts", name, "needs-setup"))
    state["hosts"][name] = {"status": status, "list": listing, **({"needs_setup": True} if needs_setup else {})}
    # A machine with the file storage.json starts with a model store set and some models on it ({store, locations}).
    if os.path.exists(os.path.join(DEMO_FIXTURES, "hosts", name, "storage.json")):
      state["hosts"][name]["storage"] = read_fixture("hosts", name, "storage.json")
    # A machine with comfyui.json has ComfyUI installs on it, none managed yet.
    if os.path.exists(os.path.join(DEMO_FIXTURES, "hosts", name, "comfyui.json")):
      state["hosts"][name]["comfyui"] = read_fixture("hosts", name, "comfyui.json")
  return state


def demo_model_row(status, listing, rid):
  """An installed model's row, as the engine's model_record shapes it, for a recipe in the listing; loading."""
  r = next(r for r in listing if r["id"] == rid)
  port = max([row["port"] for row in status["models"].values() if row.get("port")] or [11429]) + 1
  digest = hashlib.sha256(rid.encode()).hexdigest()
  return {"error": "", "fits": True, "fit_reason": "", "shared": False, "recipe": rid, "name": r["name"], "vendor": r["vendor"],
          "runtime": r["runtime"], "image": f"ghcr.io/omacom/{r['runtime']}@sha256:{digest}", "ctx": r["context"],
          "unit": "activating", "sub_state": "start", "result": "success", "port": port, "endpoint": f"http://127.0.0.1:{port}/v1",
          "observed": None, "ram_total_gib": status["ram_total_gib"], "since_ms": None, "expected_load_seconds": 6.0,
          "expected_stop_seconds": 2.0, "expected_remove_seconds": None,
          "_observed": {"load_seconds": 6.0, "ram_used_gib": round((r.get("memory_gib") or 30) * 0.3, 1), "gpu_used_gib": 0.0}}


def demo_advance(row, now):
  """The row as it is at `now`: a download grows, then loads; a load, stop or removal ends once its time is up."""
  row = json.loads(json.dumps(row))
  if row.get("_updating_ms") and now - row["_updating_ms"] >= DEMO_UPDATE_MS:
    row.pop("_updating_ms")
    row["_update"] = None
  if row["unit"] == "installing" and row["install"]["phase"] == "waiting":
    begins = (row.get("since_ms") or now) + DEMO_WAIT_MS
    if now < begins:
      return row
    row["install"].update(phase="downloading", rate_bytes_s=DEMO_RATE)
    row["_progress_ms"] = begins
  if row["unit"] == "installing" and row["install"]["phase"] == "downloading":
    install, since = row["install"], row.get("_progress_ms", now)
    left = install["total_bytes"] - install["done_bytes"]
    if install["rate_bytes_s"] * (now - since) // 1000 < left:
      install["done_bytes"] += install["rate_bytes_s"] * (now - since) // 1000
      row["_progress_ms"] = now
      return row
    row = {**row["_then"], "since_ms": since + left * 1000 // max(install["rate_bytes_s"], 1)}
  elapsed = now - (row.get("since_ms") or now)
  if row["unit"] == "activating" and elapsed >= row["expected_load_seconds"] * 1000:
    row.update(unit="active", sub_state="running", since_ms=None, observed=row.get("observed") or row.get("_observed"))
  elif row["unit"] == "deactivating" and elapsed >= (row["expected_stop_seconds"] or 2) * 1000:
    row.update(unit="inactive", sub_state="dead", since_ms=None)
  elif row["unit"] == "removing" and elapsed >= (row["expected_remove_seconds"] or 3) * 1000:
    return None
  return row


# A demo update waits, then downloads, for this long in all; a row's private `_update` is what the catalog would change.
DEMO_UPDATE_MS = 12000
DEMO_UPDATE_WAIT_MS = 2000


def demo_update_fields(row, now):
  """The engine's `update`, `updating` and `update_progress` of a model row, from its private `_update` and `_updating_ms`."""
  started = row.get("_updating_ms")
  if not started:
    return {"update": row.get("_update"), "updating": False}
  total = int((row.get("_update") or {}).get("download_bytes") or 4.4e9)
  waited = now - started
  if waited < DEMO_UPDATE_WAIT_MS:
    progress = {"phase": "waiting", "done_bytes": 0, "total_bytes": total, "rate_bytes_s": 0}
  else:
    done = min(total, total * (waited - DEMO_UPDATE_WAIT_MS) // (DEMO_UPDATE_MS - DEMO_UPDATE_WAIT_MS))
    progress = {"phase": "downloading", "done_bytes": int(done), "total_bytes": total, "rate_bytes_s": DEMO_RATE}
  return {"update": row.get("_update"), "updating": True, "update_progress": progress}


def demo_host(state, host):
  """The added host's state, advanced to now; one without state doesn't answer, as an unreachable host doesn't."""
  machine = state["hosts"].get(target(host).rsplit("@", 1)[-1])
  if machine is None:
    raise Error(f"{host} didn't answer in time")
  now = demo_now_ms()
  machine["status"]["models"] = {rid: row for rid, row in ((rid, demo_advance(row, now)) for rid, row in machine["status"]["models"].items())
                                 if row is not None}
  return machine


def public(row):
  return {key: value for key, value in row.items() if not key.startswith("_")}


def demo_status(args):
  with demo_state() as state:
    machine = demo_host(state, args.host)
    status, comfyui = machine["status"], machine.get("comfyui", {}).get("installs", [])
  # The demo machine has something else holding 14 GiB (a model loaded through ComfyUI, say), so the bar shows it.
  held = sum((row.get("_observed") or row.get("observed") or {}).get("ram_used_gib") or 0
             for row in status["models"].values() if row["unit"] in ("active", "activating"))
  held += sum(DEMO_COMFYUI_GIB for i in comfyui if i["managed"] and i.get("state") == "up")
  available = round(max(0.0, status["ram_total_gib"] - held - 14), 1)
  running = [{"path": i["path"], "rss_mib": DEMO_COMFYUI_GIB * 1024, "port": 8188, "bind": "0.0.0.0"} for i in comfyui if i["managed"] and i.get("state") == "up"]
  # What a running model holds now (the engine's memory --json): a share of what it took to load, as a model that has settled.
  status_rows = status["models"]

  def shown(row):
    row = public(row)
    held = (row.get("observed") or {}).get("ram_used_gib")
    row = {**row, **demo_update_fields(status_rows[row["recipe"]], demo_now_ms())}
    return {**row, "live_ram_gib": round(held * 0.8, 1)} if row["unit"] == "active" and held else row
  print(json.dumps({**status, "ram_available_gib": available, **({"comfyui": running} if running else {}),
                    "models": {rid: shown(row) for rid, row in status["models"].items()}}, indent=2))


def demo_list(args):
  with demo_state() as state:
    machine = demo_host(state, args.host)
  models = machine["status"]["models"]
  print(json.dumps([{"user": False, "source": "measured", **public(r), "installed": r["id"] in models and models[r["id"]]["unit"] != "installing",
                     "active": models.get(r["id"], {}).get("unit") == "active"} for r in machine["list"]], indent=2))


def demo_set_up(models, rid):
  row = models.get(recipe(rid))
  if row is None or row["unit"] == "installing":
    raise Error(f"{rid} isn't set up. Run: omarchy models use {rid}")
  return row


def demo_start(args):
  with demo_state(write=True) as state:
    status = demo_host(state, args.host)["status"]
    row = demo_set_up(status["models"], args.model)
    if row["unit"] in ("deactivating", "removing"):
      raise Error(f"{args.model} is {'stopping' if row['unit'] == 'deactivating' else 'being removed'}")
    if row["unit"] not in ("active", "activating"):
      if row["fits"] is False:
        raise Error(f"Not enough memory to start model {args.model}: stop another model first")
      row.update(unit="activating", sub_state="start", result="success", error="", since_ms=demo_now_ms())
    status["last"] = args.model
  demo_wait_loaded(args)
  print(f"Started {args.model} at {row['endpoint']}")


def demo_wait_loaded(args):
  """Returns once the model has loaded, as the engine's start does, with the state unlocked meanwhile so a stop
  can come; a model that stops loading (a stop) didn't start. A clock held still (STARTDGX_DEMO_NOW) never moves,
  so then it returns at once."""
  if os.environ.get("STARTDGX_DEMO_NOW"):
    return
  deadline = time.monotonic() + (args.timeout or 600)
  while True:
    with demo_state() as state:
      unit = demo_host(state, args.host)["status"]["models"].get(args.model, {}).get("unit")
    if unit == "active":
      return
    if unit != "activating":
      raise Error(f"{args.model} didn't start: it stopped while it loaded")
    if time.monotonic() >= deadline:
      raise Error(f"{args.host} didn't answer in time")
    time.sleep(0.2)


def demo_stop(args):
  with demo_state(write=True) as state:
    models = demo_host(state, args.host)["status"]["models"]
    if args.model:
      demo_set_up(models, args.model)
    targets = [args.model] if args.model else [rid for rid, row in models.items() if row["unit"] in ("active", "activating")]
    for rid in targets:
      if models[rid]["unit"] in ("active", "activating"):
        models[rid].update(unit="deactivating", sub_state="stop-sigterm", since_ms=demo_now_ms())
  print(f"Stopped {', '.join(targets)}" if targets else "No local model is running")


def demo_share(args):
  rid = recipe(args.model)
  with demo_state(write=True) as state:
    demo_set_up(demo_host(state, args.host)["status"]["models"], rid)["shared"] = not args.off
  print(f"{rid} is no longer shared" if args.off else f"Sharing {rid} on your tailnet (demo)")


def demo_update(args):
  rid = recipe(args.model)
  with demo_state(write=True) as state:
    row = demo_set_up(demo_host(state, args.host)["status"]["models"], rid)
    if row.get("_updating_ms"):
      print(f"{rid} is already being set up; follow it with: journalctl --user -u omarchy-agent-local-use-{rid}.service -f")
      return
    if not row.get("_update"):
      print(f"{rid} is up to date")
      return
    row["_updating_ms"] = demo_now_ms()
  print(f"Updating {rid}: new weights")


def demo_use(args):
  rid = recipe(args.model)
  unit = f"omarchy-agent-local-use-{rid}.service"
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    status, models = machine["status"], machine["status"]["models"]
    r = next((r for r in machine["list"] if r["id"] == rid), None)
    if r is None:
      raise Error(f"No recipe {rid} in the catalog")
    if models.get(rid, {}).get("unit") == "installing":
      print(f"{rid} is already being set up; follow it with: journalctl --user -u {unit} -f")
      return
    if rid in models and args.ctx:
      # A context for a model already set up restarts it with that one, as the engine's re-run of use does.
      if args.ctx not in {v["ctx"] for v in demo_variants_of(machine, rid)}:
        raise Error(f"No measured variant with ctx {args.ctx}")
      now = demo_now_ms()
      models[rid].update(ctx=args.ctx, unit="activating", sub_state="start", result="success", since_ms=now,
                         observed=None, _observed=models[rid].get("observed") or models[rid].get("_observed"))
      print(f"Restarting {rid} with the new setup (its in-flight requests are interrupted)")
      return
    if rid in models:
      raise Error(f"{rid} is already set up: start it with startdgx start {args.host} {rid}")
    if r.get("user") and not args.yes:
      # The engine's own refusal: a recipe of yours downloads what it names and runs it.
      raise Error(f"{rid} is a recipe of yours, so it isn't set up without your say-so: it downloads what the recipe names and runs it. "
                  f"Review it (omarchy models measure {rid} --ctx N shows the download size), then run: omarchy models use {rid} --yes")
    if not r["available"]:
      raise Error(r["reason"] or f"{rid} can't run on {args.host}")
    if machine.get("needs_setup"):
      # The engine's prepare_host, on a machine whose engine startdgx didn't install and that isn't set up as root.
      raise Error("This machine needs Podman set up as root first: run this same command once in a terminal, where sudo can ask for your password")
    now = demo_now_ms()
    models[rid] = {"error": "", "fits": True, "fit_reason": "", "recipe": rid, "name": r["name"], "vendor": r["vendor"], "runtime": "",
                   "image": "", "ctx": None, "unit": "installing", "sub_state": "", "result": "", "port": None, "endpoint": "",
                   "observed": None, "since_ms": now, "expected_load_seconds": 6.0, "expected_stop_seconds": None,
                   "expected_remove_seconds": None,
                   "install": {"phase": "waiting", "done_bytes": 0, "total_bytes": int((r.get("memory_gib") or 30) * 2**29),
                               "rate_bytes_s": 0},
                   "_progress_ms": now, "_then": demo_model_row(status, machine["list"], rid)}
  print(f"Setting up {rid} in the background; the local models panel shows its progress, or follow it with: journalctl --user -u {unit} -f")


def demo_variants_of(machine, rid):
  """A demo recipe's measured contexts, made from its listing row: the listed context, then half and a quarter of it,
  each needing less memory."""
  r = next((r for r in machine["list"] if r["id"] == rid), None)
  if r is None:
    raise Error(f"{rid} isn't in the catalog")
  if r.get("_variants"):
    return [{**v, "confirmed": v["source"] == "estimated" and bool(r.get("_confirmed"))} for v in sorted(r["_variants"], key=lambda v: -v["ctx"])]
  ctx, ram = int(r.get("context") or 131072), float(r.get("memory_gib") or 30)
  return [{"ctx": ctx // 2**n, "peak_ram_gib": round(ram * (1 - 0.15 * n), 1), "peak_gpu_gib": round(ram * (1 - 0.15 * n) - 2, 1), "source": "measured", "confirmed": False}
          for n in range(3)]


def demo_variants(args):
  rid = recipe(args.model)
  with demo_state() as state:
    machine = demo_host(state, args.host)
  print_variants(demo_variants_of(machine, rid), args.json)


# ---- user recipes, in the demo -----------------------------------------------------------------------------
# The demo engine checks a recipe file against rules of its own that look like the fork's validate_recipe (they are not
# it): a name, a summary, a runtime the machine's catalog has, and variants with a context, memory and a known source. The
# messages and Error: forms are the engine's. A user recipe is a row of the machine's list, with its variants in
# `_variants`, which the listing doesn't show.
VARIANT_SOURCES = ("measured", "estimated", "drafted")


def demo_recipe_errors(machine, rid, text):
  """The demo engine's errors for a recipe file's text, one per entry: [] when it is valid."""
  try:
    recipe_toml = tomllib.loads(text)
  except tomllib.TOMLDecodeError as error:
    return [f"recipes/{rid}: not valid TOML: {error}"]
  if any(r["id"] == rid and not r.get("user") for r in machine["list"]):
    return [f"recipes/{rid}: id clashes with the curated recipe '{rid}'; a user recipe never shadows one, pick another id"]
  errors = [f"recipes/{rid}: missing {key}" for key in ("name", "summary") if not str(recipe_toml.get(key, "")).strip()]
  runtimes = {r["runtime"] for r in machine["list"]}
  if not recipe_toml.get("runtime"):
    errors.append(f"recipes/{rid}: missing runtime")
  elif recipe_toml["runtime"] not in runtimes:
    errors.append(f"recipes/{rid}: runtime '{recipe_toml['runtime']}' isn't one of this engine's: {', '.join(sorted(runtimes))}")
  variants = recipe_toml.get("variant", [])
  if not isinstance(variants, list) or not variants:
    errors.append(f"recipes/{rid}: needs at least one [[variant]]")
    variants = []
  for i, v in enumerate(variants, 1):
    if not isinstance(v.get("ctx"), int) or v["ctx"] <= 0:
      errors.append(f"recipes/{rid}: variant {i}: ctx must be a positive whole number")
    for key in ("peak_ram_gib", "peak_gpu_gib"):
      if not isinstance(v.get(key), (int, float)) or v[key] <= 0:
        errors.append(f"recipes/{rid}: variant {i}: {key} must be a positive number")
    if v.get("source", "measured") not in VARIANT_SOURCES:
      errors.append(f"recipes/{rid}: variant {i}: source must be one of {', '.join(VARIANT_SOURCES)}")
    elif v.get("source", "measured") == "measured":
      # The engine's guard: only its measuring run writes measured numbers; a missing source means measured.
      errors.append(f"recipes/{rid}.variant[{i - 1}].source: a recipe of yours can't claim measured numbers (only `measure` writes them); "
                    'set source = "estimated" or source = "drafted"')
  return errors


def demo_recipe_row(rid, recipe_toml):
  """A user recipe's listing row: it runs the largest variant that isn't drafted (a drafted one never fits; an estimated
  one waits for a confirmation the engine asks for)."""
  variants = sorted(({"ctx": v["ctx"], "peak_ram_gib": float(v["peak_ram_gib"]), "peak_gpu_gib": float(v["peak_gpu_gib"]),
                      "source": v.get("source", "measured")} for v in recipe_toml["variant"]), key=lambda v: -v["ctx"])
  top = next((v for v in variants if v["source"] == "measured"), None)
  shown = top or next((v for v in variants if v["source"] == "estimated"), variants[0])
  if top is None and shown["source"] == "estimated" and recipe_toml.get("_confirmed"):
    top = shown
  reason = "" if top else (f"{rid}'s numbers are estimated: confirm them once with recipe confirm before it counts as fitting"
                           if shown["source"] == "estimated" else f"{rid}'s variants are drafted: they never count as fitting until measured")
  return {"id": rid, "name": recipe_toml["name"], "summary": recipe_toml["summary"], "runtime": recipe_toml["runtime"], "tier": "third-party",
          "publisher": "You", "vendor": recipe_toml.get("vendor", ""), "architecture": recipe_toml.get("architecture", ""),
          "user": True, "source": shown["source"], "installed": False, "available": top is not None, "reason": reason, "best": False,
          "active": False, "memory_gib": shown["peak_ram_gib"], "context": shown["ctx"], "decode_tok_s": None, "prefill_tok_s": None,
          "_variants": variants, **({"_confirmed": True} if recipe_toml.get("_confirmed") else {})}


def demo_recipe_in_use(machine, rid):
  row = machine["status"]["models"].get(rid)
  return None if row is None else f"Recipe {rid} is used by the model {rid} ({row['name']}) set up here; remove it first with: omarchy models remove {rid}"


def demo_recipe_check(host, verb, rid, text):
  """The demo engine's validate or add of a recipe's text on a demo host, as recipe_result's dict."""
  adding = verb == "add"
  with demo_state(write=adding) as state:
    machine = demo_host(state, host)
    errors = demo_recipe_errors(machine, rid, text) or ([demo_recipe_in_use(machine, rid)] if adding and demo_recipe_in_use(machine, rid) else [])
    if not errors and adding:
      machine["list"] = [r for r in machine["list"] if r["id"] != rid] + [demo_recipe_row(rid, tomllib.loads(text))]
  return recipe_result(False, rid, errors) if errors else recipe_result(True, rid, message=f"Added recipe {rid}" if adding else f"Recipe {rid} is valid")


def demo_recipe_send(args):
  rid, text = read_recipe_file(args.file)
  return print_recipe_result(demo_recipe_check(args.host, args.verb, rid, text), args.json)


def demo_recipe_list(args):
  demo_list(args)


def demo_recipe_remove(args):
  rid = recipe(args.id)
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid), None)
    if row is None or not row.get("user"):
      raise Error(f"No recipe of yours named '{rid}'" + (" (it is a curated recipe, which can't be removed)" if row else ""))
    if demo_recipe_in_use(machine, rid):
      raise Error(demo_recipe_in_use(machine, rid))
    machine["list"] = [r for r in machine["list"] if r["id"] != rid]
  print(f"Removed recipe {rid}")


def demo_recipe_measure(args):
  """The engine's measure on a demo recipe of yours: its dry-run text, or (--yes) the variant measured, with numbers a
  little under what it expected. (The engine also leaves the model running; the demo doesn't set one up.)"""
  rid = recipe(args.id)
  with demo_state(write=args.yes) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid), None)
    if row is not None and not row.get("user"):
      raise Error(f"{rid} is a curated recipe: it ships its own measurements, and measure only works on your own recipes (add one with: omarchy models recipe add FILE)")
    if row is None:
      raise Error(f"No recipe of yours named '{rid}'")
    variant = next((v for v in row["_variants"] if v["ctx"] == args.ctx), None)
    if variant is None:
      raise Error(f"{rid} has no [[variant]] with ctx {args.ctx} (it has: {', '.join(str(v['ctx']) for v in row['_variants'])}); "
                  "add one with source = \"drafted\" or \"estimated\", then measure it")
    print(f"Measure {rid} at context {args.ctx} (now a {variant['source']} variant)")
    print(f"  download: {size_text(int(variant['peak_ram_gib'] * 2**29))} to download")
    print(f"  load: {row['name']} on {row['runtime']}, context {args.ctx}; it expects about {variant['peak_ram_gib']:g} GiB RAM and {variant['peak_gpu_gib']:g} GiB GPU")
    print("  while it runs, every other omarchy models command waits for it (the local models panel's start and stop too): typically a few minutes")
    print("  then: restarts the model if it runs, runs the bench (a few minutes), leaves it running, and rewrites this variant")
    if not args.yes:
      print("Nothing was changed. Run again with --yes to do it.")
      return
    variant.update(peak_ram_gib=round(variant["peak_ram_gib"] * 0.9, 1), peak_gpu_gib=round(variant["peak_gpu_gib"] * 0.9, 1), source="measured")
    machine["list"] = [demo_recipe_row(r["id"], {"name": r["name"], "summary": r["summary"], "runtime": r["runtime"], "vendor": r["vendor"],
                                                 "variant": r["_variants"], "_confirmed": r.get("_confirmed")}) if r["id"] == rid else r
                       for r in machine["list"]]
    print(f"Measured {rid} at context {args.ctx}: {variant['peak_ram_gib']:g} GiB RAM, {variant['peak_gpu_gib']:g} GiB GPU")


def demo_recipe_confirm(args):
  rid = recipe(args.id)
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid and r.get("user")), None)
    if row is None:
      raise Error(f"No recipe of yours named '{args.id}'")
    estimated = [v for v in row["_variants"] if v["source"] == "estimated"]
    if not estimated:
      raise Error(f"Recipe {rid} has no estimated variant to confirm")
    row["_confirmed"] = True
    row.update(available=True, reason="")
  print(f"Confirmed {len(estimated)} estimated variant(s) of {rid}")


def demo_recipe_context(args):
  """The demo engine's recipe context: a drafted variant at that context (its numbers those of the biggest variant), or with
  --remove the variant(s) there away."""
  rid = recipe(args.id)
  if args.ctx < 1024:
    raise Error("A context is a number of tokens, 1024 or more")
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid and r.get("user")), None)
    if row is None:
      raise Error(f"No recipe of yours named '{rid}' on {args.host}")
    if demo_recipe_in_use(machine, rid):
      raise Error(demo_recipe_in_use(machine, rid))
    there = [v for v in row["_variants"] if v["ctx"] == args.ctx]
    if args.remove:
      if not there:
        raise Error(f"{rid}: it has no {args.ctx // 1024}K context")
      if len(there) == len(row["_variants"]):
        raise Error(f"{rid}: that is its only context: a recipe needs at least one")
      row["_variants"] = [v for v in row["_variants"] if v["ctx"] != args.ctx]
    else:
      if there:
        raise Error(f"{rid}: it has a {args.ctx // 1024}K context already")
      top = max(row["_variants"], key=lambda v: (v["peak_ram_gib"], v["peak_gpu_gib"]))
      row["_variants"] = sorted(row["_variants"] + [{"ctx": args.ctx, "peak_ram_gib": top["peak_ram_gib"], "peak_gpu_gib": top["peak_gpu_gib"], "source": "drafted"}],
                                key=lambda v: -v["ctx"])
  print(f"Removed the {args.ctx // 1024}K context from {rid}" if args.remove
        else f"Added a {args.ctx // 1024}K context to {rid}, drafted: measure it before it counts as fitting")


def demo_recipe(args):
  return {"validate": demo_recipe_send, "add": demo_recipe_send, "list": demo_recipe_list, "remove": demo_recipe_remove,
          "measure": demo_recipe_measure, "confirm": demo_recipe_confirm, "context": demo_recipe_context, "fix": cmd_recipe_fix, "draft": cmd_recipe_draft, "author": cmd_recipe_author}[args.verb](args)


def demo_storage_of(machine):
  return machine.setdefault("storage", {"store": None, "locations": {}})


def demo_model_bytes(machine, rid):
  # What a demo setup of it downloads (demo_use and demo_delete), so they agree.
  r = next((r for r in machine["list"] if r["id"] == rid), {})
  return int((r.get("memory_gib") or 30) * 2**29)


def demo_storage(args):
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    storage = demo_storage_of(machine)
    if args.set:
      if not args.set.startswith(DEMO_USB + "/"):
        raise Error(f"{args.set} isn't on an external disk; the root disk is where the models already are")
      on_store = [rid for rid, where in storage["locations"].items() if where != "nvme"]
      if storage["store"] and storage["store"]["path"] != args.set and on_store:
        raise Error(f"{len(on_store)} model file(s) are on the current store, {storage['store']['path']}; move those models back first")
      storage["store"] = {"path": args.set, "present": True}
      return
    if args.unset:
      on_store = [rid for rid, where in storage["locations"].items() if where == "usb"]
      if on_store:
        raise Error(f"{len(on_store)} model file(s) are on the store; move those models back first")
      storage["store"] = None
      return
    models = [{"id": rid, "location": storage["locations"].get(rid, "nvme"), "bytes": demo_model_bytes(machine, rid)}
              for rid, row in sorted(machine["status"]["models"].items()) if row["unit"] != "installing"]
    disk = {"mount": DEMO_USB, "bus": "usb", "fstype": "ext4", "size": 2 * 10**12, "free": 15 * 10**11, "usable": True, "reason": ""}
    print_storage({"store": storage["store"], "disks": [disk], "models": models}, args.json)


def demo_move(args):
  rid = recipe(args.model)
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    storage = demo_storage_of(machine)
    if not storage["store"]:
      raise Error(f"No model store is set; set one with: startdgx storage {args.host} --set PATH")
    row = machine["status"]["models"].get(rid)
    if row is None or row["unit"] == "installing":
      raise Error(f"{rid} isn't set up")
    if row["unit"] in ("active", "activating", "deactivating"):
      raise Error(f"{rid} is running; stop it first")
    here = storage["locations"].get(rid, "nvme")
    if args.to == "usb":
      done = here == "usb"
      storage["locations"][rid] = "usb"
    else:
      done = here in ("nvme", "both")
      storage["locations"][rid] = "both" if here != "nvme" else "nvme"
    print_moved(rid, args.to, None if done else demo_model_bytes(machine, rid))


def demo_delete(args):
  if args.dry_run:
    rid = recipe(args.model)
    with demo_state() as state:
      machine = demo_host(state, args.host)
    row = machine["status"]["models"].get(rid)
    if row is None:
      raise Error(f"{rid} isn't set up on {args.host}")
    if row["unit"] == "installing":
      plan = {"recipe": rid, "setting_up": True, "bytes": row["install"]["done_bytes"]}
    else:
      # What a demo setup of it downloads (demo_use), so the two agree.
      r = next((r for r in machine["list"] if r["id"] == rid), {})
      plan = {"recipe": rid, "setting_up": False, "bytes": int((r.get("memory_gib") or 30) * 2**29)}
    print_remove_plan(plan, args.json)
    return
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    demo_storage_of(machine)["locations"].pop(recipe(args.model), None)
    models = machine["status"]["models"]
    if models.get(recipe(args.model), {}).get("unit") == "installing":
      del models[args.model]
      print(f"Cancelled the setup of {args.model}")
      return
    demo_set_up(models, args.model).update(unit="removing", sub_state="dead", since_ms=demo_now_ms(), expected_remove_seconds=3.0)
  print(f"Removed {args.model}")


def demo_peers(user):
  added = set(load_hosts())
  return [{**p, "target": f"{user}@{p['name']}", "added": f"{user}@{p['name']}" in added} for p in read_fixture("discover.json")]


def demo_add(args):
  name = ssh_target(args.host).rsplit("@", 1)[-1]
  with demo_state() as state:
    known = name in state["hosts"]
  if not known:
    peer = next((p for p in read_fixture("discover.json") if p["name"] == name and p["reachable"]), None)
    raise Error(f"{args.host} has no engine: run startdgx install {args.host}" if peer else f"{args.host} didn't answer in time")
  with hosts_changing() as hosts:
    hosts[args.host] = {"profile": next(iter(read_fixture("hosts.json").values()))["profile"]}
  print(f"{args.host} added")


def demo_says(verb):
  def run(args):
    print(f"Demo: would {verb} {ssh_target(args.host)}{' (dry run)' if getattr(args, 'dry_run', False) else ''}")
  return run


def demo_uninstall(args):
  """The uninstall's plan, as an install startdgx made would have it (podman added, the models' weights kept unless
  --delete-models); anything else only says what it would do."""
  if not (args.dry_run and args.json):
    return demo_says("uninstall from")(args)
  with demo_state() as state:
    machine = demo_host(state, args.host)
  installed = [r for r in machine["list"] if r["id"] in machine["status"]["models"]]
  weights = sum(int((r.get("memory_gib") or 30) * 2**29) for r in installed)
  recipes = sum(1 for r in machine["list"] if r.get("user"))
  where = f"~/{ENGINE_DATA} ({size_text(weights)} of model weights"
  steps = ([FUGUE_HELPER_REMOVE_TEXT] if machine.get("fugue_helper", {}).get("installed") else []) + [
           "stop the engine's units (omarchy-agent-local-*.service)", f"remove ~/{QUADLET_DIR}/omarchy-agent-local.network",
           f"remove the podman network {NETWORK}", f"remove the podman secret {SECRET}",
           uninstall_state_text(bool(recipes) and not args.delete_recipes, recipes), f"delete ~/{ENGINE_CONFIG} (the engine's key, overlays and shares)"]
  steps += [f"delete {where})"] if args.delete_models else []
  steps += [f"delete the engine ~/{ENGINE_DIR}", "as root: disable linger for demo", f"as root: remove {AGENT_LINK}"]
  steps += ["as root: remove the packages podman"] if args.remove_packages else []
  steps += [f"delete {MANIFEST} and the backups", f"forget {args.host} here"]
  kept = ([] if args.delete_models else [f"keep {where}; --delete-models deletes them)"])
  kept += [] if args.remove_packages else ["keep the packages podman (the install added them; --remove-packages removes them)"]
  kept += [uninstall_recipes_kept()] if recipes and not args.delete_recipes else []
  print(json.dumps({"host": args.host, "steps": steps, "kept": kept, "manual": manual_steps(args.host), "models_bytes": weights,
                    "packages": ["podman"], "recipes": recipes}))


def demo_logs(args):
  with demo_state() as state:
    status = demo_host(state, args.host)["status"]
  rid = recipe(args.model) if args.model else status["last"]
  error = status["models"].get(rid or "", {}).get("error")
  print(f"Last error: {error}\n" if error else "", end="")
  print(f"Demo: {rid or 'no model'} on {args.host} has no logs")


DEMO_COMFYUI_GIB = 31  # what a demo ComfyUI holds while it runs


def demo_comfyui_plan(installs, path):
  """The host script's plan: two disks, and what is wrong with a folder."""
  info = {"places": [{"mount": "/", "fstype": "ext4", "free_bytes": 1_200_000_000_000},
                     {"mount": DEMO_USB, "fstype": "ext4", "free_bytes": 1_500_000_000_000}], "home": "/home/demo", "min_free_bytes": 40 * 2**30, "problems": []}
  if path:
    info["path"] = path
    info["free_bytes"] = 20 * 2**30 if path.startswith("/tiny") else 1_200_000_000_000
    if any(i["path"] == path for i in installs):
      info["problems"].append("exists_not_empty")
    if any(i["managed"] and (path == i["path"] or path.startswith(i["path"] + "/")) for i in installs):
      info["problems"].append("inside_managed")
    if info["free_bytes"] < info["min_free_bytes"]:
      info["problems"].append("too_small")
  return info


DEMO_JOB_MS = 8000  # how long a demo install or update runs


def demo_comfyui_job(item):
  """The demo install's job as the host script reports it: running for DEMO_JOB_MS from its start, then succeeded (and installed)."""
  job = item.get("job")
  if not job:
    return {"state": "none", "exit_status": 0, "log": []}
  kind = job.get("kind", "install")
  if demo_now_ms() - job["since_ms"] < DEMO_JOB_MS:
    return {"state": "running", "exit_status": 0, "log": [f"== startdgx: {kind} in {item['path']}", "Toolchain", "PyTorch"]}
  item["installed"] = True
  return {"state": "succeeded", "exit_status": 0, "log": [f"== startdgx: {kind} in {item['path']}", "Done: 11 change(s). Start it with ./dgx-comfyui.sh run"]}


DEMO_RECIPES = (
  {"name": "image_krea2_turbo_t2i", "title": "Krea-2 Turbo text-to-image", "nodes": [], "gated": False,
   "models": [("krea2_turbo.safetensors", "diffusion_models", 12_000_000_000), ("qwen_3_4b.safetensors", "text_encoders", 6_000_000_000),
              ("krea2_vae.safetensors", "vae", 640_000_000), ("krea2_darkbrush.safetensors", "loras", 469_291_992)]},
  {"name": "image_minimax_h3_image_t2i", "title": "MiniMax-H3-Image text-to-image (DGX Spark)", "nodes": ["comfyui-minimax"], "gated": True,
   "models": [("minimax_h3_int8.safetensors", "diffusion_models", 40_000_000_000), ("qwen3_vl_32b_int8.safetensors", "text_encoders", 16_000_000_000)]})


def demo_comfyui_doctor(item):
  """The tool's doctor --json for a demo install: healthy, apart from a swap warning on the dev checkout and a failed node on the dirty one."""
  items = [{"level": "log", "text": "Host"}, {"level": "ok", "text": "GB10, 121 GiB unified memory"}, {"level": "log", "text": "Stack"},
           {"level": "ok", "text": "torch 2.9.0+cu130"}, {"level": "ok", "text": "ComfyUI v0.45.4"}]
  problems = 0
  if item["tool"].get("dirty"):
    items.append({"level": "bad", "text": "manager: ComfyUI-Manager is missing; ./dgx-comfyui.sh install puts it back"})
    problems += 1
  else:
    items.append({"level": "warn", "text": "swap is enabled: heavy workloads can freeze a Spark (./dgx-comfyui.sh tune)"})
  return {"schema": 1, "healthy": problems == 0, "problems": problems, "changes": 0, "items": items}


def demo_comfyui_recipe(item, name, job):
  """A demo recipe as the tool's recipe check --json shapes it: the first model is on disk, the rest are missing until the recipe is installed."""
  found = next((r for r in DEMO_RECIPES if r["name"] == name), None)
  if found is None:
    raise Error(f"no such recipe: {name}")
  done = name in item.get("recipes_done", []) or (job["state"] == "succeeded" and (item.get("job") or {}).get("recipe") == name)
  models, download, have = [], 0, 0
  for index, (file, dest, size) in enumerate(found["models"]):
    state = "have" if done or (index == 0 and name == DEMO_RECIPES[0]["name"]) else "missing"
    model = {"file": file, "dest": dest, "url": "https://example.test/" + file, "size": size, "sha256": "0" * 64, "state": state, "actual_size": size if state == "have" else 0}
    if state == "missing":
      download += size
      model["source"] = ({"ok": False, "problem": "gated", "detail": ["HF_TOKEN", "401"]} if found["gated"] else {"ok": True, "problem": "", "detail": []})
    else:
      have += 1
    models.append(model)
  return {"schema": 1, "name": name, "title": found["title"], "description": "", "notes": "", "run_note": "", "workflow": "", "flags": [],
          "nodes": [{"id": n, "installed": done} for n in found["nodes"]], "models": models, "total_bytes": sum(m[2] for m in found["models"]),
          "have": have, "want": len(models), "download_bytes": download, "ready": not found["gated"]}


def demo_comfyui_remember(item, job):
  """A finished recipe job is remembered before the next job replaces it."""
  previous = item.get("job") or {}
  if previous.get("recipe") and job["state"] == "succeeded":
    item.setdefault("recipes_done", []).append(previous["recipe"])


def demo_comfyui_pick(installs, which):
  """The managed install `which` names (a label or a folder), or the only one; the host script's resolve."""
  managed = [i for i in installs if i["managed"]]
  if not managed:
    raise Error("No ComfyUI is managed on this host; adopt or install one first")
  if which:
    hits = [i for i in managed if i["path"] == which or i["label"] == which]
    if not hits:
      raise Error(f"{which} isn't managed here; adopt it first")
    return hits[0]
  if len(managed) > 1:
    raise Error("Several ComfyUI installs are managed here; say which: " + ", ".join(i["label"] or i["path"] for i in managed))
  return managed[0]


def demo_comfyui(args):
  """The ComfyUI commands on a demo machine: its installs are in comfyui.json (none on a machine without the file).
  Adopting or forgetting one flips its `managed`; start and stop flip its `state` (up or stopped) at once."""
  # `status` and `job` write: reading a job that has run its time marks the install installed, and that has to stay.
  with demo_state(write=args.verb not in ("discover", "list", "plan") and not (args.verb == "recipe" and args.action != "install")) as state:
    installs = demo_host(state, args.host).setdefault("comfyui", {"installs": []})["installs"]
    if args.verb in ("adopt", "forget"):
      path = comfyui_dir(args.dir)
      found = next((i for i in installs if i["path"] == path), None)
      if args.verb == "adopt":
        if found is None or found["kind"] != "dgx-comfyui":
          raise Error(f"{path} isn't a dgx-comfyui install (no dgx-comfyui.sh with a .state or ComfyUI folder beside it)")
        if found["managed"]:
          raise Error(f"{path} is already managed")
        if args.label and not COMFYUI_LABEL_RE.match(args.label):
          raise Error("A label is up to 32 letters, digits, spaces, dots, dashes and underscores")
        found.update(managed=True, label=args.label or "")
        answer = {"adopted": path}
      else:
        if found is None or not found["managed"]:
          raise Error(f"{path} isn't managed")
        stopped = bool(args.stop_service and found.get("autostart"))
        found.update(managed=False, label="", **({"state": "stopped", "autostart": False} if stopped else {}))
        answer = {"forgot": path, "service_removed": stopped}
      print(json.dumps(answer) if args.json else comfyui_done(args.verb, answer, args.host))
      return
    if args.verb == "plan":
      answer = demo_comfyui_plan(installs, comfyui_dir(args.dir) if args.dir else "")
      print(json.dumps(answer) if args.json else "\n".join(f"{x['mount']}  {size_text(x['free_bytes'])} free" for x in answer["places"]))
      return
    if args.verb == "install":
      comfyui_source(args)
      label = args.label or ""
      if label and not COMFYUI_LABEL_RE.match(label):
        raise Error("A label is up to 32 letters, digits, spaces, dots, dashes and underscores")
      plan = demo_comfyui_plan(installs, comfyui_dir(args.dir))
      if plan["problems"]:
        raise Error(f"{plan['path']} can't take an install: " + ", ".join(plan["problems"]))
      installs.append({"path": plan["path"], "kind": "dgx-comfyui", "present": True, "installed": False, "json_capable": True, "sources": ["record"],
                       "managed": True, "label": label, "tool": {"tag": COMFYUI_TAG, "commit": "d913a9f", "branch": "", "dirty": False, "unpushed": 0},
                       "job": {"since_ms": demo_now_ms()}})
      answer = {"job": "startdgx-comfyui-demo", "path": plan["path"], "log": "demo"}
      print(json.dumps(answer) if args.json else f"Installing ComfyUI in {plan['path']} on {args.host}; it takes about 15 minutes")
      return
    if args.verb in ("status", "start", "stop", "autostart", "update", "job", "recipe", "doctor"):
      item = demo_comfyui_pick(installs, comfyui_which(args.dir))
      job = demo_comfyui_job(item)
      if args.verb not in ("status", "job", "recipe") and job["state"] == "running":
        raise Error(f"an install or update is running in {item['path']}; follow it with: startdgx comfyui job")
      if args.verb == "job":
        print(json.dumps({"path": item["path"], **job}) if args.json else "\n".join([job["state"]] + ["  " + l for l in job["log"]]))
        return
      if args.verb == "doctor":
        if not item.get("installed", True):
          raise Error(f"{item['path']} has no ComfyUI yet; install it first")
        if not item["json_capable"]:
          raise Error(f"{item['path']} is too old for startdgx to read its doctor; update it first")
        answer = {"path": item["path"], "doctor": demo_comfyui_doctor(item)}
        if args.json:
          print(json.dumps(answer))
        else:
          cmd_comfyui_doctor_text(answer)
        return
      if args.verb == "recipe":
        if not item.get("installed", True):
          raise Error(f"{item['path']} has no ComfyUI yet; install it first")
        if not item["json_capable"]:
          raise Error(f"{item['path']} is too old for startdgx to read its recipes; update it first")
        if args.action == "list":
          answer = {"path": item["path"], "schema": 1, "recipes": [{"name": r["name"], "valid": True, "title": r["title"], "description": "", "models": len(r["models"]),
                                                                    "total_bytes": sum(m[2] for m in r["models"]), "nodes": len(r["nodes"])} for r in DEMO_RECIPES]}
        else:
          if not args.name:
            raise Error("Name the recipe")
          recipe_doc = demo_comfyui_recipe(item, args.name, job)
          if args.action == "install":
            if job["state"] == "running":
              raise Error(f"an install or update is running in {item['path']}; follow it with: startdgx comfyui job")
            for m in recipe_doc["models"]:
              if m.get("source") and not m["source"]["ok"]:
                var = m["source"]["detail"][0]
                raise Error(f"{m['file']} is gated: it needs {var}. startdgx never stores a token; put {var}=... in ~/.config/startdgx/comfyui.env on the host (then chmod 600 it) and try again")
            if not recipe_doc["download_bytes"] and all(n["installed"] for n in recipe_doc["nodes"]):
              raise Error(f"{args.name} is already installed")
            demo_comfyui_remember(item, job)
            item["job"] = {"since_ms": demo_now_ms(), "kind": "recipe", "recipe": args.name}
            answer = {"job": "startdgx-comfyui-demo", "path": item["path"], "log": "demo"}
          else:
            answer = {"path": item["path"], "recipe": recipe_doc}
        if args.json:
          print(json.dumps(answer))
        else:
          cmd_comfyui_recipe_text(args, answer)
        return
      if args.verb == "update":
        _, ref = comfyui_source(args)
        tool = item["tool"]
        if tool["dirty"]:
          raise Error(f"{item['path']} has uncommitted changes; commit or stash them, or move it yourself: git -C {item['path']} fetch --tags && git -C {item['path']} checkout {ref}")
        if tool["unpushed"]:
          raise Error(f"{item['path']} has commits that aren't pushed; move it yourself: git -C {item['path']} fetch --tags && git -C {item['path']} checkout {ref}")
        if item.get("state") == "up":
          raise Error(f"ComfyUI in {item['path']} is running; stop it first")
        demo_comfyui_remember(item, job)
        item.update(job={"since_ms": demo_now_ms(), "kind": "update"}, tool={**tool, "tag": ref, "branch": ""}, json_capable=True)
        answer = {"job": "startdgx-comfyui-demo", "path": item["path"], "log": "demo"}
        print(json.dumps(answer) if args.json else f"Updating ComfyUI in {item['path']} on {args.host} to {ref}")
        return
      others = [i["path"] for i in installs if i["managed"] and i["path"] != item["path"] and i.get("state") == "up"]
      if args.verb == "status":
        up = item.get("state") == "up"
        answer = {"install": {k: v for k, v in item.items() if k not in ("state", "rss_mib", "autostart", "job")}, "too_old": not item["json_capable"], "running_elsewhere": others,
                  "job": job, "update": comfyui_update_offer(item["tool"]["tag"]), "pinned": COMFYUI_TAG,
                  "status": None if not item["json_capable"] else {
                    "schema": 1, "root": item["path"], "installed": True, "state": "up" if up else "stopped", "pid": 4242 if up else None,
                    "rss_mib": DEMO_COMFYUI_GIB * 1024 if up else None, "port": 8188, "bind": "0.0.0.0",
                    "comfy": {"version": "v0.45.4 (2026-11-15)", "commit": "2aa4d535a", "newer_release": "v0.45.6"},
                    "service": {"installed": bool(item.get("autostart")), "active": up and bool(item.get("autostart")), "enabled": "enabled" if item.get("autostart") else ""}}}
        if args.json:
          print(json.dumps(answer))
        else:
          cmd_comfyui_status_text(answer)
        return
      if args.verb in ("start", "autostart") and not (args.verb == "autostart" and args.state == "off"):
        if not item.get("installed", True):
          raise Error(f"{item['path']} has no ComfyUI yet; install it first")
        if others:
          raise Error(f"ComfyUI in {others[0]} is running; stop it first (one at a time on a machine)")
        item.update(state="up", autostart=True)
        answer = {"started": item["path"]} if args.verb == "start" else {"autostart": True, "path": item["path"]}
      elif args.verb == "autostart":
        if not item.get("autostart"):
          raise Error(f"ComfyUI in {item['path']} isn't set to start at boot")
        item.update(state="stopped", autostart=False)
        answer = {"autostart": False, "path": item["path"]}
      else:
        was = item.get("state") == "up"
        item["state"] = "stopped"
        answer = {"stopped": item["path"], "was_running": was}
      if args.json:
        print(json.dumps(answer))
      else:
        cmd_comfyui_action_text(args, answer)
      return
    shown = installs if args.verb == "discover" else [i for i in installs if i["managed"]]
  shown = [{k: v for k, v in i.items() if k not in ("state", "rss_mib", "autostart", "job")} for i in shown]
  answer = {"installs": shown, **({"partial": False} if args.verb == "discover" else {})}
  if args.json:
    print(json.dumps(answer))
    return
  for item in shown:
    print(comfyui_install_line(item))
  if not shown:
    print("No ComfyUI installs " + ("found" if args.verb == "discover" else "managed") + f" on {args.host}")


def demo_fugue_helper_state(h, fixture):
  """A demo machine's helper as the host script's status says it (h is what the demo keeps: installed, active, enabled, port, models, sha256, key, key_made)."""
  on = bool(h.get("installed"))
  return {"installed": on, "managed": on, "binary": on, "unit": on, "active": on and bool(h.get("active")), "enabled": on and bool(h.get("enabled")),
          "address": f"http://{fixture['tailnet_ip']}:{h['port']}" if on else None, "port": h.get("port"), "listen": fixture["tailnet_ip"] if on else None,
          "models": h.get("models", []), "binary_sha256": h.get("sha256") if on else None, "key": bool(h.get("key")),
          "created": {"binary": on, "unit": on, "key": bool(h.get("key_made"))}}


def demo_fugue_helper(args):
  """The fugue-helper commands on a demo machine, from demo/fugue-helper.json (the tailnet address, a fake key and the binary's hash) and its state."""
  if args.verb == "provider" and not args.json:
    raise Error("provider prints the helper's key, a secret: ask with --json, and keep what it prints private")
  fixture = read_fixture("fugue-helper.json")
  options = fugue_helper_options(args) if args.verb == "install" else {}
  with demo_state(write=args.verb in ("install", "on", "off", "remove")) as state:
    h = demo_host(state, args.host).setdefault("fugue_helper", {"installed": False})
    if args.verb != "install" and not h.get("installed"):
      if args.verb == "status":
        return fugue_helper_print(args, args.host, demo_fugue_helper_state(h, fixture))
      if args.verb == "remove":
        raise Error("startdgx didn't install the Fugue helper on this host (no record); nothing was removed")
      raise Error("the Fugue helper isn't installed here; run: startdgx fugue-helper install")
    if args.verb == "install":
      made = not h.get("key")
      h.update(installed=True, port=options["port"], models=options["models"], sha256=options["sha256"] or fixture["binary_sha256"], key=True,
               key_made=True if made else h.get("key_made", False), active=h.get("active", False) or options["start"], enabled=h.get("enabled", False) or options["start"])
      answer = {**demo_fugue_helper_state(h, fixture), "key_created": made, "started": options["start"]}
    elif args.verb in ("on", "off"):
      h.update(active=args.verb == "on", enabled=args.verb == "on")
      answer = demo_fugue_helper_state(h, fixture)
    elif args.verb == "remove":
      key_left = bool(h.get("key")) and (args.keep_key or not h.get("key_made"))
      key = f"~/{FUGUE_HELPER_KEY}"
      answer = {"removed": [f"~/{FUGUE_HELPER_BINARY}", f"~/{FUGUE_HELPER_UNIT}"] + ([key] if h.get("key") and not key_left else []),
                "kept": [{"path": key, "why": "--keep-key" if args.keep_key else "it was there before startdgx installed the helper"}] if key_left else []}
      h.clear()
      h.update(installed=False, key=key_left, key_made=False)
    else:
      answer = demo_fugue_helper_state(h, fixture)
  if args.verb == "provider":
    answer = {"address": answer["address"], "key": fixture["key"]}
  fugue_helper_print(args, args.host, answer)


DEMO_COMMANDS = {"fugue-helper": demo_fugue_helper, "comfyui": demo_comfyui, "status": demo_status, "list": demo_list, "start": demo_start, "stop": demo_stop, "share": demo_share, "update": demo_update, "use": demo_use, "variants": demo_variants, "recipe": demo_recipe, "delete": demo_delete,
                 "add": demo_add, "storage": demo_storage, "move": demo_move, "install": demo_says("install on"), "uninstall": demo_uninstall, "logs": demo_logs}


# ComfyUI (dgx-comfyui) installs on a host. startdgx keeps its own record of which installs it manages in
# ~/.local/share/startdgx/comfyui.json, a file of its own beside store.json: the install manifest says the ENGINE was
# installed by startdgx (uninstall and discover read its presence that way), and build_manifest rebuilds it whole.
# A record is {path, label, origin ("adopted"), recorded_at, tool_ref}; the path is the real path (what the service unit
# and a running ComfyUI report). startdgx never deletes an install folder.
#
# The host side is one script, run as python3 -I - comfyui MODE [ARGS]. It prints one JSON line, or fails with an
# "Error:" line on stderr. list and discover are read-only: discover reads the service unit, running processes, the
# records and a bounded walk of $HOME (5 deep, no dot folders, symlinked top-level folders such as ~/usbdisk followed),
# and runs no script of an install (git is asked only to describe the tool's checkout).
COMFYUI_UNIT = ".config/systemd/user/dgx-comfyui.service"
COMFYUI_LABEL_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._-]{0,31}$")
COMFYUI_SCRIPT = '''
import fcntl, json, os, re, subprocess, sys, time
HOME = os.path.expanduser("~")
RECORDS, UNIT = os.path.join(HOME, "@RECORDS@"), os.path.join(HOME, "@UNIT@")
SKIP = {"node_modules", "__pycache__", "site-packages", "ComfyUI"}
# The look through the home folder stops after this long (a slow or synced tree), and says so, instead of running into ssh's timeout with nothing.
START, BUDGET, CUT = time.time(), float(os.environ.get("STARTDGX_COMFYUI_WALK_SECONDS") or 40), []
def fail(text):
  print("Error: " + text, file=sys.stderr)
  sys.exit(1)
def clean_path(raw):
  if not raw or any(ord(c) < 32 or ord(c) == 127 or c in '"\\\\' for c in raw):
    fail("that isn't a usable folder name")
  path = os.path.expanduser(raw)
  if not os.path.isabs(path) or ".." in path.split("/"):
    fail("give the folder as an absolute path, or one starting with ~/")
  return os.path.realpath(path)
def load():
  try:
    return json.load(open(RECORDS)).get("installs", [])
  except FileNotFoundError:
    return []
  except (OSError, ValueError, AttributeError):
    fail(RECORDS + " isn't valid JSON; move it aside")
def save(installs):
  os.makedirs(os.path.dirname(RECORDS), exist_ok=True)
  tmp = RECORDS + ".tmp"
  with open(tmp, "w") as f:
    json.dump({"schema": 1, "installs": installs}, f, indent=2)
    f.write("\\n")
  os.replace(tmp, RECORDS)
class locked:
  def __enter__(self):
    os.makedirs(os.path.dirname(RECORDS), exist_ok=True)
    self.f = open(RECORDS + ".lock", "w")
    fcntl.flock(self.f, fcntl.LOCK_EX)
  def __exit__(self, *a):
    self.f.close()
def git(path, *argv):
  try:
    r = subprocess.run(["git", "-C", path, *argv], capture_output=True, text=True, timeout=10, env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    return r.stdout.strip() if r.returncode == 0 else ""
  except (OSError, subprocess.SubprocessError):
    return ""
def is_dgx(path):
  return os.path.isfile(os.path.join(path, "dgx-comfyui.sh")) and (os.path.isdir(os.path.join(path, ".state")) or os.path.isdir(os.path.join(path, "ComfyUI")))
def is_comfy(path):
  return os.path.isfile(os.path.join(path, "main.py")) and os.path.isdir(os.path.join(path, "comfy"))
def inspect(path):
  item = {"path": path, "present": os.path.isdir(path), "kind": "dgx-comfyui" if is_dgx(path) else "foreign"}
  if item["kind"] == "dgx-comfyui":
    item["json_capable"] = os.path.isfile(os.path.join(path, "lib", "jsonout.py"))
    item["installed"] = os.path.isdir(os.path.join(path, "ComfyUI", ".git"))
    item["tool"] = {"tag": git(path, "describe", "--tags", "--exact-match"), "commit": git(path, "rev-parse", "--short", "HEAD"),
                    "branch": git(path, "symbolic-ref", "--short", "-q", "HEAD"),
                    "dirty": bool(git(path, "status", "--porcelain", "--untracked-files=no")),
                    "unpushed": int(git(path, "rev-list", "--count", "@{u}..HEAD") or 0)}
  else:
    item["reason"] = "a ComfyUI without dgx-comfyui.sh: startdgx doesn't manage it" if is_comfy(path) else "not a dgx-comfyui folder"
  return item
def walk(root, depth, found):
  if time.time() - START > BUDGET:
    CUT.append(root)
    return
  try:
    names = sorted(os.listdir(root))
  except OSError:
    return
  if "dgx-comfyui.sh" in names:
    found.setdefault(os.path.realpath(root), set()).add("scan")
    return
  if "main.py" in names and "comfy" in names:
    found.setdefault(os.path.realpath(root), set()).add("scan")
    return
  if depth >= 5:
    return
  for name in names:
    full = os.path.join(root, name)
    if name.startswith(".") or name in SKIP:
      continue
    # A symlinked folder is followed only directly under $HOME (a mount point such as ~/usbdisk).
    if os.path.islink(full) and root != HOME:
      continue
    if os.path.isdir(full):
      walk(full, depth + 1, found)
def discover():
  found = {}
  try:
    for line in open(UNIT):
      if line.startswith("WorkingDirectory="):
        found.setdefault(os.path.realpath(line.split("=", 1)[1].strip()), set()).add("service")
  except OSError:
    pass
  for pid in os.listdir("/proc"):
    if not pid.isdigit():
      continue
    try:
      argv = open("/proc/%s/cmdline" % pid, "rb").read().split(b"\\0")
      if not any(a.endswith(b"main.py") for a in argv):
        continue
      cwd = os.path.realpath("/proc/%s/cwd" % pid)
    except OSError:
      continue
    root = os.path.dirname(cwd)
    if is_dgx(root):
      found.setdefault(root, set()).add("process")
    elif is_comfy(cwd):
      found.setdefault(cwd, set()).add("process")
  records = {os.path.realpath(r["path"]): r for r in load()}
  for path in records:
    found.setdefault(path, set()).add("record")
  walk(HOME, 0, found)
  out = []
  for path in sorted(found, key=lambda p: (p not in records, p)):
    item = inspect(path)
    item["sources"] = sorted(found[path])
    item["managed"] = path in records
    item["label"] = records[path].get("label", "") if path in records else ""
    out.append(item)
  print(json.dumps({"installs": out, "partial": bool(CUT)}))
ANSI = re.compile("\\x1b\\\\[[0-9;]*[A-Za-z]")
def say_line(text):
  lines = [ANSI.sub("", l).strip() for l in text.splitlines() if ANSI.sub("", l).strip()]
  return lines[-1] if lines else "failed"
def resolve(name):
  installs = load()
  if not installs:
    fail("No ComfyUI is managed on this host; adopt or install one first")
  if name:
    if name.startswith("/") or name.startswith("~/"):
      want = clean_path(name)
      hits = [r for r in installs if os.path.realpath(r["path"]) == want]
    else:
      hits = [r for r in installs if r.get("label") == name]
    if not hits:
      fail(name + " isn't managed here; adopt it first")
    return os.path.realpath(hits[0]["path"]), hits[0]
  if len(installs) > 1:
    fail("Several ComfyUI installs are managed here; say which: " + ", ".join(r.get("label") or r["path"] for r in installs))
  return os.path.realpath(installs[0]["path"]), installs[0]
TOKENS = os.path.join(HOME, ".config/startdgx/comfyui.env")
def tokens():
  """HF_TOKEN and CIVITAI_TOKEN from the file the user keeps for them; startdgx never writes it. It must be private to the user."""
  out = {}
  try:
    mode = os.stat(TOKENS).st_mode
  except OSError:
    return out
  if mode & 0o077:
    fail(TOKENS + " can be read by others; run: chmod 600 " + TOKENS)
  for line in open(TOKENS):
    key, _, value = line.strip().partition("=")
    if key in ("HF_TOKEN", "CIVITAI_TOKEN") and value:
      out[key] = value.strip("'\\"")
  return out
def user_env():
  env = dict(os.environ)
  env.update(tokens())
  runtime = "/run/user/%d" % os.getuid()
  env.setdefault("XDG_RUNTIME_DIR", runtime)
  env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=" + runtime + "/bus")
  return env
def running_roots():
  roots = set()
  for pid in os.listdir("/proc"):
    if not pid.isdigit():
      continue
    try:
      argv = open("/proc/%s/cmdline" % pid, "rb").read().split(b"\\0")
      if not any(a.endswith(b"main.py") for a in argv):
        continue
      cwd = os.path.realpath("/proc/%s/cwd" % pid)
    except OSError:
      continue
    if is_dgx(os.path.dirname(cwd)):
      roots.add(os.path.dirname(cwd))
  return roots
def unit_root():
  try:
    for line in open(UNIT):
      if line.startswith("WorkingDirectory="):
        return os.path.realpath(line.split("=", 1)[1].strip())
  except OSError:
    pass
  return ""
def service_active(path):
  if unit_root() != path:
    return False
  return subprocess.run(["systemctl", "--user", "is-active", "--quiet", "dgx-comfyui.service"], env=user_env()).returncode == 0
def tool(path, *argv, timeout=120):
  try:
    r = subprocess.run([os.path.join(path, "dgx-comfyui.sh"), *argv], capture_output=True, text=True, timeout=timeout, env=user_env(), stdin=subprocess.DEVNULL, cwd=path)
  except subprocess.TimeoutExpired:
    fail("dgx-comfyui.sh " + argv[0] + " didn't finish in time")
  except OSError as error:
    fail("can't run " + os.path.join(path, "dgx-comfyui.sh") + ": " + error.strerror)
  return r
import hashlib
LOGDIR = os.path.join(HOME, ".local/state/startdgx/comfyui")
MIN_FREE = int(os.environ.get("STARTDGX_COMFYUI_MIN_FREE") or 40 * 2**30)  # the variable is for tests: ssh never forwards it
JOB_INSTALL = "\\n".join([
  'set -eu',
  'echo "== startdgx: install in $1 ($(date -Is))"',
  'if [ ! -f "$1/dgx-comfyui.sh" ]; then git -c advice.detachedHead=false clone --quiet --branch "$3" -- "$2" "$1"; fi',
  'cd "$1"',
  'exec ./dgx-comfyui.sh install </dev/null'])
JOB_UPDATE = "\\n".join([
  'set -eu',
  'echo "== startdgx: update in $1 to $2 ($(date -Is))"',
  'cd "$1"',
  'git fetch --tags --quiet origin',
  'git -c advice.detachedHead=false checkout --quiet "$2"',
  'if [ "$3" = comfyui ]; then exec ./dgx-comfyui.sh update </dev/null; fi',
  'exec ./dgx-comfyui.sh install </dev/null'])
JOB_RECIPE = "\\n".join([
  'set -eu',
  'echo "== startdgx: recipe $2 in $1 ($(date -Is))"',
  'cd "$1"',
  'exec ./dgx-comfyui.sh recipe install "$2" --yes </dev/null'])
def unit_name(path):
  return "startdgx-comfyui-" + hashlib.sha1(path.encode()).hexdigest()[:10]
def log_path(path):
  return os.path.join(LOGDIR, unit_name(path) + ".log")
def job_state(path):
  unit = unit_name(path)
  r = subprocess.run(["systemctl", "--user", "show", unit, "-p", "LoadState,ActiveState,SubState,Result,ExecMainStatus"], capture_output=True, text=True, env=user_env())
  props = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
  if props.get("LoadState", "not-found") == "not-found":
    state = "none"
  elif props.get("ActiveState") == "failed":
    state = "failed"
  elif props.get("ActiveState") == "active" and props.get("SubState") == "exited":
    state = "succeeded"
  elif props.get("ActiveState") in ("active", "activating"):
    state = "running"
  else:
    state = "none"
  tail = []
  try:
    tail = [ANSI.sub("", l.rstrip("\\n")) for l in open(log_path(path), errors="replace").readlines()[-20:]]
  except OSError:
    pass
  return {"state": state, "exit_status": int(props.get("ExecMainStatus") or 0), "log": tail}
def no_job_running(path):
  if job_state(path)["state"] == "running":
    fail("an install or update is running in " + path + "; follow it with: startdgx comfyui job")
def start_job(path, script, *args):
  user = os.environ.get("USER") or os.path.basename(HOME)
  linger = subprocess.run(["loginctl", "show-user", user, "-p", "Linger", "--value"], capture_output=True, text=True).stdout.strip()
  if linger != "yes":
    fail("A 15-minute install needs this account to keep running after the ssh session ends. Run on the host: sudo loginctl enable-linger " + user)
  os.makedirs(LOGDIR, exist_ok=True)
  unit, log = unit_name(path), log_path(path)
  open(log, "w").close()
  subprocess.run(["systemctl", "--user", "stop", unit], capture_output=True, env=user_env())
  subprocess.run(["systemctl", "--user", "reset-failed", unit], capture_output=True, env=user_env())
  r = subprocess.run(["systemd-run", "--user", "--unit", unit, "--description=startdgx ComfyUI job", "-p", "RemainAfterExit=yes",
                      "-p", "StandardOutput=append:" + log, "-p", "StandardError=append:" + log, "-p", "EnvironmentFile=-" + TOKENS, "--", "bash", "-c", script, "startdgx-comfyui", *args],
                     capture_output=True, text=True, env=user_env())
  if r.returncode != 0:
    fail("Couldn't start the job: " + say_line(r.stderr or r.stdout))
  return {"job": unit, "path": path, "log": log}
def places():
  out, seen = [], set()
  for line in open("/proc/mounts"):
    dev, mount, fstype = line.split()[:3]
    mount = mount.replace("\\\\040", " ")
    if fstype not in ("ext4", "xfs", "btrfs", "f2fs", "exfat", "ntfs3", "fuseblk") or mount in seen or mount.startswith(("/boot", "/snap", "/var/lib", "/etc", "/usr")):
      continue
    seen.add(mount)
    try:
      st = os.statvfs(mount)
    except OSError:
      continue
    if os.access(mount, os.W_OK):
      out.append({"mount": mount, "fstype": fstype, "free_bytes": st.f_bavail * st.f_frsize})
  return out
def plan(raw):
  info = {"places": places(), "home": HOME, "min_free_bytes": MIN_FREE, "problems": []}
  if not raw:
    return info
  path = clean_path(raw)
  info["path"] = path
  if os.path.exists(path) and (not os.path.isdir(path) or os.listdir(path)):
    info["problems"].append("exists_not_empty")
  inside = [r["path"] for r in load() if path == os.path.realpath(r["path"]) or path.startswith(os.path.realpath(r["path"]) + "/")]
  if inside:
    info["problems"].append("inside_managed")
  probe = path
  while not os.path.exists(probe):
    probe = os.path.dirname(probe)
  info["free_bytes"] = os.statvfs(probe).f_bavail * os.statvfs(probe).f_frsize
  if not os.access(probe, os.W_OK):
    info["problems"].append("not_writable")
  if info["free_bytes"] < MIN_FREE:
    info["problems"].append("too_small")
  return info
ARGV = sys.argv[2:]
mode = ARGV[0]
if mode == "discover":
  discover()
elif mode == "list":
  out = []
  for r in load():
    item = inspect(r["path"])
    item.update(managed=True, label=r.get("label", ""), origin=r.get("origin", ""), recorded_at=r.get("recorded_at", 0), tool_ref=r.get("tool_ref", ""))
    out.append(item)
  print(json.dumps({"installs": out}))
elif mode == "adopt":
  path, label = clean_path(ARGV[1]), ARGV[2] if len(ARGV) > 2 else ""
  if not is_dgx(path):
    fail(path + " isn't a dgx-comfyui install (no dgx-comfyui.sh with a .state or ComfyUI folder beside it)")
  with locked():
    installs = load()
    if any(os.path.realpath(r["path"]) == path for r in installs):
      fail(path + " is already managed")
    tool = inspect(path)["tool"]
    installs.append({"path": path, "label": label, "origin": "adopted", "recorded_at": int(time.time()), "tool_ref": tool["tag"] or tool["commit"]})
    save(installs)
  print(json.dumps({"adopted": path}))
elif mode == "forget":
  path = clean_path(ARGV[1])
  stopped = False
  if len(ARGV) > 2 and ARGV[2] == "stop-service" and is_dgx(path) and unit_root() == path:
    r = tool(path, "service", "--disable")
    if r.returncode != 0:
      fail(say_line(r.stderr or r.stdout))
    stopped = True
  with locked():
    installs = load()
    rest = [r for r in installs if os.path.realpath(r["path"]) != path]
    if len(rest) == len(installs):
      fail(path + " isn't managed")
    save(rest)
  print(json.dumps({"forgot": path, "service_removed": stopped}))
elif mode == "plan":
  print(json.dumps(plan(ARGV[1] if len(ARGV) > 1 else "")))
elif mode == "install":
  info = plan(ARGV[1])
  label, repo, ref = ARGV[2], ARGV[3], ARGV[4]
  path = info["path"]
  with locked():
    installs = load()
    mine = [r for r in installs if os.path.realpath(r["path"]) == path]
    # An install of ours whose job failed is run again where it stopped; anything else must be a fresh folder.
    if mine and mine[0].get("origin") == "created" and job_state(path)["state"] == "failed":
      out = start_job(path, JOB_INSTALL, path, repo, ref)
    else:
      if info["problems"]:
        fail(path + " can't take an install: " + ", ".join(info["problems"]))
      out = start_job(path, JOB_INSTALL, path, repo, ref)
      installs.append({"path": path, "label": label, "origin": "created", "recorded_at": int(time.time()), "tool_ref": ref})
      save(installs)
  print(json.dumps(out))
elif mode == "job":
  path, record = resolve(ARGV[1] if len(ARGV) > 1 and ARGV[1] else "")
  print(json.dumps({"path": path, **job_state(path)}))
elif mode == "update":
  path, record = resolve(ARGV[1] if len(ARGV) > 1 and ARGV[1] else "")
  ref, comfy = ARGV[2], ARGV[3] == "comfyui"
  item = inspect(path)
  if item["kind"] != "dgx-comfyui" or not item.get("tool", {}).get("commit"):
    fail(path + " isn't a git checkout of dgx-comfyui")
  no_job_running(path)
  t = item["tool"]
  if t["dirty"]:
    fail(path + " has uncommitted changes; commit or stash them, or move it yourself: git -C " + path + " fetch --tags && git -C " + path + " checkout " + ref)
  if t["unpushed"]:
    fail(path + " has commits that aren't pushed; move it yourself: git -C " + path + " fetch --tags && git -C " + path + " checkout " + ref)
  # A clean checkout on a branch moves too: the branch stays where it is, and the record says which one it was on (git checkout BRANCH goes back).
  if path in running_roots():
    fail("ComfyUI in " + path + " is running; stop it first")
  with locked():
    installs = load()
    for r in installs:
      if os.path.realpath(r["path"]) == path:
        r["previous_ref"] = t["branch"] or t["tag"] or t["commit"]
        r["tool_ref"] = ref
    save(installs)
  print(json.dumps(start_job(path, JOB_UPDATE, path, ref, "comfyui" if comfy else "tool")))
elif mode == "doctor":
  path, record = resolve(ARGV[1] if len(ARGV) > 1 and ARGV[1] else "")
  item = inspect(path)
  if item["kind"] != "dgx-comfyui" or not item["installed"]:
    fail(path + " has no ComfyUI yet; install it first")
  if not item["json_capable"]:
    fail(path + " is too old for startdgx to read its doctor; update it first")
  # Read-only: dgx-comfyui's doctor reports every part and changes nothing.
  r = tool(path, "doctor", "--json", timeout=300)
  try:
    print(json.dumps({"path": path, "doctor": json.loads(r.stdout)}))
  except ValueError:
    fail("dgx-comfyui.sh doctor gave no JSON: " + say_line(r.stderr or r.stdout))
elif mode == "recipe":
  path, record = resolve(ARGV[1] if len(ARGV) > 1 and ARGV[1] else "")
  sub, name, verify = ARGV[2], ARGV[3] if len(ARGV) > 3 else "", len(ARGV) > 4 and ARGV[4] == "verify"
  item = inspect(path)
  if item["kind"] != "dgx-comfyui" or not item["installed"]:
    fail(path + " has no ComfyUI yet; install it first")
  if not item["json_capable"]:
    fail(path + " is too old for startdgx to read its recipes; update it first")
  if name and not re.match(r"^[A-Za-z0-9][A-Za-z0-9._-]*$", name):
    fail("not a recipe name")
  def recipe_json(*argv):
    r = tool(path, "recipe", *argv, "--json", timeout=300)
    try:
      return json.loads(r.stdout)
    except ValueError:
      fail("dgx-comfyui.sh recipe gave no JSON: " + say_line(r.stderr or r.stdout))
  if sub == "list":
    print(json.dumps({"path": path, **recipe_json("list")}))
  elif sub == "show":
    print(json.dumps({"path": path, "recipe": recipe_json("show", name)}))
  elif sub == "check":
    print(json.dumps({"path": path, "recipe": recipe_json("check", name, *(["--verify"] if verify else []))}))
  elif sub == "install":
    no_job_running(path)
    r = recipe_json("check", name)
    problems = [m for m in r["models"] if m.get("source") and not m["source"]["ok"]]
    for m in problems:
      src = m["source"]
      if src["problem"] == "gated":
        var = src["detail"][0] if src["detail"] else "the token"
        fail(m["file"] + " is gated: it needs " + var + ". startdgx never stores a token; put " + var + "=... in ~/.config/startdgx/comfyui.env on the host (then chmod 600 it) and try again")
      fail(m["file"] + " can't be fetched (" + src["problem"] + "); the recipe is out of date")
    bad = [m["file"] for m in r["models"] if m["state"] in ("size", "hash")]
    if bad:
      fail(", ".join(bad) + " on disk doesn't match the recipe; startdgx leaves it alone. Fix it on the host with: dgx-comfyui.sh recipe install " + name + " --force")
    models_dir = os.path.join(path, "data", "models")
    probe = models_dir
    while not os.path.exists(probe):
      probe = os.path.dirname(probe)
    free = os.statvfs(probe).f_bavail * os.statvfs(probe).f_frsize
    if free < r["download_bytes"] + 2**30:
      fail(name + " needs " + str(r["download_bytes"]) + " bytes and " + str(free) + " are free on that disk")
    if not r["download_bytes"] and all(n["installed"] for n in r["nodes"]):
      fail(name + " is already installed")
    print(json.dumps(start_job(path, JOB_RECIPE, path, name)))
elif mode in ("status", "start", "stop", "autostart"):
  path, record = resolve(ARGV[1] if len(ARGV) > 1 and ARGV[1] else "")
  item = inspect(path)
  item.update(managed=True, label=record.get("label", ""), origin=record.get("origin", ""))
  if not item["present"] or item["kind"] != "dgx-comfyui":
    fail(path + " is no longer a dgx-comfyui install; forget it")
  others = sorted(running_roots() - {path})
  if mode != "status":
    no_job_running(path)
  if mode == "status":
    status = None
    if item["json_capable"]:
      r = tool(path, "status", "--json", timeout=60)
      try:
        status = json.loads(r.stdout)
      except ValueError:
        fail("dgx-comfyui.sh status --json gave no JSON: " + say_line(r.stderr or r.stdout))
    print(json.dumps({"install": item, "status": status, "too_old": not item["json_capable"], "running_elsewhere": others, "job": job_state(path)}))
  elif mode == "start":
    if not item["installed"]:
      fail(path + " has no ComfyUI yet; install it first")
    if others:
      fail("ComfyUI in " + others[0] + " is running; stop it first (one at a time on a machine)")
    r = tool(path, "service")
    if r.returncode != 0:
      fail(say_line(r.stderr or r.stdout))
    print(json.dumps({"started": path}))
  elif mode == "stop":
    if path not in running_roots() and not service_active(path):
      print(json.dumps({"stopped": path, "was_running": False}))
    elif not service_active(path):
      fail("ComfyUI in " + path + " was started in a terminal; stop it there (Ctrl+C)")
    else:
      r = tool(path, "stop")
      if r.returncode != 0:
        fail(say_line(r.stderr or r.stdout))
      print(json.dumps({"stopped": path, "was_running": True}))
  else:
    on = ARGV[2] == "on"
    if on:
      if others:
        fail("ComfyUI in " + others[0] + " is running; stop it first (one at a time on a machine)")
      r = tool(path, "service")
    else:
      if unit_root() != path:
        fail("ComfyUI in " + path + " isn't set to start at boot")
      r = tool(path, "service", "--disable")
    if r.returncode != 0:
      fail(say_line(r.stderr or r.stdout))
    print(json.dumps({"autostart": on, "path": path}))
else:
  fail("unknown mode " + mode)
'''.replace("@RECORDS@", COMFYUI_RECORDS).replace("@UNIT@", COMFYUI_UNIT)


def comfyui_run(host, args, *argv):
  """Runs the host script in MODE argv; its one JSON line, parsed."""
  out = ssh_raw(host, f"python3 -I - comfyui {shlex.join(argv)}", stdin=COMFYUI_SCRIPT, timeout=args.timeout, what="comfyui").stdout
  try:
    return json.loads(out.strip().splitlines()[-1])
  except (ValueError, IndexError) as error:
    raise Error(f"{host} gave an answer startdgx can't read") from error


def comfyui_dir(path):
  """A folder as typed, for the host: absolute or ~/..., no control characters."""
  if not path or any(ord(c) < 32 or ord(c) == 127 for c in path) or not (path.startswith("/") or path.startswith("~/")) or ".." in path.split("/"):
    raise Error("Give the folder as an absolute path, or one starting with ~/")
  return path


def comfyui_install_line(item):
  name = item["label"] or item["path"]
  if item["kind"] != "dgx-comfyui":
    return f"{name}  (found, not managed: {item['reason']})"
  state = "managed" if item["managed"] else "found"
  tool = item["tool"]
  where = tool["tag"] or (f"{tool['branch'] or 'detached'} @ {tool['commit']}" if tool["commit"] else "no git checkout")
  notes = [n for n, on in (("edited", tool["dirty"]), ("unpushed commits", tool["unpushed"]), ("too old for startdgx", not item["json_capable"])) if on]
  return f"{name}  ({state}; {where}{'; ' + ', '.join(notes) if notes else ''})" + (f"  {item['path']}" if item["label"] else "")


def comfyui_done(verb, answer, host):
  if verb == "adopt":
    return f"Now managing {answer['adopted']} on {host}; nothing in it was changed"
  return f"Forgot {answer['forgot']} on {host}" + ("; its service was stopped and removed" if answer.get("service_removed") else "") + "; the folder is untouched"


def cmd_comfyui_list(args):
  answer = comfyui_run(target(args.host), args, "discover" if args.verb == "discover" else "list")
  if args.json:
    print(json.dumps(answer))
    return
  for item in answer["installs"]:
    print(comfyui_install_line(item))
  if answer.get("partial"):
    print("The look through the home folder was cut short, so some folders weren't searched. Adopt one you know with: startdgx comfyui adopt")
  if not answer["installs"]:
    print("No ComfyUI installs " + ("found" if args.verb == "discover" else "managed") + f" on {args.host}")


def cmd_comfyui_adopt(args):
  label = args.label or ""
  if label and not COMFYUI_LABEL_RE.match(label):
    raise Error("A label is up to 32 letters, digits, spaces, dots, dashes and underscores")
  answer = comfyui_run(target(args.host), args, "adopt", comfyui_dir(args.dir), label)
  print(json.dumps(answer) if args.json else comfyui_done("adopt", answer, args.host))


def cmd_comfyui_forget(args):
  answer = comfyui_run(target(args.host), args, "forget", comfyui_dir(args.dir), *(["stop-service"] if args.stop_service else []))
  print(json.dumps(answer) if args.json else comfyui_done("forget", answer, args.host))


def comfyui_action(args, mode, *extra):
  return comfyui_run(target(args.host), args, mode, comfyui_which(args.dir), *extra)


def comfyui_which(path):
  """The install named by --dir: a label, or a folder (absolute, or starting with ~/); empty when the host has just one."""
  if not path:
    return ""
  if path.startswith("/") or path.startswith("~/"):
    return comfyui_dir(path)
  if not COMFYUI_LABEL_RE.match(path):
    raise Error("Name an install by its label, or by its folder (absolute, or starting with ~/)")
  return path


def cmd_comfyui_status(args):
  answer = comfyui_action(args, "status")
  answer["update"] = comfyui_update_offer(answer["install"].get("tool", {}).get("tag"))
  # The release startdgx moves an install to: a checkout it won't move (a branch) gets the git commands for it.
  answer["pinned"] = COMFYUI_TAG
  if args.json:
    print(json.dumps(answer))
    return
  cmd_comfyui_status_text(answer)


def cmd_comfyui_status_text(answer):
  print(comfyui_install_line(answer["install"]))
  status = answer["status"]
  if answer["too_old"]:
    print("  too old for startdgx to read its state (no --json): update it on the host")
  elif status:
    print(f"  {status['state']}" + (f" at port {status['port']}" if status["state"] != "stopped" else "") +
          (f", using {status['rss_mib'] / 1024:.1f} GiB" if status.get("rss_mib") else "") +
          f"; ComfyUI {status['comfy']['version'] or 'not installed'}" +
          (f" (newer: {status['comfy']['newer_release']})" if status["comfy"]["newer_release"] else ""))
  if answer["running_elsewhere"]:
    print(f"  ComfyUI in {answer['running_elsewhere'][0]} is running (one at a time on a machine)")
  if answer.get("update"):
    print(f"  dgx-comfyui {answer['update']['from']} -> {answer['update']['to']} is available: startdgx comfyui update")
  if answer.get("job") and answer["job"]["state"] != "none":
    print(f"  install/update job: {answer['job']['state']}")


def cmd_comfyui_action_text(args, answer):
  if "started" in answer:
    print(f"Started ComfyUI in {answer['started']} on {args.host} as a background service")
  elif "stopped" in answer:
    print(f"Stopped ComfyUI in {answer['stopped']} on {args.host}" if answer["was_running"] else f"ComfyUI in {answer['stopped']} wasn't running")
  elif answer["autostart"]:
    print(f"ComfyUI in {answer['path']} runs in the background and starts at boot; it was started now")
  else:
    print(f"ComfyUI in {answer['path']} no longer starts at boot, and was stopped")


def cmd_comfyui_act(args):
  answer = comfyui_action(args, args.verb, *([args.state] if args.verb == "autostart" else []))
  if args.json:
    print(json.dumps(answer))
  else:
    cmd_comfyui_action_text(args, answer)


def comfyui_update_offer(tag):
  """{"from", "to"} when an install's tool tag is an older release than the pin, else None (an untagged or newer checkout is left alone)."""
  old, new = COMFYUI_TAG_RE.match(tag or ""), COMFYUI_TAG_RE.match(COMFYUI_TAG)
  if old and new and tuple(map(int, old.groups())) < tuple(map(int, new.groups())):
    return {"from": tag, "to": COMFYUI_TAG}
  return None


def comfyui_source(args):
  repo, ref = getattr(args, "repo", None) or COMFYUI_REPO, getattr(args, "ref", None) or COMFYUI_TAG
  if not COMFYUI_SOURCE_RE.match(repo) or not COMFYUI_REF_RE.match(ref):
    raise Error("--repo is an https URL or an absolute folder, --ref a tag name")
  return repo, ref


def cmd_comfyui_plan(args):
  answer = comfyui_run(target(args.host), args, "plan", comfyui_dir(args.dir) if args.dir else "")
  if args.json:
    print(json.dumps(answer))
    return
  for place in answer["places"]:
    print(f"{place['mount']}  {size_text(place['free_bytes'])} free")
  if "path" in answer:
    print(f"{answer['path']}: " + ("ok" if not answer["problems"] else ", ".join(answer["problems"])) + f"  ({size_text(answer['free_bytes'])} free)")


def cmd_comfyui_install(args):
  label = args.label or ""
  if label and not COMFYUI_LABEL_RE.match(label):
    raise Error("A label is up to 32 letters, digits, spaces, dots, dashes and underscores")
  repo, ref = comfyui_source(args)
  answer = comfyui_run(target(args.host), args, "install", comfyui_dir(args.dir), label, repo, ref)
  print(json.dumps(answer) if args.json else f"Installing ComfyUI in {answer['path']} on {args.host} ({ref}); it takes about 15 minutes. Follow it: startdgx comfyui job {args.host} --dir {answer['path']}")


def cmd_comfyui_update(args):
  _, ref = comfyui_source(args)
  answer = comfyui_action(args, "update", ref, "comfyui" if args.comfyui else "tool")
  print(json.dumps(answer) if args.json else f"Updating ComfyUI in {answer['path']} on {args.host} to {ref}; follow it: startdgx comfyui job {args.host} --dir {answer['path']}")


def cmd_comfyui_doctor(args):
  answer = comfyui_action(args, "doctor")
  if args.json:
    print(json.dumps(answer))
    return
  cmd_comfyui_doctor_text(answer)


def cmd_comfyui_doctor_text(answer):
  doc = answer["doctor"]
  print(f"{answer['path']}: " + ("healthy" if doc.get("healthy") else f"{doc.get('problems', 0)} problem(s)"))
  marks = {"ok": "ok  ", "bad": "BAD ", "warn": "warn", "info": "info", "did": "did ", "log": ""}
  for item in doc.get("items", []):
    level = item.get("level", "info")
    print("  " + (marks.get(level, level) + " " if marks.get(level, level) else "") + item.get("text", ""))


def cmd_comfyui_job(args):
  answer = comfyui_action(args, "job")
  if args.json:
    print(json.dumps(answer))
    return
  print(f"{answer['state']}" + (f" (exit {answer['exit_status']})" if answer["state"] == "failed" else ""))
  for line in answer["log"]:
    print("  " + line)


def cmd_comfyui_recipe(args):
  extra = ([args.name] if args.name else [""]) + (["verify"] if getattr(args, "verify", False) else [])
  answer = comfyui_action(args, "recipe", args.action, *extra)
  if args.json:
    print(json.dumps(answer))
    return
  cmd_comfyui_recipe_text(args, answer)


def cmd_comfyui_recipe_text(args, answer):
  if args.action == "install":
    print(f"Installing {args.name} on {args.host}: models, nodes and the workflow; follow it: startdgx comfyui job {args.host} --dir {answer['path']}")
  elif args.action == "list":
    for r in answer["recipes"]:
      print(f"{r['name']}  {size_text(r['total_bytes'])}, {r['models']} model(s)" + ("" if r["valid"] else "  INVALID: " + r.get("error", "")))
  else:
    r = answer["recipe"]
    print(f"{args.name}: {r.get('title', '')}")
    for m in r["models"]:
      print(f"  {m.get('state', 'wanted'):8} {m['dest']}/{m['file']}  {size_text(m['size'])}" + (f"  ({m['source']['problem']})" if m.get("source") and not m["source"]["ok"] else ""))
    for n in r["nodes"]:
      print(f"  node     {n['id']}" + ("" if n.get("installed", True) else "  (to install)"))


def cmd_comfyui(args):
  return {"discover": cmd_comfyui_list, "list": cmd_comfyui_list, "adopt": cmd_comfyui_adopt, "forget": cmd_comfyui_forget,
          "plan": cmd_comfyui_plan, "recipe": cmd_comfyui_recipe, "install": cmd_comfyui_install, "update": cmd_comfyui_update, "job": cmd_comfyui_job,
          "status": cmd_comfyui_status, "start": cmd_comfyui_act, "stop": cmd_comfyui_act, "autostart": cmd_comfyui_act, "doctor": cmd_comfyui_doctor}[args.verb](args)


# Fugue's helper (fugue-helper --serve-http) on a host, for Fugue's paired-host stages. startdgx records what it
# created in ~/.local/share/startdgx/fugue-helper.json, a file of its own like comfyui.json (the install manifest says
# the ENGINE was installed by startdgx): the binary, the systemd user unit and the key, each with whether startdgx made
# it, so remove deletes only those. The key (~/.config/fugue/helper.key) never leaves the host except in `provider`'s
# answer, over the ssh session. The host side is one script, run as python3 -I - fugue-helper MODE JSON.
FUGUE_HELPER_BINARY = ".local/lib/fugue/fugue-helper-cuda"
FUGUE_HELPER_KEY = ".config/fugue/helper.key"
FUGUE_HELPER_UNIT = ".config/systemd/user/fugue-helper.service"
FUGUE_HELPER_UPLOAD = f"{STARTDGX_DIR}/fugue-helper.upload"
FUGUE_HELPER_SCRIPT = r'''
import hashlib, ipaddress, json, os, re, shutil, subprocess, sys, tempfile, time
HOME = os.path.expanduser("~")
RECORD, UNIT, BINARY = os.path.join(HOME, "@RECORD@"), os.path.join(HOME, "@UNIT@"), os.path.join(HOME, "@BINARY@")
KEY, STAGE = os.path.join(HOME, "@KEY@"), os.path.join(HOME, "@UPLOAD@")
SERVICE = "fugue-helper.service"
MODELS_RE = re.compile(r"^(~/|/)[A-Za-z0-9_./-]+\Z")
ARGV = sys.argv[2:]
mode = ARGV[0]
opts = json.loads(@OPTS@)
def fail(text):
  try:
    os.unlink(STAGE)
  except OSError:
    pass
  print("Error: " + text, file=sys.stderr)
  sys.exit(1)
def user_env():
  env = dict(os.environ)
  runtime = "/run/user/%d" % os.getuid()
  env.setdefault("XDG_RUNTIME_DIR", runtime)
  env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=" + runtime + "/bus")
  return env
def systemctl(*argv):
  return subprocess.run(["systemctl", "--user", *argv], capture_output=True, text=True, env=user_env())
def load():
  try:
    rec = json.load(open(RECORD))
    if not isinstance(rec, dict):
      raise ValueError("not an object")
    return rec
  except FileNotFoundError:
    return {}
  except (OSError, ValueError):
    if opts.get("lenient"):
      print("  skipped the Fugue helper: " + RECORD + " isn't valid; fix or delete it, then run: startdgx fugue-helper remove", file=sys.stderr)
      sys.exit(0)
    fail(RECORD + " isn't valid JSON; move it aside")
def save(rec):
  os.makedirs(os.path.dirname(RECORD), exist_ok=True)
  tmp = RECORD + ".tmp"
  with open(tmp, "w") as f:
    json.dump(rec, f, indent=2)
    f.write("\n")
  os.replace(tmp, RECORD)
def sha_of(path):
  digest = hashlib.sha256()
  with open(path, "rb") as f:
    for chunk in iter(lambda: f.read(1 << 20), b""):
      digest.update(chunk)
  return digest.hexdigest()
def binary_sha(rec):
  """The binary's sha256: the recorded one while its size and mtime are what they were, else hashed again."""
  try:
    info = os.stat(BINARY)
  except OSError:
    return None
  if rec.get("binary_sha256") and rec.get("binary_size") == info.st_size and rec.get("binary_mtime_ns") == info.st_mtime_ns:
    return rec["binary_sha256"]
  return sha_of(BINARY)
def need_linger():
  user = os.environ.get("USER") or os.path.basename(HOME)
  linger = subprocess.run(["loginctl", "show-user", user, "-p", "Linger", "--value"], capture_output=True, text=True).stdout.strip()
  if linger != "yes":
    fail("The helper has to keep running after the ssh session ends. Run on the host: sudo loginctl enable-linger " + user)
def address(rec):
  return "http://%s:%d" % (rec["listen"], rec["port"]) if rec.get("listen") and rec.get("port") else None
def state(rec):
  have_unit, have_binary = os.path.isfile(UNIT), os.path.isfile(BINARY)
  return {"installed": have_unit and have_binary, "managed": bool(rec), "binary": have_binary, "unit": have_unit,
          "active": systemctl("is-active", "--quiet", SERVICE).returncode == 0,
          "enabled": systemctl("is-enabled", "--quiet", SERVICE).returncode == 0,
          "address": address(rec) if have_unit else None, "port": rec.get("port"), "listen": rec.get("listen"),
          "models": rec.get("models", []), "binary_sha256": binary_sha(rec), "key": os.path.isfile(KEY),
          "created": {"binary": bool(rec.get("created_binary")), "unit": bool(rec.get("created_unit")), "key": bool(rec.get("created_key"))}}
def read_key():
  key = ""
  try:
    fd = os.open(KEY, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd) as f:
      if os.fstat(f.fileno()).st_mode & 0o077:
        fail("the key file " + KEY + " can be read by others; run: chmod 600 " + KEY)
      key = f.readline().strip()
  except OSError:
    key = ""
  if not key:
    fail("There is no key yet (" + KEY + "); run: startdgx fugue-helper install")
  return key
def tailnet_ip():
  try:
    r = subprocess.run(["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=20)
  except (OSError, subprocess.SubprocessError):
    r = None
  line = (r.stdout.split() or [""])[0] if r is not None and r.returncode == 0 else ""
  try:
    return str(ipaddress.IPv4Address(line))
  except ValueError:
    fail("This host has no tailnet IPv4 address (tailscale ip -4 gave none). Bring tailscale up there first: the helper listens only on it")
def models_arg(models):
  out = []
  for path in models:
    if not MODELS_RE.match(path) or ".." in path.split("/"):
      fail("not a usable models folder: " + path)
    out.append("%h" + path[1:] if path.startswith("~") else path)
  return ":".join(out)
def unit_text(listen, port, models):
  exec_start = "%h/@BINARY@ --serve-http --listen " + listen + " --port " + str(port) + " --key-file %h/@KEY@ --models " + models_arg(models)
  return "\n".join(["# Written by startdgx fugue-helper install; startdgx fugue-helper remove deletes it.",
                    "[Unit]", "Description=Fugue helper (stable-diffusion.cpp stages over HTTP)", "After=network-online.target tailscaled.service",
                    "Wants=network-online.target", "", "[Service]", "ExecStart=" + exec_start, "Restart=on-failure", "RestartSec=5", "",
                    "[Install]", "WantedBy=default.target", ""])
def fetch():
  """The file to install, at STAGE: uploaded there already, or downloaded (https only)."""
  if opts.get("url"):
    os.makedirs(os.path.dirname(STAGE), exist_ok=True)
    if not re.fullmatch(r"https://[^@\s\"\\]+", opts["url"]):
      fail("the URL must be https, with no user name or password in it")
    if not opts.get("sha256"):
      fail("a download needs --sha256, the hash of what it should be")
    # The URL goes to curl on stdin (-K -), not in its arguments, which any user on the host can read.
    r = subprocess.run(["curl", "-fsSL", "--proto", "=https", "--proto-redir", "=https", "--max-time", "3000", "-o", STAGE, "-K", "-"],
                       input='url = "' + opts["url"] + '"\n', capture_output=True, text=True)
    if r.returncode != 0:
      fail("downloading " + opts["url"] + " failed: " + ((r.stderr.strip().splitlines() or ["curl failed"])[-1]))
  elif not os.path.isfile(STAGE):
    fail("nothing was uploaded to install")
  if opts.get("sha256") and sha_of(STAGE) != opts["sha256"]:
    fail("the file's sha256 is " + sha_of(STAGE) + ", not the " + opts["sha256"] + " asked for; nothing was installed")
def unpack(dest):
  """Writes the helper binary from STAGE to dest: STAGE is the binary itself, or a .tar.zst or .tar.gz holding it."""
  head = open(STAGE, "rb").read(4)
  if head == b"\x7fELF":
    with open(STAGE, "rb") as src, open(dest, "wb") as out:
      while True:
        chunk = src.read(1 << 20)
        if not chunk:
          break
        out.write(chunk)
    return
  flags = ["--zstd"] if head == b"\x28\xb5\x2f\xfd" else ["-z"] if head[:2] == b"\x1f\x8b" else None
  if flags is None:
    fail("the file is neither the helper binary (ELF) nor a .tar.zst or .tar.gz holding it")
  listing = subprocess.run(["tar", *flags, "--quoting-style=escape", "-tf", STAGE], capture_output=True, text=True)
  if listing.returncode != 0:
    fail("can't read the archive: " + ((listing.stderr.strip().splitlines() or ["tar failed"])[-1]))
  if "\\" in listing.stdout:
    fail("the archive has a member name with a backslash or a newline in it")
  names = [n for n in listing.stdout.splitlines() if os.path.basename(n) == "fugue-helper-cuda" and not n.startswith("/") and ".." not in n.split("/") and not n.endswith("/")]
  if len(names) != 1:
    fail("the archive must hold exactly one file named fugue-helper-cuda")
  with open(dest, "wb") as out:
    r = subprocess.run(["tar", *flags, "--no-wildcards", "-xOf", STAGE, "--", names[0]], stdout=out, stderr=subprocess.PIPE, text=True)
  if r.returncode != 0 or os.path.getsize(dest) == 0:
    fail("can't unpack the archive: " + ((r.stderr.strip().splitlines() or ["tar failed"])[-1]))
  if open(dest, "rb").read(4) != b"\x7fELF":
    fail("fugue-helper-cuda in the archive isn't an executable (ELF)")
def made(path, flag, rec, was_there):
  """Whether startdgx made path: it didn't exist, or an earlier install of ours did."""
  return bool(rec.get(flag)) if was_there and rec else not was_there
def remove_dir_if_empty(path):
  try:
    os.rmdir(path)
    return True
  except OSError:
    return False
if mode == "status":
  print(json.dumps(state(load())))
elif mode == "install":
  rec = load()
  need_linger()
  port, models = opts["port"], opts["models"]
  if not isinstance(port, int) or isinstance(port, bool) or not 1 <= port <= 65535:
    fail("the port must be a number from 1 to 65535")
  models_arg(models)
  listen = tailnet_ip()
  for path, flag in ((BINARY, "created_binary"), (UNIT, "created_unit")):
    if os.path.islink(path) or (os.path.exists(path) and not rec.get(flag)):
      fail(path + " exists and isn't startdgx's; move it aside")
  if os.path.islink(KEY):
    fail(KEY + " is a symlink; move it aside")
  fetch()
  os.makedirs(os.path.dirname(STAGE), exist_ok=True)
  fd, unpacked = tempfile.mkstemp(dir=os.path.dirname(STAGE), prefix=".fugue-helper-unpack-")
  os.close(fd)
  try:
    unpack(unpacked)
    dirs = [os.path.dirname(BINARY), os.path.dirname(KEY)]
    new_dirs = [d for d in dirs if not os.path.isdir(d)]
    created = {"binary": made(BINARY, "created_binary", rec, os.path.exists(BINARY)), "unit": made(UNIT, "created_unit", rec, os.path.exists(UNIT)),
               "key": made(KEY, "created_key", rec, os.path.exists(KEY))}
    made_dirs = sorted(set(new_dirs) | {d for d in rec.get("created_dirs", []) if d in dirs})
    for d in dirs + [os.path.dirname(UNIT)]:
      os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(BINARY), prefix=".fugue-helper-")
    os.close(fd)
    try:
      shutil.copyfile(unpacked, tmp)
      os.chmod(tmp, 0o755)
      os.replace(tmp, BINARY)
    finally:
      if os.path.exists(tmp):
        os.unlink(tmp)
  finally:
    os.unlink(unpacked)
  try:
    os.unlink(STAGE)
  except OSError:
    pass
  key_made = False
  if os.path.exists(KEY):
    if not open(KEY).readline().strip():
      fail("the key file " + KEY + " is empty; delete it and install again")
    os.chmod(KEY, 0o600)
  else:
    import secrets
    fd = os.open(KEY, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
      f.write(secrets.token_hex(32) + "\n")
    key_made = True
  text = unit_text(listen, port, models)
  fd, tmp = tempfile.mkstemp(dir=os.path.dirname(UNIT), prefix=".fugue-helper-")
  with os.fdopen(fd, "w") as f:
    f.write(text)
  os.chmod(tmp, 0o644)
  os.replace(tmp, UNIT)
  info = os.stat(BINARY)
  rec = {"schema": 1, "binary": BINARY, "unit": UNIT, "key": KEY, "listen": listen, "port": port, "models": models,
         "binary_sha256": sha_of(BINARY), "unit_sha256": hashlib.sha256(text.encode()).hexdigest(), "binary_size": info.st_size, "binary_mtime_ns": info.st_mtime_ns,
         "created_binary": created["binary"], "created_unit": created["unit"], "created_key": created["key"], "created_dirs": made_dirs,
         "installed_at": int(time.time())}
  save(rec)
  r = systemctl("daemon-reload")
  if r.returncode != 0:
    fail("systemctl --user daemon-reload failed: " + ((r.stderr.strip().splitlines() or ["no reason given"])[-1]))
  if opts.get("start"):
    for verb in (["enable", SERVICE], ["restart", SERVICE]):
      r = systemctl(*verb)
      if r.returncode != 0:
        fail("systemctl --user " + verb[0] + " failed: " + ((r.stderr.strip().splitlines() or ["no reason given"])[-1]))
  print(json.dumps({**state(rec), "key_created": key_made, "started": bool(opts.get("start"))}))
elif mode in ("on", "off"):
  rec = load()
  if not (os.path.isfile(BINARY) and os.path.isfile(UNIT)):
    fail("the Fugue helper isn't installed here; run: startdgx fugue-helper install")
  if mode == "on":
    need_linger()
    read_key()
    r = systemctl("enable", "--now", SERVICE)
  else:
    r = systemctl("disable", "--now", SERVICE)
  if r.returncode != 0:
    fail("systemctl --user " + ("enable --now" if mode == "on" else "disable --now") + " failed: " + ((r.stderr.strip().splitlines() or ["no reason given"])[-1]))
  if mode == "on":
    time.sleep(0.5)
    if systemctl("is-active", "--quiet", SERVICE).returncode != 0:
      fail("the helper stopped right after starting; see: journalctl --user -u fugue-helper")
  print(json.dumps(state(rec)))
elif mode == "provider":
  rec = load()
  if not (os.path.isfile(UNIT) and address(rec)):
    fail("the Fugue helper isn't installed here; run: startdgx fugue-helper install")
  print(json.dumps({"address": address(rec), "key": read_key()}))
elif mode == "remove":
  rec = load()
  if not rec:
    fail("startdgx didn't install the Fugue helper on this host (no record); nothing was removed")
  removed, kept = [], []
  if os.path.exists(UNIT) or systemctl("is-active", "--quiet", SERVICE).returncode == 0:
    systemctl("disable", "--now", SERVICE)
  for path, flag, name in ((BINARY, "created_binary", "binary"), (UNIT, "created_unit", "unit"), (KEY, "created_key", "key")):
    if not os.path.lexists(path):
      continue
    recorded = rec.get(name + "_sha256")
    if name == "key" and opts.get("keep_key"):
      kept.append({"path": path, "why": "--keep-key"})
    elif rec.get(flag) and recorded and (os.path.islink(path) or sha_of(path) != recorded):
      kept.append({"path": path, "why": "it has changed since startdgx wrote it"})
    elif rec.get(flag):
      os.unlink(path)
      removed.append(path)
    else:
      kept.append({"path": path, "why": "it was there before startdgx installed the helper"})
  for d in rec.get("created_dirs", []) if isinstance(rec.get("created_dirs"), list) else []:
    if d in (os.path.dirname(BINARY), os.path.dirname(KEY)) and remove_dir_if_empty(d):
      removed.append(d)
  systemctl("daemon-reload")
  os.unlink(RECORD)
  print(json.dumps({"removed": removed, "kept": kept}))
else:
  fail("unknown mode " + mode)
'''.replace("@RECORD@", FUGUE_HELPER_RECORD).replace("@UNIT@", FUGUE_HELPER_UNIT).replace("@BINARY@", FUGUE_HELPER_BINARY).replace("@KEY@", FUGUE_HELPER_KEY).replace("@UPLOAD@", FUGUE_HELPER_UPLOAD)


def fugue_helper_script(options):
  """The host script with its options (the download URL among them) in its text: stdin is not on any command line."""
  return FUGUE_HELPER_SCRIPT.replace("@OPTS@", repr(json.dumps(options)))


def fugue_helper_run(host, args, mode, options):
  """Runs the host script in MODE [JSON]; its one JSON line, parsed."""
  out = ssh_raw(host, f"python3 -I - fugue-helper {shlex.join([mode])}", stdin=fugue_helper_script(options), timeout=args.timeout, what="fugue-helper").stdout
  try:
    return json.loads(out.strip().splitlines()[-1])
  except (ValueError, IndexError) as error:
    raise Error(f"{host} gave an answer startdgx can't read") from error


def fugue_helper_options(args):
  """The install's options, checked here (the host checks them again): {source, url, path, sha256, port, models, start}."""
  source = args.source or HELPER_URL
  if not source:
    raise Error("No published fugue-helper build exists yet (Fugue issue #104 will publish one). Pass --from FILE_OR_URL: a built fugue-helper-cuda, or a .tar.zst or .tar.gz holding it")
  sha = (args.sha256 or (HELPER_SHA256 if not args.source else "")).lower()
  if sha and not SHA_RE.match(sha):
    raise Error("--sha256 takes 64 hexadecimal digits")
  port = args.port
  if isinstance(port, bool) or not 1 <= port <= 65535:
    raise Error("--port takes a number from 1 to 65535")
  models = (args.models or FUGUE_HELPER_MODELS).split(":")
  for path in models:
    if not FUGUE_MODELS_RE.match(path) or ".." in path.split("/"):
      raise Error(f"--models takes absolute folders (or ~/...), colon-separated, with only letters, digits and _ . / - in them: {path!r} isn't one")
  options = {"sha256": sha, "port": port, "models": models, "start": bool(args.start)}
  if "://" in source:
    if not source.startswith("https://") or not FUGUE_URL_RE.match(source) or urllib.parse.urlsplit(source).username is not None or "@" in urllib.parse.urlsplit(source).netloc:
      raise Error("--from takes a file on this computer or an https URL (without a user name or password in it)")
    if not sha:
      raise Error("--from a URL needs --sha256, the hash of what it should download")
    return {**options, "url": source}
  path = os.path.abspath(os.path.expanduser(source))
  if not os.path.isfile(path):
    raise Error(f"{source} isn't a file")
  if os.path.getsize(path) > FUGUE_UPLOAD_MAX:
    raise Error(f"{source} is over {FUGUE_UPLOAD_MAX >> 20} MiB: put it where the host can download it and pass its https URL")
  return {**options, "path": path}


def fugue_helper_status_text(answer, host):
  if not answer["installed"]:
    print(f"The Fugue helper isn't installed on {host}" + (" (the binary or the unit is missing)" if answer["managed"] else ""))
    return
  state = "running" if answer["active"] else "stopped"
  print(f"The Fugue helper on {host}: {state}, {'starts at boot' if answer['enabled'] else 'does not start at boot'}")
  print(f"  address  {answer['address']}")
  print(f"  binary   sha256 {answer['binary_sha256']}")
  print(f"  key      {'present' if answer['key'] else 'missing'} (shown only by: startdgx fugue-helper provider {host} --json)")


def cmd_fugue_helper(args):
  if args.verb == "provider" and not args.json:
    raise Error("provider prints the helper's key, a secret: ask with --json, and keep what it prints private")
  host = target(args.host)
  if args.verb == "install":
    options = fugue_helper_options(args)
    path = options.pop("path", None)
    if path:
      with open(path, "rb") as f:
        payload = base64.b64encode(f.read()).decode()
      ssh_raw(host, f"umask 077; mkdir -p ~/{STARTDGX_DIR} && base64 -d > ~/{FUGUE_HELPER_UPLOAD}", stdin=payload + "\n", timeout=args.timeout, what="upload")
    answer = fugue_helper_run(host, args, "install", options)
  elif args.verb == "remove":
    answer = fugue_helper_run(host, args, "remove", {"keep_key": args.keep_key})
  else:
    answer = fugue_helper_run(host, args, args.verb, {})
  fugue_helper_print(args, host, answer)


def fugue_helper_print(args, host, answer):
  """The answer as JSON, or as the lines a person reads; the key is in provider's answer only (with the name of the machine)."""
  if args.verb == "provider":
    print(json.dumps({"name": host.rsplit("@", 1)[-1], "type": "fugue-helper", "address": answer["address"], "key": answer["key"]}))
  elif args.json:
    print(json.dumps(answer))
  elif args.verb == "status":
    fugue_helper_status_text(answer, host)
  elif args.verb == "install":
    print(f"Fugue helper installed on {host}: {answer['address']}" + (" (new key made)" if answer["key_created"] else " (key kept)"))
    print(f"  binary sha256 {answer['binary_sha256']}")
    print("  running now" if answer["started"] else f"  not started: startdgx fugue-helper on {host}")
  elif args.verb == "remove":
    for path in answer["removed"]:
      print(f"  removed {path}")
    for item in answer["kept"]:
      print(f"  kept {item['path']} ({item['why']})")
    print(f"The Fugue helper is removed from {host}")
  else:
    print(f"The Fugue helper on {host} is {'on' if args.verb == 'on' else 'off'}" + (f": {answer['address']}" if args.verb == "on" else ""))


def build_parser():
  p = argparse.ArgumentParser(prog="startdgx", description=__doc__)
  sub = p.add_subparsers(dest="command", required=True)

  def add(name, fn, model=False, optional_model=False, timeout=60, description=None, timeout_help="%(default)s"):
    s = sub.add_parser(name, description=description)
    if name not in ("hosts", "engine"):
      s.add_argument("host")
    if model:
      s.add_argument("model")
    if optional_model:
      s.add_argument("model", nargs="?")
    s.add_argument("--timeout", type=int, default=timeout, help=f"seconds to wait for the host (default: {timeout_help})")
    s.set_defaults(fn=fn)
    return s

  st = add("storage", cmd_storage, description="The disks on HOST that could keep its model weights, and the model store in use. "
           "--set makes a folder on one of them the store; --unset forgets it (refused while models are linked into it).")
  st.add_argument("--json", action="store_true", help="as {store, disks, models}; a model's location is nvme, usb, both, usb-missing or mixed")
  stm = st.add_mutually_exclusive_group()
  stm.add_argument("--set", metavar="PATH", help="use PATH, a folder on an external disk, as the model store")
  stm.add_argument("--unset", action="store_true", help="stop using a model store")
  mv = add("move", cmd_move, model=True, timeout=3600, description="Move a stopped model's weights between the host's internal disk and its model store (see storage). "
           "--to usb copies them to the store, checks them and links the model's folder to the copy; the internal copy is then deleted. --to nvme copies them back and keeps the store's copy.")
  mv.add_argument("--to", required=True, choices=("usb", "nvme"), help="usb: the model store; nvme: back to the internal disk")
  de = sub.add_parser("destination", description="Where a model's files should end up: nvme (the internal disk, the default) or usb (the host's model store). "
                      "Kept on this computer and read by the panel, which moves the model to the store when its setup finishes. With no model, lists the host's choices.")
  de.add_argument("host")
  de.add_argument("model", nargs="?")
  de.add_argument("--to", choices=("usb", "nvme"), help="record the choice for MODEL")
  de.add_argument("--json", action="store_true")
  de.set_defaults(fn=cmd_destination)
  e = sub.add_parser("engine"); e.add_argument("--json", action="store_true"); e.set_defaults(fn=cmd_engine)
  su = sub.add_parser("self-update", description="Update this plugin from its repository (what `omarchy plugin update` does for it): fast-forward its folder to the "
                      "repository's HEAD and validate it. --check only says whether there is something newer. --restart then restarts the Omarchy shell, which loads the new files.")
  su.add_argument("--check", action="store_true", help="only look: change nothing")
  su.add_argument("--restart", action="store_true", help="after an update, restart the Omarchy shell a moment later")
  su.add_argument("--json", action="store_true", help="as {managed, why, commit, subject, behind, changes, dirty, updated, restarting}")
  su.set_defaults(fn=cmd_self_update)
  add("add", cmd_add)
  i = add("install", cmd_install, timeout=3600)
  i.add_argument("--dry-run", action="store_true", help="print what would change and change nothing")
  i.add_argument("--engine-path", metavar="DIR", help=f"copy this engine checkout instead of cloning {ENGINE_TAG}")
  i.add_argument("--replace-engine", action="store_true",
                 help=f"replace an engine startdgx didn't install, backing it up to ~/{ENGINE_BACKUP} for uninstall to put back")
  u = add("uninstall", cmd_uninstall, timeout=3600,
          description="Reverse startdgx install from its manifest on the host. The model weights are kept by default "
                      "(--delete-models deletes them). Afterwards, run omarchy models forget on each Omarchy machine "
                      "paired with the host; its ~/.ssh/authorized_keys entries are left for you to remove.")
  u.add_argument("--dry-run", action="store_true", help="print what would change and change nothing")
  u.add_argument("--delete-models", action="store_true", help="also delete the downloaded model weights (kept by default)")
  u.add_argument("--remove-packages", action="store_true", help="also remove the packages the install added")
  u.add_argument("--delete-recipes", action="store_true", help="also delete the recipes you added (kept by default)")
  u.add_argument("--json", action="store_true", help="with --dry-run: as {host, steps, kept, manual, models_bytes, packages, recipes}")
  d = sub.add_parser("discover", description="List the tailnet's online Linux machines and probe each over ssh, read-only, "
                     "for a DGX Spark. Installs nothing and adds nothing; it saves the host key of a machine ssh has never seen "
                     "(StrictHostKeyChecking=accept-new).")
  d.add_argument("--json", action="store_true")
  d.add_argument("--user", help="the ssh user on the peers (default: this machine's user)")
  d.add_argument("--timeout", type=int, default=20, help="seconds to wait for each peer")
  d.add_argument("--limit", type=int, default=60, help="seconds the whole discover may take; a peer not heard from by then is unreachable")
  d.set_defaults(fn=cmd_discover)
  add("forget", cmd_remove_host)
  h = sub.add_parser("hosts"); h.add_argument("--json", action="store_true"); h.set_defaults(fn=cmd_hosts)
  add("status", cmd_status)
  add("list", cmd_list)
  # start returns once the model has loaded, which can take minutes.
  add("start", cmd_start, model=True, timeout=600)
  add("stop", cmd_stop, optional_model=True)
  sh = add("share", cmd_share, model=True, timeout=120, description="Share a model with the other machines on the host's tailnet "
           "(the engine publishes it with tailscale serve), or stop with --off.")
  sh.add_argument("--off", action="store_true", help="stop sharing it")
  us = add("use", cmd_use, model=True, timeout=None, timeout_help="3600, or 120 with --detach")
  us.add_argument("--ctx", type=int, help="a context size the recipe has measured (startdgx variants lists them)")
  us.add_argument("--yes", action="store_true", help="confirm setting up a recipe of your own (it downloads and runs what you wrote)")
  us.add_argument("--detach", action="store_true", help="set the model up in the background and return; status shows its progress")
  add("update", cmd_update, model=True, timeout=120, description="Update a model that is set up to the catalog's runtime, weights and settings, in the background "
      "(status shows its progress; the model keeps running until the new setup has started).")
  va = add("variants", cmd_variants, model=True, description="List the context sizes a recipe has measured on the host, with the memory each needs.")
  va.add_argument("--json", action="store_true", help="as [{ctx, peak_ram_gib, peak_gpu_gib}]")
  rp = sub.add_parser("recipe", description="Your own recipes on a host: validate or add a .toml from this computer (the engine's "
                      "errors, one per line), list the host's recipes, or remove one of yours.")
  rv = rp.add_subparsers(dest="verb", required=True, metavar="validate|add|list|remove|measure|confirm|context|fix|draft|author")
  for verb in ("validate", "add", "list", "remove", "measure", "confirm", "context"):
    r = rv.add_parser(verb)
    r.add_argument("host")
    if verb in ("validate", "add"):
      r.add_argument("file", help="a recipe file on this computer; its name without .toml is the recipe's id")
      r.add_argument("--json", action="store_true", help="as {ok, id, errors, message}; a rejection is an answer, so it exits 0")
    if verb == "list":
      r.add_argument("--json", action="store_true")
    if verb in ("remove", "measure", "confirm", "context"):
      r.add_argument("id")
    if verb == "context":
      r.add_argument("--ctx", type=int, required=True, help="the context size to add, in tokens (65536 for 64K); it starts drafted")
      r.add_argument("--remove", action="store_true", help="take that context size away instead (a recipe keeps at least one)")
    if verb == "measure":
      r.add_argument("--ctx", type=int, required=True, help="the context of the variant to measure")
      r.add_argument("--yes", action="store_true", help="download and load it, bench it and record the result; without this nothing changes")
    r.add_argument("--timeout", type=int, default=None if verb == "measure" else 60,
                   help="seconds to wait for the host (default: 60; measure --yes 3600)")
    r.set_defaults(fn=cmd_recipe)
  rf = rv.add_parser("fix", description="Copy a recipe of yours from HOST and open a terminal running the agent (agent_command in "
                     "~/.config/startdgx/config.json) with the authoring brief, to find what is wrong with it and put the fixed one back.")
  rf.add_argument("host")
  rf.add_argument("id")
  rf.add_argument("--here", action="store_true", help="run the agent in this terminal instead of opening one")
  rf.set_defaults(fn=cmd_recipe)
  rd = rv.add_parser("draft", description="Write a user recipe for a Hugging Face repo that passes the Find checks (hf search), from this "
                     "computer, with no model: its pinned commit, license and one drafted variant whose placeholder numbers equal the weights' size.")
  rd.add_argument("repo", help="OWNER/NAME")
  rd.add_argument("--id", help="the recipe id (default: the repo name slugified, owner dropped, plus -tensorfold)")
  rd.add_argument("--out", help="the folder to write ID.toml in (default: ~/.local/state/startdgx/drafts)")
  rd.add_argument("--host", help="also refuse an id this machine's recipes (curated or yours) already have")
  rd.add_argument("--estimated", dest="size_estimate", action="store_true", help="write the variant as estimated (weights x 1.2 + 2 GiB, a guess) so the person's add can confirm it, instead of a draft that has to be measured")
  rd.add_argument("--json", action="store_true", help="as {ok, id, repo, path, revision, license, weights_bytes, placeholder_gib, source, warnings}")
  rd.set_defaults(fn=cmd_recipe)
  ra = rv.add_parser("author", description="Draft a recipe for a Hugging Face repo on HOST (as recipe draft), then open a terminal running the "
                     "agent (agent_command in ~/.config/startdgx/config.json, default claude) with the authoring brief, when the draft needs "
                     "judgement (a drafter, rope scaling, server arguments the template cannot set) or with --agent.")
  ra.add_argument("host")
  ra.add_argument("repo", help="OWNER/NAME")
  ra.add_argument("--id", help="the recipe id (default: the repo name slugified, owner dropped, plus -tensorfold)")
  ra.add_argument("--out", help="the folder to write ID.toml in (default: ~/.local/state/startdgx/drafts)")
  ra.add_argument("--agent", action="store_true", help="start the agent even when the draft needs no judgement")
  ra.add_argument("--here", action="store_true", help="run the agent in this terminal instead of opening one")
  ra.add_argument("--json", action="store_true", help="as recipe draft --json plus agent: whether an agent starts")
  ra.set_defaults(fn=cmd_recipe)
  de = add("delete", cmd_delete, model=True)
  de.add_argument("--dry-run", action="store_true", help="print what removing it would free and change nothing")
  de.add_argument("--json", action="store_true", help="with --dry-run: as {recipe, setting_up, bytes}")
  add("logs", passthrough("logs"), optional_model=True, description="Show a model's last error and logs (default: the last one started).")
  cp = sub.add_parser("comfyui", description="ComfyUI installs (dgx-comfyui) on a host: find existing ones and adopt them under startdgx, "
                      "list the ones it manages, or forget one. startdgx never changes or deletes an install's folder.")
  cv = cp.add_subparsers(dest="verb", required=True, metavar="discover|list|adopt|forget|status|start|stop|autostart|plan|install|update|job|doctor|recipe")
  for verb in ("discover", "list", "adopt", "forget", "status", "start", "stop", "autostart", "plan", "install", "update", "job", "doctor"):
    c = cv.add_parser(verb, description={"discover": "Read-only: the installs on HOST (the service's, a running one, the ones startdgx manages and a bounded search of the home folder). A ComfyUI that dgx-comfyui didn't install is listed as not managed.",
                                          "list": "The installs startdgx manages on HOST.",
                                          "adopt": "Manage an existing dgx-comfyui install in DIR: only startdgx's own record is written.",
                                          "forget": "Stop managing the install in DIR. The folder is not touched.",
                                          "status": "One managed install's state, from its own dgx-comfyui.sh status --json.",
                                          "start": "Run the install as a background service (dgx-comfyui.sh service); it restarts after a crash and starts at boot. Refused while another install on HOST runs.",
                                          "stop": "Stop the install's service. A ComfyUI started in a terminal is refused: stop it there.",
                                          "autostart": "on: run it as a background service and start it now (as start). off: remove the service, which stops it and ends starting at boot.",
                                          "plan": "Read-only: the host's disks with their free space and, with --dir, whether DIR can take an install (absent or empty, writable, 40 GiB free).",
                                          "install": "Install ComfyUI in DIR (which must be absent or empty): clone dgx-comfyui at the pinned release and run its install, as a background job that outlives this ssh session (about 15 minutes). Follow it with job.",
                                          "update": "Move the install's dgx-comfyui to the pinned release and run its install, as a job. Refused for a checkout with uncommitted or unpushed work. --comfyui also moves ComfyUI to its newest release.",
                                          "job": "The install or update job of an install: running, succeeded or failed, and the end of its log.",
                                          "doctor": "Read-only: the install's own dgx-comfyui.sh doctor --json, a health report of every part that changes nothing."}[verb])
    c.add_argument("host")
    if verb in ("adopt", "forget"):
      c.add_argument("--dir", required=True, metavar="DIR", help="the install's folder on the host (absolute, or starting with ~/)")
    if verb in ("status", "start", "stop", "autostart", "update", "job", "doctor"):
      c.add_argument("--dir", metavar="LABEL|DIR", help="which install: its label, or its folder; optional when HOST has just one managed")
    if verb in ("plan",):
      c.add_argument("--dir", metavar="DIR", help="a folder to check for an install")
    if verb == "install":
      c.add_argument("--dir", required=True, metavar="DIR", help="the folder to install in (absolute, or starting with ~/); it is created")
      c.add_argument("--label", help="a short name for it in the panel")
    if verb in ("install", "update"):
      c.add_argument("--repo", help=f"clone from this https URL or folder instead of {COMFYUI_REPO}")
      c.add_argument("--ref", help=f"this tag instead of {COMFYUI_TAG}")
    if verb == "update":
      c.add_argument("--comfyui", action="store_true", help="also move ComfyUI itself to its newest release (dgx-comfyui.sh update)")
    if verb == "autostart":
      c.add_argument("state", choices=("on", "off"))
    if verb == "adopt":
      c.add_argument("--label", help="a short name for it in the panel")
    if verb == "forget":
      c.add_argument("--stop-service", action="store_true", help="also stop and remove its background service (dgx-comfyui.sh service --disable)")
    c.add_argument("--json", action="store_true")
    c.add_argument("--timeout", type=int, default=60, help="seconds to wait for the host (default: 60)")
    c.set_defaults(fn=cmd_comfyui)
  cr = cv.add_parser("recipe", description="ComfyUI workflows: a recipe is a workflow with its custom nodes and every model (destination, size, sha256). "
                     "list and show are read-only; check also asks each missing file's source; install downloads what is missing and installs the nodes, as a job.")
  cr.add_argument("action", choices=("list", "show", "check", "install"))
  cr.add_argument("host")
  cr.add_argument("name", nargs="?", help="the recipe (not for list)")
  cr.add_argument("--dir", metavar="LABEL|DIR", help="which install: its label, or its folder; optional when HOST has just one managed")
  cr.add_argument("--verify", action="store_true", help="with check: also hash every file on disk")
  cr.add_argument("--json", action="store_true")
  cr.add_argument("--timeout", type=int, default=300, help="seconds to wait for the host (default: 300)")
  cr.set_defaults(fn=cmd_comfyui, verb="recipe")
  fp = sub.add_parser("fugue-helper", description="Fugue's helper (fugue-helper --serve-http) on a host, for Fugue's paired-host stages: install it, switch it on and off, "
                      "and print the providers.json entry Fugue needs. The key stays on the host; only provider shows it.")
  fv = fp.add_subparsers(dest="verb", required=True, metavar="status|install|on|off|provider|remove")
  for verb in ("status", "install", "on", "off", "provider", "remove"):
    f = fv.add_parser(verb, description={"status": "Whether the helper is installed, running and set to start at boot, its address, the binary's sha256 and whether a key exists. Never prints the key.",
                                         "install": "Install the helper binary and its systemd user unit, and make a key if there is none (an existing key is kept). Needs the account to linger. Does not start it unless --start; re-running updates the binary and unit.",
                                         "on": "Start the helper and have it start at boot (systemctl --user enable --now).",
                                         "off": "Stop the helper and stop it starting at boot (systemctl --user disable --now).",
                                         "provider": "Print Fugue's providers.json entry for this host as JSON, with the key: a secret, shown only here, over the ssh session. Needs --json.",
                                         "remove": "Stop and disable the helper and delete what install created (the binary, the unit and the key), nothing else."}[verb])
    f.add_argument("host")
    if verb == "install":
      f.add_argument("--from", dest="source", metavar="FILE_OR_URL", help="the helper: a built fugue-helper-cuda, or a .tar.zst or .tar.gz holding it; a file here is sent to the host, an https URL is downloaded on it")
      f.add_argument("--sha256", metavar="HEX", help="check the file (as given, an archive too) against this before installing")
      f.add_argument("--port", type=int, default=FUGUE_HELPER_PORT, help="the port it listens on, on the tailnet address (default: %(default)s)")
      f.add_argument("--models", metavar="DIR[:DIR]", help=f"folders it may read models from, colon-separated, absolute or ~/ (default: {FUGUE_HELPER_MODELS})")
      f.add_argument("--start", action="store_true", help="also start it and have it start at boot")
    if verb == "remove":
      f.add_argument("--keep-key", action="store_true", help="keep the key file")
    f.add_argument("--json", action="store_true")
    f.add_argument("--timeout", type=int, default=1800 if verb == "install" else 60, help="seconds to wait for the host (default: %(default)s)")
    f.set_defaults(fn=cmd_fugue_helper)
  hp = sub.add_parser("hf", description="Hugging Face, read-only, from this computer: search the MLX affine 4-bit repos of known families.")
  hv = hp.add_subparsers(dest="verb", required=True, metavar="search")
  hs = hv.add_parser("search", description="List the top 50 mlx repos for QUERY that are affine 4-bit by their config.json, of a "
                     "known family (known-families.json) and not gated. Memory is shown as facts only, never a fit.")
  hs.add_argument("query")
  hs.add_argument("--json", action="store_true", help="as [{repo, params, size_bytes, license, base_model, label}]")
  hs.set_defaults(fn=cmd_hf_search)
  tp = sub.add_parser("tensorfold", description="TensorFold's recipe list (tensorfold.dev), read-only, from this computer: what it has for one DGX Spark, "
                      "and a drafted recipe from an entry. Its memory figures are estimates, so a draft never counts as fitting until measured.")
  tv = tp.add_subparsers(dest="verb", required=True, metavar="list|draft")
  tl = tv.add_parser("list", description="The recipes tensorfold.dev lists for one DGX Spark (128 GB), with what is new or changed since the look saved last.")
  tl.add_argument("--host", help="mark entries this machine was given from the list that the list has since moved on from")
  tl.add_argument("--update", action="store_true", help="save this look, so the next run says what changed since")
  tl.add_argument("--json", action="store_true", help='as {device, first_look, recipes: [{id, name, format, estimate_gb, weight_gb, repo, revision, recipe_id, settings, url, draftable, reason, status, added, outdated}]}')
  tl.set_defaults(fn=cmd_tensorfold_list)
  td = tv.add_parser("draft", description="Write a user recipe from an entry of the list: its pinned checkpoint, license and one drafted variant "
                     "whose memory is the list's estimate (never a fit until measured). Only MLX 4-bit entries can be drafted.")
  td.add_argument("entry", help="the entry's id, from `tensorfold list`")
  td.add_argument("--context", type=int, help="the context in tokens, one the entry offers (default: 8192)")
  td.add_argument("--parallel", type=int, help="requests at once, one the entry offers (default: the entry's)")
  td.add_argument("--input", choices=TF_INPUTS, help="text, or images (video too) with the vision tower, as the entry offers")
  td.add_argument("--estimated", action="store_true", help="write the list's memory estimate as an estimated variant (confirm it with `recipe confirm`), not a drafted one that must be measured; an entry with no estimate stays drafted")
  td.add_argument("--replace", action="store_true", help="with --host: replace a recipe of yours even if it was measured (an update; the measurement is discarded)")
  td.add_argument("--id", help="the recipe id (default: the repo's)")
  td.add_argument("--host", help="have this machine's engine validate it and refuse an id it already has")
  td.add_argument("--out", help="the folder to write it to")
  td.add_argument("--json", action="store_true", help="as recipe draft --json")
  td.set_defaults(fn=cmd_tensorfold_draft)
  la = sub.add_parser("launch", description="Open a floating terminal running startdgx install HOST, uninstall HOST, "
                      "logs HOST [MODEL] or author HOST REPO (recipe author --agent --here), for the panel: sudo there can ask for a password.")
  la.add_argument("verb", metavar="install|uninstall|logs|author")
  la.add_argument("host")
  la.add_argument("model", nargs="?")
  la.add_argument("--replace-engine", action="store_true", help="with install: replace an engine startdgx didn't install")
  la.add_argument("--delete-models", action="store_true", help="with uninstall: also delete the model weights")
  la.add_argument("--remove-packages", action="store_true", help="with uninstall: also remove the packages the install added")
  la.add_argument("--delete-recipes", action="store_true", help="with uninstall: also delete the recipes you added")
  la.set_defaults(fn=cmd_launch)
  return p


def main(argv):
  global DEMO
  args = build_parser().parse_args(argv)
  for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(signum, stop_children)
  try:
    if demo_enabled():
      DEMO = True
      wall()
      with demo_state():
        pass
      args.fn = DEMO_COMMANDS.get(args.command, args.fn)
    return args.fn(args) or 0
  except Error as error:
    # An error can quote a host (rsync's or git's stderr, a tailnet name): its controls go too.
    print(f"Error: {clean(str(error))}", file=sys.stderr)
    return 1


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
