# What the link was called before the engine's v0.9.0 (omarchy models became omarchy models): a machine set up
# then has it in its manifest, and uninstall takes it away as it does the current one.
LEGACY_AGENT_LINK = "/usr/local/bin/omarchy-agent-local"
