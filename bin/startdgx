import subprocess
import sys
import tempfile
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request

ENGINE = "~/.local/share/omarchy-local-ai/omarchy-local-ai"
ENGINE_REPO = "https://github.com/bmaltais/omarchy-local-ai"
ENGINE_TAG = "v0.6.4-dgx.3"
SERVE_ENABLE_URL = "https://login.tailscale.com/f/serve"
# No colon, which rsync would read in its destination as host:path, or as a daemon in host::module.
TARGET_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.@-]*$")
# What the CLI accepts as a recipe id in an argument it sends to the engine (a model's, a recipe's): permissive, only
# keeping shell characters out. The engine decides what really exists. RID_RE (below) is stricter: the engine's own ID_RE,
# which a user recipe's id (its file name without .toml) must match.
RECIPE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
USER_RE = re.compile(r"^[a-z_][a-z0-9_.-]*$")
HOME_RE = re.compile(r"^/[A-Za-z0-9_./-]+$")
# Keepalives: a host that went away (asleep, off the tailnet) is noticed in 45 s, not when TCP gives up.
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"]
# Discover's probes take the host key of a machine ssh has never seen (accept-new), and only discover's: the peers are
# the tailnet's own, which the user chose to list, and a never-seen Spark would otherwise be unreachable and get no
# Install. A key that changed is still refused. The key it saves is what add and install then check against.
DISCOVER_SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new"]
DISCOVER_WORKERS = 8

# What the engine's host setup (HOST_SETUP + MACHINE_SETUP_TAIL in its agent_local.py) may create or change as root.
ROOT_FILES = (
  "/etc/security/limits.d/99-rdma-memlock.conf",
  "/etc/systemd/user.conf.d/99-rdma-memlock.conf",
  "/usr/local/sbin/nvidia-cdi-podman-compat",
  "/etc/systemd/system/nvidia-cdi-refresh.service.d/podman-compat.conf",
  "/etc/cdi/nvidia.yaml",
)
PACKAGES = ("podman", "rsync", "python3")
AGENT_LINK = "/usr/local/bin/omarchy-agent-local"
ENGINE_DIR = ".local/share/omarchy-local-ai"
STARTDGX_DIR = ".local/share/startdgx"
MANIFEST = f"~/{STARTDGX_DIR}/manifest.json"
BACKUP_DIR = f"{STARTDGX_DIR}/backup"


def backup_name(path):
  return path.strip("/").replace("/", "_")


# The root files the setup may overwrite or create, any of which may predate it (NVIDIA's docs have users generate
# /etc/cdi/nvidia.yaml; a plain file may sit where the agent link goes, while a symlink there is only recorded):
# copied as the user before it runs, keeping an earlier copy.
BACKUPS = {**{("file", path): backup_name(path) for path in ROOT_FILES}, ("symlink", AGENT_LINK): backup_name(AGENT_LINK)}
BACKUP = f"set -eu\nmkdir -p ~/{BACKUP_DIR}\ncd ~/{BACKUP_DIR}\n" + "".join(
  f"if [ -f {path} ]{' && [ ! -L ' + path + ' ]' if kind == 'symlink' else ''} && [ ! -e {name} ]; then cp -p {path} {name}; fi\n"
  for (kind, path), name in BACKUPS.items())
# An engine that predates the install, which --replace-engine replaces.
ENGINE_BACKUP = f"{BACKUP_DIR}/engine"
BACKUP_ENGINE = f"if [ -d ~/{ENGINE_DIR} ] && [ ! -e ~/{ENGINE_BACKUP} ]; then cp -a ~/{ENGINE_DIR} ~/{ENGINE_BACKUP}; fi\n"

# What the engine creates under the user's home once installed (its use and share), relative to it.
ENGINE_STATE = ".local/state/omarchy/agent-local"
ENGINE_CONFIG = ".config/omarchy/agent-local"
ENGINE_DATA = ".local/share/omarchy/agent-local"
# The user's recipes (and what they confirmed) live in the engine's state dir, which uninstall deletes: they are kept
# unless --delete-recipes, and the install manifest never records them (startdgx creates none).
ENGINE_RECIPES = f"{ENGINE_STATE}/recipes"
QUADLET_DIR = ".config/containers/systemd"
SHARE_UNIT = ".config/systemd/user/omarchy-agent-local-share.service"
SHARED_PARENTS = (".local/share/omarchy", ".local/state/omarchy", ".config/omarchy", QUADLET_DIR)
UNINSTALL_IMAGES = f"{STARTDGX_DIR}/uninstall-images"
NETWORK = "omarchy-agent-local"
SECRET = "omarchy-agent-local-key"
QUADLET_HEADER = "# Generated by omarchy-agent-local use"
RDMA_HEADER = "RDMA between paired DGX Sparks"
COMPAT_HEADER = "Written by omarchy-local-ai"
# The engine's ID_RE (what an id is, here the file name of a user recipe without .toml; see RECIPE_RE) and IMAGE_RE.
RID_RE = re.compile(r"^[a-z0-9]+([.-][a-z0-9]+)*$")
IMAGE_RE = re.compile(r"^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+@sha256:[0-9a-f]{64}$")
QUADLET_RE = re.compile(r"^omarchy-agent-local(-model-[a-z0-9]+([.-][a-z0-9]+)*\.container|\.network)$")
SERVE_PATH_RE = re.compile(r"^/local-ai(/[A-Za-z0-9._-]+)*$")
SHA_RE = re.compile(r"^[0-9a-f]{64}$")

# Read-only, for uninstall: what the engine made under the user's home. Model quadlets carry the engine's header;
# its network quadlet has none, so it's known by its name and network. JSON comes back base64'd, to parse here.
USER_PROBE = 'echo "user=$(id -un)"\necho "home=$HOME"\n'
UNINSTALL_PROBE = USER_PROBE + f'''
q=$HOME/{QUADLET_DIR}
for f in "$q"/omarchy-agent-local-model-*.container; do
  if [ -f "$f" ] && head -1 "$f" | grep -qF '{QUADLET_HEADER}'; then echo "quadlet=${{f##*/}}"; sed -n 's/^Image=/image=/p' "$f"; fi
done
if grep -qsx 'NetworkName={NETWORK}' "$q/{NETWORK}.network"; then echo quadlet={NETWORK}.network; fi
if [ -f ~/{UNINSTALL_IMAGES} ]; then sed 's/^/image=/' ~/{UNINSTALL_IMAGES}; fi
if [ -f ~/{ENGINE_CONFIG}/shares.json ]; then echo "shares=$(base64 -w0 <~/{ENGINE_CONFIG}/shares.json)"; fi
if command -v tailscale >/dev/null; then
  if serve=$(tailscale serve status --json 2>/dev/null); then echo "serve=$(printf '%s' "$serve" | base64 -w0)"; else echo serve=error; fi
fi
if command -v podman >/dev/null; then
  echo podman=yes
  if podman network exists {NETWORK}; then echo network=yes; fi
  if podman secret inspect {SECRET} >/dev/null 2>&1; then echo secret=yes; fi
fi
for path in {ENGINE_DIR} {ENGINE_STATE} {ENGINE_CONFIG} {ENGINE_DATA} {SHARE_UNIT}; do
  if [ -e "$HOME/$path" ]; then echo "exists=$path"; fi
done
if [ -d ~/{ENGINE_DATA} ]; then echo "models_bytes=$(du -sb ~/{ENGINE_DATA} | cut -f1)"; fi
if [ -d ~/{ENGINE_RECIPES} ]; then echo "recipes=$(ls ~/{ENGINE_RECIPES}/*.toml 2>/dev/null | wc -l | tr -d ' ')"; fi
exit 0
'''

# Read-only, for delete --dry-run: what the engine's remove of the recipe (argv[1]) would free, as its _remove_files
# counts it: each blob that no other model's files link and that nothing else holds, and for a setup in progress the
# half-downloaded files its record lists. Prints {"set_up", "setting_up", "bytes"}.
REMOVE_PROBE = f'''
import json, os, re, sys
rid, home = sys.argv[1], os.path.expanduser("~")
data, state = os.path.join(home, "{ENGINE_DATA}"), os.path.join(home, "{ENGINE_STATE}")
def stats(top):
  for directory, _, names in os.walk(top):
    for name in names:
      try:
        yield os.stat(os.path.join(directory, name))
      except OSError:
        pass
mine, others = {{}}, set()
models = os.path.join(data, "models")
for entry in sorted(os.listdir(models)) if os.path.isdir(models) else []:
  for info in stats(os.path.join(models, entry)):
    key = (info.st_dev, info.st_ino)
    if entry == rid:
      mine[key] = mine.get(key, 0) + 1
    else:
      others.add(key)
freed = 0
for info in stats(os.path.join(data, "blobs")):
  key = (info.st_dev, info.st_ino)
  if key not in others and info.st_nlink - mine.get(key, 0) == 1:
    freed += info.st_size
set_up = os.path.exists(os.path.join(state, "models", rid + ".json"))
try:
  with open(os.path.join(state, "installing", rid + ".json")) as handle:
    record = json.load(handle)
except (OSError, ValueError):
  record = None
setting_up = not set_up and isinstance(record, dict)
for name in (record.get("partials") or []) if setting_up else []:
  if isinstance(name, str) and re.fullmatch(r"[0-9a-f]{{40}}|[0-9a-f]{{64}}", name.removesuffix(".part")):
    path = os.path.join(data, "staging", name)
    if os.path.isfile(path):
      freed += os.path.getsize(path)
print(json.dumps({{"set_up": set_up, "setting_up": setting_up, "bytes": freed}}))
'''

# Read-only: prints key=value lines about the host. Bash, since python3 may be one of the missing tools.
PROBE = USER_PROBE + r'''
echo "gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)"
echo "dgx_name=$(sed -n 's/^DGX_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/dgx-release 2>/dev/null | head -1)"
for tool in @PACKAGES@; do
  if command -v "$tool" >/dev/null; then echo "$tool=yes"; else echo "$tool=no"; fi
done
echo "linger=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)"
echo "podman_major=$(podman version --format '{{.Client.Version}}' 2>/dev/null | cut -d. -f1)"
if grep -qs additionalGids /var/run/cdi/nvidia.yaml; then echo var_cdi_gids=yes; else echo var_cdi_gids=no; fi
if grep -qs '^\*[[:space:]]*hard[[:space:]]*memlock[[:space:]]*unlimited' /etc/security/limits.d/*.conf; then
  echo memlock_limits=yes; else echo memlock_limits=no; fi
for path in @ROOT_FILES@; do
  if [ -e "$path" ]; then
    if head -2 "$path" | grep -qF -e @RDMA_HEADER@ -e @COMPAT_HEADER@; then owner=engine; else owner=other; fi
    echo "file:$path=$(sha256sum <"$path" | cut -c1-64) $owner"
  else
    echo "file:$path="
  fi
done
link=@AGENT_LINK@
if [ -L "$link" ]; then echo link_kind=symlink; echo "link_target=$(readlink "$link")"
elif [ -e "$link" ]; then echo link_kind=file; echo link_target=; echo "link_sha=$(sha256sum <"$link" | cut -c1-64)"
else echo link_kind=none; echo link_target=; fi
engine=$HOME/@ENGINE_DIR@
if [ -f "$engine/agent_local.py" ]; then echo "engine=$(sha256sum <"$engine/agent_local.py" | cut -c1-64)"
elif [ -d "$engine" ]; then echo engine=present
else echo engine=; fi
# Who tailscale lets run serve without root ("?": not readable by this user); nothing when tailscale isn't there.
if command -v tailscale >/dev/null; then
  if prefs=$(tailscale debug prefs 2>/dev/null); then
    echo "operator=$(printf '%s' "$prefs" | sed -n 's/.*"OperatorUser": *"\([^"]*\)".*/\1/p' | head -1)"
  else echo 'operator=?'; fi
fi
'''
for name, value in (("PACKAGES", " ".join(PACKAGES)), ("ROOT_FILES", " ".join(ROOT_FILES)), ("RDMA_HEADER", shlex.quote(RDMA_HEADER)),
                    ("COMPAT_HEADER", shlex.quote(COMPAT_HEADER)), ("AGENT_LINK", AGENT_LINK), ("ENGINE_DIR", ENGINE_DIR)):
  PROBE = PROBE.replace(f"@{name}@", value)


# Discover's probe: the install's own read-only PROBE, plus whether startdgx's manifest is there.
DISCOVER_PROBE = PROBE + f'if [ -f "$HOME/{STARTDGX_DIR}/manifest.json" ]; then echo startdgx=yes; else echo startdgx=; fi\n'


class Error(Exception):
  pass


# Terminal controls a host could print to act on this terminal (an OSC 52 clipboard write, a CSI that redraws it):
# C0 but newline and tab, DEL, and C1. Everything startdgx passes on from a host goes through clean().
CONTROLS = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f]")
# What the root script prints reaches a terminal through a pty, where a line ends in a carriage return too.
TTY_CONTROLS = re.compile("[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]")


def clean(text):
  return CONTROLS.sub("", text)


# The commands running now (discover runs several at once, in threads), so a signal can end them all; and whether
# startdgx is stopping, after which none starts.
CHILDREN = set()
STOPPING = False


def run_process(cmd, stdin=None, timeout=None):
  """subprocess.run for a command whose output comes from a host: text with undecodable bytes replaced, and
  terminal controls taken out of stdout and stderr. It is ended with startdgx (stop_children)."""
  if STOPPING:
    raise Error("startdgx is stopping")
  with subprocess.Popen(cmd, stdin=subprocess.PIPE if stdin is not None else None, stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE, text=True, errors="replace") as proc:
    CHILDREN.add(proc)
    try:
      out, err = proc.communicate(stdin, timeout=timeout)
    except BaseException:
      proc.kill()
      raise
    finally:
      CHILDREN.discard(proc)
  return subprocess.CompletedProcess(cmd, proc.returncode, clean(out), clean(err))


def stop_children(signum, _frame):
  """On SIGTERM, SIGINT or SIGHUP (a shell restart ends the panel's processes): end every command startdgx runs, so
  no ssh is left behind, then exit."""
  global STOPPING
  STOPPING = True
  for proc in list(CHILDREN):
    with contextlib.suppress(OSError):
      proc.kill()
  raise SystemExit(128 + signum)


def run_on_tty(cmd):
  """Runs cmd on a pty of its own, relaying this terminal's input to it (sudo's password prompt) and its output back
  without terminal controls; returns its exit code."""
  decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
  # What was printed here before goes first: the relay writes to the terminal directly.
  sys.stdout.flush()
  sys.stderr.flush()

  def read(fd):
    while True:
      data = os.read(fd, 4096)
      if not data:
        return data
      shown = TTY_CONTROLS.sub("", decoder.decode(data)).encode()
      # An empty answer would read as the end of the output.
      if shown:
        return shown

  return os.waitstatus_to_exitcode(pty.spawn(cmd, read))


def config_dir():
  return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "startdgx")


def config_path():
  # Demo mode keeps its own machines, so the real list is never read or written.
  return os.path.join(demo_dir() if DEMO else config_dir(), "hosts.json")


def load_hosts():
  try:
    with open(config_path()) as f:
      return json.load(f)
  except FileNotFoundError:
    return {}


@contextlib.contextmanager
def hosts_changing():
  """The hosts to change, saved when the block ends; one change at a time, so an add and a forget running at once
  (the panel runs them in parallel) never lose each other's."""
  os.makedirs(os.path.dirname(config_path()), exist_ok=True)
  with open(config_path() + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    hosts = load_hosts()
    yield hosts
    write_json(config_path(), hosts)


def target(host):
  if host not in load_hosts():
    raise Error(f"{host} isn't added. Run: startdgx add {host}")
  if not TARGET_RE.match(host):
    raise Error("Not an SSH target")
  return host


def ssh(host, *argv, timeout=None, check=True):
  return ssh_raw(host, f"{ENGINE} {shlex.join(argv)}", timeout=timeout, check=check, what=argv[0])


def ssh_raw(host, command, stdin=None, timeout=None, check=True, what="command", opts=SSH_OPTS):
  """Runs a fixed shell command on the host; anything variable in it must already be shlex-quoted."""
  cmd = ["ssh", *opts, "--", host, command]
  try:
    result = run_process(cmd, stdin=stdin, timeout=timeout)
  except subprocess.TimeoutExpired as error:
    raise Error(f"{host} didn't answer in time") from error
  if check and result.returncode == 255:
    raise_ssh_failure(host, result.stderr, what)
  if check and result.returncode != 0:
    lines = (result.stderr.strip().splitlines() or [f"{what} failed on {host}"])
    raise Error(lines[-1].removeprefix("Error: "))
  return result


def raise_ssh_failure(host, stderr, what):
  """The Error for an ssh that itself failed (exit 255), with ssh's own reason when it gave one."""
  raise Error(ssh_failure(host, stderr) if stderr.strip() else f"{what} failed on {host}")


def ssh_target(host):
  if not TARGET_RE.match(host) or host.startswith("-"):
    raise Error("Name the machine as SSH reaches it, e.g. user@spark-1234.local")
  return host


def recipe(value):
  if not RECIPE_RE.match(value):
    raise Error("Not a recipe id")
  return value


def cmd_add(args):
  profile = json.loads(ssh(ssh_target(args.host), "profile").stdout)
  with hosts_changing() as hosts:
    hosts[args.host] = {"profile": profile}
  print(f"{args.host} added")


def cmd_remove_host(args):
  with hosts_changing() as hosts:
    if hosts.pop(args.host, None) is None:
      raise Error(f"{args.host} isn't added")
  print(f"{args.host} removed from startdgx")


def cmd_hosts(args):
  hosts = load_hosts()
  if args.json:
    print(json.dumps(hosts, indent=2))
  for host in hosts if not args.json else ():
    print(host)


def passthrough(*engine_args):
  def run(args):
    out = ssh(target(args.host), *engine_args, *(recipe(args.model),) if getattr(args, "model", None) else (), timeout=args.timeout)
    sys.stdout.write(out.stdout)
  return run


ENGINE_TAG_RE = re.compile(r"^v(\d+)\.(\d+)\.(\d+)-dgx\.(\d+)$")
MANIFEST_MARK = "#manifest"


def engine_update(host_tag, pinned=None):
  """{"from", "to"} when the engine startdgx installed on the host is an older release than the pin, else None: a
  tag that isn't a release of the fork's, or a newer one (updating would downgrade it), is left alone."""
  pinned = pinned or ENGINE_TAG
  old, new = ENGINE_TAG_RE.match(host_tag or ""), ENGINE_TAG_RE.match(pinned)
  if old and new and tuple(map(int, old.groups())) < tuple(map(int, new.groups())):
    return {"from": host_tag, "to": pinned}
  return None


def cmd_status(args):
  # The manifest's engine tag rides on the status call, so a poll stays one ssh.
  host = target(args.host)
  out = ssh_raw(host, f"{ENGINE} status --json; rc=$?; if [ $rc = 0 ]; then echo; echo '{MANIFEST_MARK}'; "
                      f"grep -m1 '\"tag\"' {MANIFEST} 2>/dev/null; fi; exit $rc", timeout=args.timeout, what="status").stdout
  status, _, manifest = out.partition(f"\n{MANIFEST_MARK}\n")
  tag = re.search(r'"tag":\s*"([^"]*)"', manifest)
  update = engine_update(tag[1]) if tag else None
  try:
    document = json.loads(status)
  except ValueError:
    document = None
  if update and isinstance(document, dict):
    sys.stdout.write(json.dumps({**document, "engine_update": update}) + "\n")
  else:
    sys.stdout.write(status)


def cmd_list(args):
  sys.stdout.write(ssh(target(args.host), "list", "--json", timeout=args.timeout).stdout)


def cmd_start(args):
  sys.stdout.write(ssh(target(args.host), "start", recipe(args.model), timeout=args.timeout).stdout)


def cmd_stop(args):
  argv = ["stop"] + ([recipe(args.model)] if args.model else [])
  sys.stdout.write(ssh(target(args.host), *argv, timeout=args.timeout).stdout)


def cmd_use(args):
  # --ctx picks one of the contexts the recipe has measured (see variants); on a model already set up the engine
  # restarts it with that one.
  # --yes is the engine's for a recipe of yours: it downloads what the recipe names and runs it, so it is sent only when
  # the person said so (the panel after its confirmation card).
  ctx = (["--ctx", str(args.ctx)] if args.ctx else []) + (["--yes"] if args.yes else [])
  if not args.detach:
    sys.stdout.write(ssh(target(args.host), "use", recipe(args.model), *ctx, timeout=args.timeout or 3600).stdout)
    return
  # The engine runs the setup in a transient user unit and returns, or says one is already running (and starts no
  # second); its last line says which, and it is the one line the panel shows.
  out = ssh(target(args.host), "use", recipe(args.model), *ctx, "--detach", timeout=args.timeout or 120).stdout
  print((out.strip().splitlines() or [f"Setting up {args.model} in the background"])[-1])


# Read-only, for variants: the [[variant]] entries of the recipe (argv[1]) in the engine's recipes folder or the user's,
# largest context first (with each one's source: measured unless the recipe says otherwise). Prints a JSON list, or nothing for a recipe the host doesn't have.
VARIANTS_PROBE = f'''
import json, os, sys, tomllib
recipe = None
# The engine's own recipes, then the user's: a user recipe's id never clashes with a curated one.
for folder in ("{ENGINE_DIR}/recipes/", "{ENGINE_STATE}/recipes/"):
  try:
    with open(os.path.expanduser("~/" + folder + sys.argv[1] + ".toml"), "rb") as handle:
      recipe = tomllib.load(handle)
    break
  except OSError:
    pass
if recipe is None:
  sys.exit(0)
# What the person confirmed (the engine's recipes-confirmed.json: recipe id -> "ctx/ram/gpu" keys, the numbers as the repr of
# the float, as its variant_key writes them: 0.1 and 0.10 are one number, and 20 is 20.0).
try:
  with open(os.path.expanduser("~/{ENGINE_STATE}/recipes-confirmed.json")) as handle:
    confirmed = json.load(handle).get(sys.argv[1], [])
except (OSError, ValueError, AttributeError):
  confirmed = []
def key(v):
  return f"{{v['ctx']}}/{{float(v['peak_ram_gib'])!r}}/{{float(v['peak_gpu_gib'])!r}}"
out = [{{"ctx": v["ctx"], "peak_ram_gib": v["peak_ram_gib"], "peak_gpu_gib": v["peak_gpu_gib"], "source": v.get("source", "measured"),
        "confirmed": v.get("source") == "estimated" and key(v) in confirmed}} for v in recipe.get("variant", [])]
print(json.dumps(sorted(out, key=lambda v: (-v["ctx"], -v["peak_ram_gib"]))))
'''


def parse_variants(text):
  try:
    found = json.loads(text.strip().splitlines()[-1])
    return [{"ctx": int(v["ctx"]), "peak_ram_gib": float(v["peak_ram_gib"]), "peak_gpu_gib": float(v["peak_gpu_gib"]),
             "source": str(v.get("source", "measured")), "confirmed": v.get("confirmed") is True} for v in found] if isinstance(found, list) else None
  except (ValueError, IndexError, KeyError, TypeError):
    return None


def print_variants(variants, as_json):
  if as_json:
    print(json.dumps(variants))
    return
  for v in variants:
    print(f"{v['ctx']}  {v['peak_ram_gib']:g} GiB RAM  {v['peak_gpu_gib']:g} GiB GPU  {v['source']}{' (confirmed)' if v.get('confirmed') else ''}")


def cmd_variants(args):
  host, rid = target(args.host), recipe(args.model)
  out = ssh_raw(host, f"python3 -I - {shlex.quote(rid)}", stdin=VARIANTS_PROBE, timeout=args.timeout, what="probe").stdout
  variants = parse_variants(out) if out.strip() else None
  if not variants:
    raise Error(f"{host} has no measured contexts for {rid}")
  print_variants(variants, args.json)


def cmd_share(args):
  host, rid = target(args.host), recipe(args.model)
  result = ssh(host, "share", rid, *(["--off"] if args.off else []), timeout=args.timeout, check=False)
  if result.returncode == 0:
    sys.stdout.write(result.stdout)
    return
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, "share")
  # The engine saves a share before it publishes it, so one that failed to publish (Serve isn't enabled, no operator)
  # would read as shared with no route: take it back, best effort, and say why in one line (its message spans several).
  reason = " ".join(result.stderr.split()).removeprefix("Error: ") or f"share failed on {host}"
  if "didn't answer" in reason:
    # tailscale serve waits for a click when the tailnet hasn't enabled Serve, and the engine gives up on it after 10 s.
    reason = f"{reason.rstrip('.')}. Serve may not be enabled on the tailnet: enable it at {SERVE_ENABLE_URL}, then share again"
  if args.off:
    raise Error(reason)
  with contextlib.suppress(Error):
    ssh(host, "share", rid, "--off", timeout=60, check=False)
  raise Error(f"{rid} is not shared: {reason}")


# ---- user recipes ------------------------------------------------------------------------------------------
# A recipe the user wrote (a .toml on this computer) goes to the engine's `recipe validate` / `recipe add` on stdin: the
# engine takes the recipe's id from the file's name, so the host gets a copy named for it in a folder of its own.
RECIPE_MAX_BYTES = 256 * 1024
RECIPE_SEND = 'd=$(mktemp -d) && cat > "$d"/{rid}.toml && {engine} recipe {verb} "$d"/{rid}.toml; rc=$?; rm -rf "$d"; exit $rc'


def read_recipe_file(path):
  """(id, text) of a recipe file on this computer, or an Error saying why it can't be one."""
  path = os.path.expanduser(path)
  name = os.path.basename(path)
  if not name.endswith(".toml"):
    raise Error("A recipe file ends in .toml, and its name (without it) is the recipe's id")
  rid = name[:-len(".toml")]
  if not RID_RE.match(rid):
    raise Error(f"{name} can't be a recipe: its id (the name without .toml) is lower-case letters, digits, dots and dashes")
  try:
    if not os.path.isfile(path):
      raise Error(f"{path} isn't a file")
    if os.path.getsize(path) > RECIPE_MAX_BYTES:
      raise Error(f"{name} is too big to be a recipe")
    with open(path, encoding="utf-8") as handle:
      return rid, handle.read()
  except UnicodeDecodeError as error:
    raise Error(f"{name} isn't UTF-8 text") from error
  except OSError as error:
    raise Error(f"{name} can't be read: {error.strerror}") from error


def engine_lines(*streams):
  """What the engine printed, as separate cleaned lines without the Error: it puts before a message."""
  lines = [line.strip().removeprefix("Error: ") for stream in streams for line in clean(stream).splitlines() if line.strip()]
  return [line for line in lines if line]


def recipe_result(ok, rid, errors=(), message=""):
  """The answer of recipe validate and add: { ok, id, errors, message }."""
  return {"ok": ok, "id": rid, "errors": list(errors), "message": message}


def print_recipe_result(result, as_json):
  """validate's and add's answer: JSON for the panel (exit 0, the machine answered), else the message, or the engine's
  errors one to a line on stderr and exit 1."""
  if as_json:
    print(json.dumps(result))
    return 0
  if result["ok"]:
    print(result["message"])
    return 0
  for line in result["errors"]:
    print(line, file=sys.stderr)
  return 1


def recipe_send(host, verb, rid, text, timeout):
  """The engine's validate or add of a recipe's text on a host (already a target), as recipe_result's dict."""
  result = ssh_raw(host, RECIPE_SEND.format(rid=rid, engine=ENGINE, verb=verb), stdin=text, timeout=timeout, check=False, what=f"recipe {verb}")
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, f"recipe {verb}")
  if result.returncode != 0:
    # The engine rejected it: validate prints its errors on stdout, add's on stderr; all of them are the answer.
    return recipe_result(False, rid, engine_lines(result.stdout, result.stderr) or [f"recipe {verb} failed on {host}"])
  return recipe_result(True, rid, message=(engine_lines(result.stdout) or [f"Recipe {rid} {'is valid' if verb == 'validate' else 'added'}"])[-1])


def cmd_recipe_send(args):
  host = target(args.host)
  rid, text = read_recipe_file(args.file)
  return print_recipe_result(recipe_send(host, args.verb, rid, text, args.timeout), args.json)


def cmd_recipe_list(args):
  sys.stdout.write(ssh(target(args.host), "recipe", "list", *(["--json"] if args.json else []), timeout=args.timeout).stdout)


def cmd_recipe_remove(args):
  host, rid = target(args.host), recipe(args.id)
  result = ssh_raw(host, f"{ENGINE} {shlex.join(['recipe', 'remove', rid])}", timeout=args.timeout, check=False, what="recipe remove")
  if result.returncode == 255:
    raise_ssh_failure(host, result.stderr, "recipe remove")
  if result.returncode != 0:
    # The engine says which model uses the recipe; keep all of its message, on one line.
    raise Error(" ".join(engine_lines(result.stdout, result.stderr)) or f"recipe remove failed on {host}")
  sys.stdout.write(result.stdout)


def cmd_recipe_measure(args):
  """The engine's measure: it loads the recipe at a context, benches it and records what it showed. Without --yes it
  only says what it would download and load (its own dry run); with it, it runs, which takes minutes."""
  host, rid = target(args.host), recipe(args.id)
  argv = ["measure", rid, "--ctx", str(args.ctx)] + (["--yes"] if args.yes else [])
  sys.stdout.write(clean(ssh(host, *argv, timeout=args.timeout or (3600 if args.yes else 60)).stdout))


def cmd_recipe_confirm(args):
  sys.stdout.write(clean(ssh(target(args.host), "recipe", "confirm", recipe(args.id), timeout=args.timeout).stdout))


def cmd_recipe(args):
  return {"validate": cmd_recipe_send, "add": cmd_recipe_send, "list": cmd_recipe_list, "remove": cmd_recipe_remove,
          "measure": cmd_recipe_measure, "confirm": cmd_recipe_confirm, "draft": cmd_recipe_draft, "author": cmd_recipe_author}[args.verb](args)


def cmd_delete(args):
  if args.dry_run:
    rid, host = recipe(args.model), target(args.host)
    out = ssh_raw(host, f"python3 -I - {shlex.quote(rid)}", stdin=REMOVE_PROBE, timeout=args.timeout, what="probe").stdout
    try:
      found = json.loads(out.strip().splitlines()[-1])
      plan = {"recipe": rid, "setting_up": bool(found["setting_up"]), "bytes": int(found["bytes"])}
      set_up = bool(found["set_up"])
    except (ValueError, IndexError, KeyError, TypeError) as error:
      raise Error(f"{host} gave an answer startdgx can't read") from error
    if not (set_up or plan["setting_up"]):
      raise Error(f"{rid} isn't set up on {host}")
    print_remove_plan(plan, args.json)
    return
  sys.stdout.write(ssh(target(args.host), "remove", recipe(args.model), timeout=args.timeout).stdout)


def print_remove_plan(plan, as_json):
  if as_json:
    print(json.dumps(plan))
  elif plan["setting_up"]:
    print(f"Cancelling the setup of {plan['recipe']} would delete the {size_text(plan['bytes'])} downloaded so far")
  else:
    print(f"Removing {plan['recipe']} would free {size_text(plan['bytes'])}")


def probe(host):
  """The host's state as a dict, from the read-only PROBE; a key given twice keeps its last value."""
  out = ssh_raw(host, "bash -s", stdin=PROBE, timeout=60, what="probe").stdout
  return checked_user(host, parse_probe(out))


def parse_probe(out):
  return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


def checked_user(host, state):
  """A probe's state, once its user and home are known to be safe to put in scripts and paths."""
  if not USER_RE.match(state.get("user", "")) or not HOME_RE.match(state.get("home", "")):
    raise Error(f"{host} reported an unexpected user or home directory")
  return state


def is_spark(state):
  return "GB10" in state.get("gpu", "") or "Spark" in state.get("dgx_name", "")


def tailnet_peers():
  """The online Linux peers in `tailscale status --json`, as sorted unique short names."""
  try:
    result = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=30, check=False)
  except (OSError, subprocess.TimeoutExpired) as error:
    raise Error(f"Can't run tailscale: {error}") from error
  if result.returncode != 0:
    raise Error((result.stderr.strip().splitlines() or ["tailscale status failed"])[-1])
  try:
    peers = json.loads(result.stdout).get("Peer") or {}
    names = {clean(str((p.get("DNSName") or "").split(".")[0] or p.get("HostName") or ""))
             for p in peers.values() if p.get("Online") and str(p.get("OS", "")).lower() == "linux"}
  except (ValueError, AttributeError) as error:
    raise Error("tailscale status gave unexpected JSON") from error
  return sorted(names - {""})


def discover_peer(name, user, timeout, added, deadline, limit):
  """One peer's record. Pure: it reads nothing shared and writes nothing, so peers can be probed in parallel. A probe
  never runs past discover's deadline (time.monotonic())."""
  host = f"{user}@{name}"
  record = {"name": name, "target": host, "reachable": False, "reason": None, "spark": None, "installed": None, "engine": None,
            "added": host in added}
  if not TARGET_RE.match(name) or name.startswith("-") or not TARGET_RE.match(host):
    record["reason"] = "not a valid ssh name"
    return record
  left = deadline - time.monotonic()
  if left < 1:
    record["reason"] = f"not asked: discover's time limit ({limit} s) ran out"
    return record
  try:
    result = ssh_raw(host, "bash -s", stdin=DISCOVER_PROBE, timeout=min(timeout, left), check=False, what="probe", opts=DISCOVER_SSH_OPTS)
  except Error as error:
    record["reason"] = str(error)
    return record
  if result.returncode != 0:
    record["reason"] = ssh_failure(host, result.stderr)
    return record
  state = parse_probe(result.stdout)
  record.update(reachable=True, spark=is_spark(state), installed=bool(state.get("startdgx")), engine=bool(state.get("engine")))
  return record


def ssh_failure(host, stderr):
  """Why a BatchMode ssh failed, in words that say what to do: its last line, unless it is one ssh says vaguely."""
  if "Permission denied" in stderr:
    return f"ssh needs a key: run ssh-copy-id {host}"
  if "Host key verification failed" in stderr and "host key is known" in stderr:
    return f"ssh hasn't seen {host}'s host key yet: Add machine's tailnet list saves it, or run ssh {host} once"
  if "Host key verification failed" in stderr:
    return f"its host key changed since this machine last saw it: check why before you trust it (ssh {host} says more)"
  return (stderr.strip().splitlines() or ["ssh failed"])[-1]


def discover_peers(user, timeout, limit):
  names, added = tailnet_peers(), set(load_hosts())
  deadline = time.monotonic() + limit
  with concurrent.futures.ThreadPoolExecutor(max_workers=DISCOVER_WORKERS) as pool:
    return list(pool.map(lambda name: discover_peer(name, user, timeout, added, deadline, limit), names))


def cmd_discover(args):
  user = args.user or ("demo" if DEMO else getpass.getuser())
  if not TARGET_RE.match(user) or user.startswith("-") or "@" in user:
    raise Error("Not a valid user name")
  records = demo_peers(user) if DEMO else discover_peers(user, args.timeout, args.limit)
  if args.json:
    print(json.dumps(records, indent=2))
    return
  for r in records:
    if not r["reachable"]:
      print(f"{r['name']}  {r['target']}  unreachable ({r['reason']})")
    else:
      flags = [("spark" if r["spark"] else "not a Spark"), ("installed" if r["installed"] else "not installed"),
               ("engine" if r["engine"] else "no engine"), ("added" if r["added"] else "not added")]
      print(f"{r['name']}  {r['target']}  {', '.join(flags)}")


def operator_step_needed(state):
  """Whether tailscale is on the host and its operator is anyone but the user: the engine runs tailscale serve as
  the user, which tailscale refuses unless they are the operator."""
  return "operator" in state and state["operator"] != state["user"]


def engine_entry(state):
  return f"{state['home']}/{ENGINE_DIR}/omarchy-local-ai"


def plan(state, args):
  """What an install would change, predicted from the probe with HOST_SETUP's own conditions."""
  steps = [f"copy the engine from {os.path.abspath(args.engine_path)}" if args.engine_path else f"clone {ENGINE_REPO} at {ENGINE_TAG}"]
  if state.get("memlock_limits") != "yes":
    steps.append(f"create {ROOT_FILES[0]} (unlimited locked memory)")
  if not state.get(f"file:{ROOT_FILES[1]}"):
    steps.append(f"create {ROOT_FILES[1]} (unlimited locked memory for user services)")
  missing = [tool for tool in PACKAGES if state.get(tool) != "yes"]
  if missing:
    steps.append(f"install {' '.join(missing)}")
  major = state.get("podman_major", "")
  if (not major.isdigit() or int(major) < 5) and state.get("var_cdi_gids") == "yes":
    steps.append(f"write the Podman 4 CDI compat: {', '.join(ROOT_FILES[2:])}")
  if state.get("linger") != "yes":
    steps.append(f"enable linger for {state['user']}")
  if state.get("link_target") != engine_entry(state):
    steps.append(f"link {AGENT_LINK} -> {engine_entry(state)}")
  if operator_step_needed(state):
    now = state["operator"]
    steps.append(f"set the tailscale operator to {state['user']}" + (f" (now {now})" if now not in ("", "?") else ""))
  steps += [f"copy the engine to ~/{ENGINE_DIR}", f"write {MANIFEST}", f"add {args.host} to startdgx"]
  return steps


@contextlib.contextmanager
def engine_source(args):
  """A checkout of the engine on this machine: --engine-path, or the pinned tag cloned into a temporary directory."""
  if args.engine_path:
    path = os.path.abspath(args.engine_path)
    if not os.path.isfile(os.path.join(path, "agent_local.py")):
      raise Error(f"{path} isn't an omarchy-local-ai checkout (no agent_local.py)")
    yield path
    return
  with tempfile.TemporaryDirectory(prefix="startdgx-engine-") as tmp:
    path = os.path.join(tmp, "engine")
    clone = subprocess.run(["git", "clone", "-q", "--depth", "1", "--branch", ENGINE_TAG, "--", ENGINE_REPO, path],
                           capture_output=True, text=True, check=False)
    if clone.returncode != 0:
      raise Error(f"Can't clone {ENGINE_REPO} at {ENGINE_TAG}: {clone.stderr.strip()[-400:]}")
    yield path


def engine_setup_script(src):
  """The engine's own root setup, HOST_SETUP (with its CDI compat) then MACHINE_SETUP_TAIL, read from its
  agent_local.py without running any of it."""
  path = os.path.join(src, "agent_local.py")
  try:
    with open(path) as f:
      tree = ast.parse(f.read(), path)
  except (OSError, SyntaxError) as error:
    raise Error(f"Can't read the engine's host setup in {path}: {error}") from error
  found = {target.id: node.value.value for node in tree.body if isinstance(node, ast.Assign)
           and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str)
           for target in node.targets if isinstance(target, ast.Name)}
  missing = [name for name in ("HOST_SETUP", "CDI_COMPAT", "MACHINE_SETUP_TAIL") if name not in found]
  if missing:
    raise Error(f"The engine in {src} has no {', '.join(missing)}: is it older than machine add?")
  return found["HOST_SETUP"].replace("@CDI_COMPAT@", found["CDI_COMPAT"]) + found["MACHINE_SETUP_TAIL"]


def run_root(host, script, argv, doing):
  """Runs a script as root on the host in one sudo call, with argv as its $0 and arguments; sudo asks for the
  password on this terminal."""
  remote = shlex.join(["sudo", "bash", "-c", script, *argv])
  if run_on_tty(["ssh", "-t", *SSH_OPTS, "--", host, remote]) != 0:
    raise Error(f"{doing} {host} as root failed (see above)")


def sync_engine(host, src):
  ssh_raw(host, f"mkdir -p ~/{ENGINE_DIR}", what="mkdir")
  copy = subprocess.run(["rsync", "-a", "--delete", "--exclude=.git", "--exclude=__pycache__", "-e", shlex.join(["ssh", *SSH_OPTS]),
                         src + "/", f"{host}:{ENGINE_DIR}/"], capture_output=True, text=True, check=False)
  if copy.returncode != 0:
    raise Error(f"Copying the engine to {host} failed: {copy.stderr.strip()[-400:]}")


NAMED_KINDS = ("package", "linger", "operator")


def snapshot(state):
  """Everything the install may create or change, by (kind, path or name), as it is in this probe."""
  items = {}
  for path in ROOT_FILES:
    sha, _, owner = state.get(f"file:{path}", "").partition(" ")
    items[("file", path)] = {"exists": bool(sha), "sha256": sha or None, "engine_header": owner == "engine"}
  for tool in PACKAGES:
    items[("package", tool)] = {"installed": state.get(tool) == "yes"}
  items[("linger", state["user"])] = {"linger": state.get("linger", "")}
  items[("symlink", AGENT_LINK)] = {"type": state.get("link_kind", "none"), "target": state.get("link_target") or None}
  if state.get("link_kind") == "file":
    items[("symlink", AGENT_LINK)]["sha256"] = state.get("link_sha") or None
  if state.get("operator", "?") != "?":
    items[("operator", "tailscale")] = {"operator": state["operator"]}
  engine = state.get("engine", "")
  items[("engine", f"{state['home']}/{ENGINE_DIR}")] = {"exists": bool(engine), "agent_local_sha256": engine if len(engine) == 64 else None}
  return items


def item_key(item):
  return (item["kind"], item.get("path") or item.get("name"))


def with_backup(key, previous, home):
  """The pre-state, plus where BACKUP copied it when it was a file the root setup overwrites."""
  existed = previous.get("exists") or previous.get("type") == "file"
  if key in BACKUPS and existed:
    return {**previous, "backup": f"{home}/{BACKUP_DIR}/{BACKUPS[key]}"}
  if key[0] == "engine" and existed:
    return {**previous, "backup": f"{home}/{ENGINE_BACKUP}"}
  return previous


def existed(kind, snap):
  """Whether the item was there in this snapshot; a snapshot that doesn't say counts as there."""
  if kind == "package":
    return snap.get("installed") is not False
  if kind == "linger":
    return snap.get("linger") == "yes"
  if kind == "symlink":
    return snap.get("type") != "none"
  if kind == "operator":
    return bool(snap.get("operator"))
  return snap.get("exists") is not False


def build_manifest(old, before, now, engine):
  """The manifest after an install: each item keeps the earliest `previous` any install recorded, and differs
  from that now either because the install created it (it wasn't there) or because it changed what was there."""
  earliest = {item_key(item): item["previous"] for item in old.get("items", [])}
  start, current = snapshot(before), snapshot(now)
  items = []
  for (kind, ref), state in current.items():
    if (kind, ref) not in start and (kind, ref) not in earliest:
      continue
    previous = earliest.get((kind, ref)) or with_backup((kind, ref), start[(kind, ref)], before["home"])
    differs, was = {k: v for k, v in previous.items() if k != "backup"} != state, existed(kind, previous)
    items.append({"kind": kind, "name" if kind in NAMED_KINDS else "path": ref, "created_by_us": differs and not was,
                  "changed_by_us": differs and was, "previous": previous})
  items += [item for item in old.get("items", []) if item_key(item) not in current]
  stamp = datetime.datetime.now(datetime.UTC).isoformat(timespec="seconds")
  return {"schema_version": 1, "engine": engine, "installed_at": old.get("installed_at") or stamp, "updated_at": stamp,
          "pre_state": old.get("pre_state") or before, "items": items}


def read_manifest(host):
  text = ssh_raw(host, f"cat {MANIFEST} 2>/dev/null || true", what="cat").stdout
  try:
    return json.loads(text) if text.strip() else {}
  except ValueError as error:
    raise Error(f"{host}:{MANIFEST} isn't valid JSON; move it aside to install again") from error


def write_manifest(host, manifest):
  tmp = MANIFEST + ".tmp"
  ssh_raw(host, f"mkdir -p {os.path.dirname(MANIFEST)} && cat > {tmp} && mv {tmp} {MANIFEST}",
          stdin=json.dumps(manifest, indent=2) + "\n", what="manifest")


def engine_record(args, state):
  local = os.path.abspath(args.engine_path) if args.engine_path else None
  return {"repo": None if local else ENGINE_REPO, "tag": None if local else ENGINE_TAG, "local_checkout": local,
          "path": f"{state['home']}/{ENGINE_DIR}"}


# Appended to the engine's root script (its $1 is the user): a failure is said, not fatal, since the models work without it.
SET_OPERATOR = '''
if command -v tailscale >/dev/null && ! tailscale set --operator="$1"; then
  echo "Couldn't set the tailscale operator; sharing a model will fail until: sudo tailscale set --operator=$1" >&2
fi
'''


def cmd_install(args):
  host = ssh_target(args.host)
  before = probe(host)
  if not is_spark(before):
    raise Error(f"{host} isn't a DGX Spark (no GB10 GPU and no DGX Spark in /etc/dgx-release)")
  old = read_manifest(host)
  # An engine there without a manifest isn't one startdgx installed; one with a manifest is ours, or backed up.
  replace = bool(before.get("engine")) and not old
  if replace and not args.replace_engine:
    raise Error(f"{host} already has an engine startdgx didn't install, in ~/{ENGINE_DIR}. Run install with --replace-engine "
                f"to back it up to ~/{ENGINE_BACKUP} and replace it (uninstall puts it back)")
  if args.dry_run:
    print(f"Would, on {host}:")
    for step in ([f"back up the engine ~/{ENGINE_DIR} to ~/{ENGINE_BACKUP}"] if replace else []) + plan(before, args):
      print(f"  {step}")
    return
  with engine_source(args) as src:
    script, engine = engine_setup_script(src), engine_record(args, before)
    if operator_step_needed(before):
      script += SET_OPERATOR
    # Recorded before anything changes, so an install that fails halfway still knows what was there.
    ssh_raw(host, "bash -s -- startdgx-backup", stdin=BACKUP + (BACKUP_ENGINE if replace else ""), what="backup")
    write_manifest(host, build_manifest(old, before, before, engine))
    try:
      print(f"Preparing {host} (sudo there asks for your password)")
      run_root(host, script, ["startdgx-install", before["user"], engine_entry(before)], "Preparing")
      print(f"Copying the engine to {host}")
      sync_engine(host, src)
    except BaseException:
      # What a failed root script or copy changed is recorded too, so an uninstall can still undo it.
      try:
        write_manifest(host, build_manifest(old, before, probe(host), engine))
      except Error as error:
        print(f"Warning: can't record what the failed install changed ({error}); "
              f"{host}:{MANIFEST} has only what was there before", file=sys.stderr)
      raise
    write_manifest(host, build_manifest(old, before, probe(host), engine))
  print(f"Install recorded in {host}:{MANIFEST}")
  cmd_add(args)


def uninstall_probe(host):
  """What the engine set up for the user since the install, from the read-only UNINSTALL_PROBE: single values
  by key, and the repeated ones (quadlet, image, exists) as lists."""
  out = ssh_raw(host, "bash -s -- startdgx-uninstall-probe", stdin=UNINSTALL_PROBE, timeout=60, what="probe").stdout
  state = {"quadlet": [], "image": [], "exists": []}
  for key, _, value in (line.partition("=") for line in out.splitlines() if "=" in line):
    if key in ("quadlet", "image", "exists"):
      state[key].append(value)
    else:
      state[key] = value
  return checked_user(host, state)


def decoded_json(text):
  try:
    return json.loads(base64.b64decode(text, validate=True))
  except ValueError:
    return None


def shared_recipes(state):
  shares = decoded_json(state.get("shares", ""))
  recipes = shares.get("recipes") if isinstance(shares, dict) else None
  return sorted({rid for rid in recipes if isinstance(rid, str) and RID_RE.match(rid)}) if isinstance(recipes, list) else []


def serve_paths(state):
  """Our routes in the tailscale serve config: /local-ai and what is under it, on any name."""
  config = decoded_json(state.get("serve", ""))
  webs = config.get("Web") if isinstance(config, dict) else None
  paths = set()
  for web in webs.values() if isinstance(webs, dict) else ():
    handlers = web.get("Handlers") if isinstance(web, dict) else None
    paths |= {path for path in handlers or () if isinstance(path, str) and SERVE_PATH_RE.match(path)}
  return sorted(paths)


def size_text(n):
  for unit, size in (("GiB", 2**30), ("MiB", 2**20), ("KiB", 2**10)):
    if n >= size:
      return f"{n / size:.1f} {unit}"
  return f"{n} B"


def engine_is_ours(manifest, state):
  """Whether the install created the engine; what an engine that was there before set up isn't startdgx's."""
  return ("engine", f"{state['home']}/{ENGINE_DIR}") in ours(manifest, "created_by_us")


def ours_recipes(manifest, state):
  """How many recipes of the user's the engine startdgx installed holds; 0 where the engine isn't startdgx's (what it
  holds isn't ours to keep or delete), so the plan's steps, its kept lines and its count agree."""
  count = state.get("recipes", "")
  return int(count) if count.isdigit() and engine_is_ours(manifest, state) else 0


def uninstall_state_text(keeping, recipes=0):
  """The uninstall step for the engine's state dir, which holds the user's recipes."""
  if keeping:
    return f"delete ~/{ENGINE_STATE} except your recipes (the engine's state)"
  return f"delete ~/{ENGINE_STATE} (the engine's state{', with your recipes' if recipes else ''})"


def uninstall_recipes_kept():
  return f"keep your recipes in ~/{ENGINE_RECIPES} (--delete-recipes deletes them)"


def user_plan(manifest, state, args):
  """The steps under the user's home, in order, and what is kept: each step is (what it does, its shell).
  Units stop first; the engine goes last, since the units' hooks call it."""
  q, exists = shlex.quote, set(state["exists"])
  steps, kept = [], []
  if not engine_is_ours(manifest, state):
    return replaced_engine_plan(manifest, state, args)
  if ENGINE_DIR in exists:
    for rid in shared_recipes(state):
      steps.append((f"stop sharing {rid} (omarchy-local-ai share {rid} --off)",
                    f'"$HOME"/{ENGINE_DIR}/omarchy-local-ai share {rid} --off || echo "  share {rid} --off failed; its route goes below" >&2'))
  steps.append(("stop the engine's units (omarchy-agent-local-*.service)", "systemctl --user stop 'omarchy-agent-local-*.service'"))
  for path in serve_paths(state):
    steps.append((f"remove the tailscale serve route {path}", f"serve_off {q(path)}"))
  if state.get("serve") == "error":
    kept.append("tailscale serve status failed: remove any /local-ai routes yourself (tailscale serve status)")
  quadlets = [name for name in dict.fromkeys(state["quadlet"]) if QUADLET_RE.match(name)]
  images = [image for image in dict.fromkeys(state["image"]) if IMAGE_RE.match(image)]
  if images and quadlets:
    # The quadlets name the images; a rerun after a failure past this point finds them here.
    steps.append((None, f"mkdir -p ~/{STARTDGX_DIR} && printf '%s\\n' {' '.join(map(q, images))} >~/{UNINSTALL_IMAGES}"))
  for name in quadlets:
    steps.append((f"remove ~/{QUADLET_DIR}/{name}", f"rm -f ~/{QUADLET_DIR}/{name}"))
  if SHARE_UNIT in exists:
    steps.append((f"remove ~/{SHARE_UNIT}", f"rm -f ~/{SHARE_UNIT}"))
  if quadlets or SHARE_UNIT in exists:
    steps.append(("reload the user's systemd", "systemctl --user daemon-reload; systemctl --user reset-failed 'omarchy-agent-local-*' || true"))
  if state.get("network") == "yes":
    steps.append((f"remove the podman network {NETWORK}", f"podman network rm {NETWORK} >/dev/null"))
  if state.get("secret") == "yes":
    steps.append((f"remove the podman secret {SECRET}", f"podman secret rm {SECRET} >/dev/null"))
  for image in images if state.get("podman") == "yes" else ():
    steps.append((f"remove the image {image} unless a container uses it",
                  f'if podman image exists {q(image)}; then if [ -n "$(podman ps -a -q --filter ancestor={q(image)})" ]; then '
                  f'echo "  kept {image}: a container uses it"; else podman image rm {q(image)} >/dev/null; fi; fi'))
  recipes = ours_recipes(manifest, state)
  for path, what in ((ENGINE_STATE, "state"), (ENGINE_CONFIG, "key, overlays and shares")):
    if path not in exists:
      continue
    if path == ENGINE_STATE and recipes and not args.delete_recipes:
      steps.append((uninstall_state_text(True), f"find ~/{path} -mindepth 1 -maxdepth 1 ! -name recipes ! -name recipes-confirmed.json -exec rm -rf {{}} +"))
      kept.append(uninstall_recipes_kept())
    else:
      steps.append((uninstall_state_text(False, recipes), f"rm -rf ~/{path}") if path == ENGINE_STATE
                   else (f"delete ~/{path} (the engine's {what})", f"rm -rf ~/{path}"))
  if ENGINE_DATA in exists:
    size = state.get("models_bytes", "")
    weights = f"~/{ENGINE_DATA} ({size_text(int(size)) if size.isdigit() else 'unknown size'} of model weights"
    if args.delete_models:
      steps.append((f"delete {weights})", f"rm -rf ~/{ENGINE_DATA}"))
    else:
      kept.append(f"keep {weights}; --delete-models deletes them)")
  if ENGINE_DIR in exists:
    steps.append((f"delete the engine ~/{ENGINE_DIR}", f"rm -rf ~/{ENGINE_DIR}"))
  parents = " ".join(f"~/{path}" for path in SHARED_PARENTS)
  steps.append((f"remove {parents} where empty",
                f'for dir in {parents}; do if [ -d "$dir" ]; then rmdir --ignore-fail-on-non-empty "$dir"; fi; done'))
  return steps, kept


def replaced_engine_plan(manifest, state, args):
  """The user's steps where the engine was there before the install: what it set up isn't startdgx's to remove,
  so the only step puts back the engine --replace-engine replaced."""
  engine, backup = f"{state['home']}/{ENGINE_DIR}", f"{state['home']}/{ENGINE_BACKUP}"
  steps, kept = [], [f"left what the engine set up under ~ (its units, quadlets, network, secret, images, state, config, key, "
                     f"shares and models): the engine in ~/{ENGINE_DIR} was there before the install, so they aren't startdgx's to remove"]
  item = ours(manifest, "changed_by_us").get(("engine", engine))
  if item:
    put_back = f"rm -rf {engine} && cp -a {backup} {engine}"
    sha = str(previous_of(item).get("agent_local_sha256"))
    if SHA_RE.match(sha):
      steps.append((f"put back the engine that was there before, from {backup}", restore(f"{engine}/agent_local.py", f"{backup}/agent_local.py", sha, put_back)))
    else:
      steps.append((f"put back the engine that was there before, from {backup}",
                    f'if [ -d {backup} ]; then {put_back}; else echo "  left {engine}: its backup {backup} is missing" >&2; failed=1; fi'))
  if args.delete_models:
    kept.append("--delete-models deletes nothing here: the models are the engine's, which was there before")
  return steps, kept


def previous_of(item):
  previous = item.get("previous")
  return previous if isinstance(previous, dict) else {}


def ours(manifest, flag):
  """The manifest's items it marks with flag, by key: created_by_us for what wasn't there before the install,
  changed_by_us for what was. The manifest is the user's to edit, so an item whose `previous` disagrees is left out."""
  return {item_key(item): item for item in manifest["items"] if isinstance(item, dict) and "kind" in item and item.get(flag) is True
          and existed(item["kind"], previous_of(item)) == (flag == "changed_by_us")}


def sha_of(path):
  return f'"$(sha256sum 2>/dev/null <{shlex.quote(path)} | cut -c1-64)"'


def restore(path, backup, sha, put_back):
  """Shell that runs put_back when backup is still the file that was at path before the install; one already put
  back counts as done, and a backup that is missing or changed fails the script once the other steps have run, so
  the backups and the manifest stay."""
  return (f"if [ {sha_of(path)} = {sha} ] && [ ! -L {path} ]; then :; elif [ {sha_of(backup)} = {sha} ]; then {put_back}; "
          f'else echo "  left {path}: its backup {backup} is missing or changed" >&2; failed=1; fi')


def removable_packages(manifest):
  """The packages the install added that --remove-packages may remove: never python3, which the system needs."""
  created = ours(manifest, "created_by_us")
  return [name for name in PACKAGES if ("package", name) in created and name != "python3"]


APT_REMOVES = re.compile(r"^Remv ([^ :]+)")


def check_apt_removal(host, packages):
  """Refuses, before anything changes, a removal that would take more than the named packages with them."""
  names = " ".join(packages)
  out = ssh_raw(host, "bash -s -- startdgx-apt-check", stdin=f"LC_ALL=C apt-get -s remove {names}\n", timeout=60, what="apt-get -s remove").stdout
  extra = sorted({match[1] for match in map(APT_REMOVES.match, out.splitlines()) if match} - set(packages))
  if extra:
    raise Error(f"Removing {names} would also remove {' '.join(extra)}; run uninstall without --remove-packages, or remove them yourself")


def root_plan(manifest, state, args):
  """The root steps, which undo only what the manifest marks created_by_us or changed_by_us, and what is kept.
  Only paths and names of our own are acted on, each checked again on the host: the manifest is the user's to edit."""
  q, home, user = shlex.quote, state["home"], state["user"]
  created, changed = ours(manifest, "created_by_us"), ours(manifest, "changed_by_us")
  steps, kept = [], []
  limits, user_conf, compat, dropin, cdi = ROOT_FILES
  # How each file the engine writes is known to be its own, so that a created one is removed only while it still is.
  own = {limits: f"head -1 {limits} | grep -qF {q(RDMA_HEADER)}", user_conf: f"head -1 {user_conf} | grep -qF {q(RDMA_HEADER)}",
         compat: f"head -2 {compat} | grep -qF {q(COMPAT_HEADER)}", dropin: f"grep -qx {q('ExecStartPost=' + compat)} {dropin}", cdi: "true"}
  for path in ROOT_FILES:
    if ("file", path) in created:
      steps.append((f"remove {path}", f'if [ ! -e {path} ]; then :; elif {own[path]}; then rm -f {path}; '
                                     f'else echo "  left {path}: it is no longer the one the install wrote"; fi'))
      if path == dropin:
        steps.append((None, f"if [ -d {os.path.dirname(dropin)} ]; then rmdir --ignore-fail-on-non-empty {os.path.dirname(dropin)}; fi"))
      if path == user_conf:
        # A running manager keeps the default until it re-reads its config, as the engine's setup made it do.
        steps.append((f"re-execute {user}'s systemd to drop it", f"if pgrep -u {q(user)} -x systemd >/dev/null; then "
                                                                 f"systemctl --user -M {q(user + '@')} daemon-reexec || "
                                                                 f'echo "  couldn\'t: it drops it when it next starts" >&2; fi'))
    elif ("file", path) in changed:
      sha, backup = str(previous_of(changed[("file", path)]).get("sha256")), f"{home}/{BACKUP_DIR}/{BACKUPS[('file', path)]}"
      if SHA_RE.match(sha):
        steps.append((f"restore {path} from {backup}", restore(path, backup, sha, f"mkdir -p {os.path.dirname(path)} && cp {q(backup)} {path}")))
      else:
        kept.append(f"keep {path}: the manifest has no checksum for the one before")
  if {("file", compat), ("file", dropin)} & (created.keys() | changed.keys()):
    steps.append(("reload systemd", "systemctl daemon-reload"))
  if ("linger", user) in created:
    steps.append((f"disable linger for {user}", f"loginctl disable-linger {q(user)}"))
  at_engine = f'[ "$(readlink {AGENT_LINK})" = {q(engine_entry(state))} ]'
  left = f'echo "  left {AGENT_LINK}: it no longer points at the engine"'
  if ("symlink", AGENT_LINK) in created:
    steps.append((f"remove {AGENT_LINK}", f"if {at_engine}; then rm -f {AGENT_LINK}; elif [ -L {AGENT_LINK} ] || [ -e {AGENT_LINK} ]; then {left}; fi"))
  elif ("symlink", AGENT_LINK) in changed:
    previous, backup = previous_of(changed[("symlink", AGENT_LINK)]), f"{home}/{BACKUP_DIR}/{BACKUPS[('symlink', AGENT_LINK)]}"
    target, sha = str(previous.get("target")), str(previous.get("sha256"))
    # What was there goes with the manifest and backups, so a link that can't go back fails the script to keep them.
    stuck = f'{left[:-1]}; put back what was there, then run uninstall again" >&2; failed=1'
    if previous.get("type") == "symlink" and HOME_RE.match(target):
      steps.append((f"point {AGENT_LINK} back at {target}", f'if [ "$(readlink {AGENT_LINK})" = {q(target)} ]; then :; '
                                                            f"elif {at_engine}; then ln -sfn {q(target)} {AGENT_LINK}; else {stuck}; fi"))
    elif previous.get("type") == "file" and SHA_RE.match(sha):
      put_back = f"if {at_engine}; then rm -f {AGENT_LINK} && cp {q(backup)} {AGENT_LINK}; else {stuck}; fi"
      steps.append((f"restore {AGENT_LINK} from {backup}", restore(AGENT_LINK, backup, sha, put_back)))
    else:
      kept.append(f"keep {AGENT_LINK}: the manifest doesn't say what was there before")
  steps += operator_steps(created, changed, user, kept)
  if ("package", "python3") in created:
    kept.append("keep python3: the system needs it, so it's never removed")
  packages = removable_packages(manifest)
  if packages and args.remove_packages:
    names, others = " ".join(packages), " ".join(f"-e {name}" for name in packages)
    steps.append((f"remove the packages {names}",
                  f'extra=$(LC_ALL=C apt-get -s remove {names} | sed -n "s/^Remv \\([^ :]*\\).*/\\1/p" | grep -vx {others} || true); '
                  f'if [ -n "$extra" ]; then echo "  kept {names}: apt would also remove" $extra >&2; failed=1; '
                  f"else DEBIAN_FRONTEND=noninteractive apt-get remove -y -qq {names}; fi"))
  elif packages:
    kept.append(f"keep the packages {' '.join(packages)} (the install added them; --remove-packages removes them)")
  return steps, kept


def operator_steps(created, changed, user, kept):
  """Puts the tailscale operator back to what it was, while it is still the user the install made it."""
  q, key = shlex.quote, ("operator", "tailscale")
  if key not in created and key not in changed:
    return []
  previous = "" if key in created else str(previous_of(changed[key]).get("operator"))
  if previous and not USER_RE.match(previous):
    kept.append("keep the tailscale operator: the manifest doesn't name a valid one before")
    return []
  now = "$(tailscale debug prefs | sed -n 's/.*\"OperatorUser\": *\"\\([^\"]*\\)\".*/\\1/p' | head -1)"
  what = f"set the tailscale operator back to {previous}" if previous else "clear the tailscale operator"
  return [(what, f'if ! command -v tailscale >/dev/null; then :; elif [ "{now}" = {q(user)} ]; then tailscale set --operator={previous}; '
                 f'else echo "  left the tailscale operator: it is no longer {user}"; fi')]


def step_script(steps, preamble=""):
  """A bash script that says each step, then runs it, and stops at the first that fails; a step that sets failed
  lets the others run, then fails the script."""
  lines = ["set -eu", "failed=0", preamble]
  for what, shell in steps:
    lines += ([f"echo {shlex.quote('  ' + what)}"] if what else []) + [shell]
  return "\n".join(lines + ['exit "$failed"']) + "\n"


SERVE_OFF = '''serve_off() {
  if ! out=$(tailscale serve --yes --set-path "$1" off 2>&1); then
    case ${out,,} in *"not found"*) ;; *) echo "$out" >&2; return 1;; esac
  fi
}'''
FINISH = f"rm -rf ~/{BACKUP_DIR} && rm -f {MANIFEST} ~/{UNINSTALL_IMAGES} && rmdir --ignore-fail-on-non-empty ~/{STARTDGX_DIR}\n"


def cmd_uninstall(args):
  host = ssh_target(args.host)
  manifest = read_manifest(host)
  if not manifest:
    raise Error(f"No install manifest on {host} ({MANIFEST}): startdgx install didn't set it up, or it's already uninstalled")
  if not isinstance(manifest, dict) or not isinstance(manifest.get("items"), list):
    raise Error(f"{host}:{MANIFEST} isn't an install manifest")
  state = uninstall_probe(host)
  pre = manifest.get("pre_state") or {}
  if (pre.get("user"), pre.get("home")) != (state["user"], state["home"]):
    raise Error(f"The manifest on {host} is for {pre.get('user')} ({pre.get('home')}), not {state['user']} ({state['home']})")
  user_steps, user_kept = user_plan(manifest, state, args)
  root_steps, root_kept = root_plan(manifest, state, args)
  if args.remove_packages and removable_packages(manifest):
    check_apt_removal(host, removable_packages(manifest))
  final = [f"delete {MANIFEST} and the backups", f"forget {host} here"]
  if args.dry_run and args.json:
    weights = state.get("models_bytes", "")
    print(json.dumps({
      "host": host,
      "steps": [what for what, _ in user_steps if what] + [f"as root: {what}" for what, _ in root_steps] + final,
      "kept": user_kept + root_kept,
      "manual": manual_steps(host),
      # What --delete-models would delete (None: nothing, or weights that are another engine's), and the packages
      # --remove-packages would remove.
      "models_bytes": int(weights) if ENGINE_DATA in state["exists"] and weights.isdigit() and engine_is_ours(manifest, state) else None,
      "packages": removable_packages(manifest),
      "recipes": ours_recipes(manifest, state),
    }))
    return
  if args.dry_run:
    print(f"Would, on {host}:")
    for what in [what for what, _ in user_steps if what] + [f"as root: {what}" for what, _ in root_steps] + final:
      print(f"  {what}")
    for what in user_kept + root_kept:
      print(f"  {what}")
    print_manual_steps(host)
    return
  # The manifest and backups go only once everything else has, so a rerun after a failure finds them.
  if engine_is_ours(manifest, state):
    print(f"Removing what the engine set up on {host}")
  elif user_steps:
    print(f"Putting back the engine that was on {host} before the install")
  run_steps(host, "user", step_script(user_steps, SERVE_OFF), args.timeout)
  if root_steps:
    print(f"Restoring {host} as root (sudo there asks for your password)")
    run_root(host, step_script(root_steps), ["startdgx-uninstall"], "Restoring")
  run_steps(host, "finish", FINISH, args.timeout)
  for what in user_kept + root_kept:
    print(f"  {what}")
  if ENGINE_DATA in state["exists"] and not args.delete_models and engine_is_ours(manifest, state):
    print(f"  to delete the weights later: ssh {host} rm -rf ~/{ENGINE_DATA}")
  print(f"Uninstalled from {host}")
  print_manual_steps(host)
  if host in load_hosts():
    cmd_remove_host(args)


def manual_steps(host):
  """What uninstall can't do from here: the paired clients and the host's SSH access are someone else's."""
  return [f"on each Omarchy machine paired with {host}, run: omarchy agent local forget <its tailnet name>",
          f"{host}:~/.ssh/authorized_keys still has the keys of the machines that reach it over SSH (this one, and any "
          "Omarchy machine that paired with it); remove their lines yourself if they shouldn't any more"]


def print_manual_steps(host):
  print("Left for you to do:")
  for step in manual_steps(host):
    print(f"  {step}")


def run_steps(host, phase, script, timeout):
  result = ssh_raw(host, f"bash -s -- startdgx-uninstall-{phase}", stdin=script, timeout=timeout, check=False)
  sys.stdout.write(result.stdout)
  sys.stderr.write(result.stderr)
  if result.returncode != 0:
    raise Error(f"Uninstall stopped on {host} (see above); run it again once that's fixed")


LAUNCHER = "omarchy-launch-floating-terminal-with-presentation"
# The commands launch may open a terminal on, and whether each takes a model.
LAUNCH_VERBS = {"install": False, "uninstall": False, "logs": True, "author": True}


def cmd_launch(args):
  """Opens a floating terminal on one of the commands that need one (sudo asks for a password in install and uninstall; author
  runs an agent). The launcher runs its argument as shell, so it is built only from checked words, each quoted."""
  if args.verb not in LAUNCH_VERBS:
    raise Error(f"launch: '{args.verb}' isn't one of {', '.join(LAUNCH_VERBS)}")
  if args.model and not LAUNCH_VERBS[args.verb]:
    raise Error(f"launch {args.verb} takes no model")
  if args.replace_engine and args.verb != "install":
    raise Error("--replace-engine goes only with launch install")
  if (args.delete_models or args.remove_packages or args.delete_recipes) and args.verb != "uninstall":
    raise Error("--delete-models, --remove-packages and --delete-recipes go only with launch uninstall")
  if args.verb == "author":
    # The model slot holds the Hugging Face repo; the terminal runs recipe author, so the draft's errors and the agent show there.
    if not valid_repo(args.model):
      raise Error("launch author takes a repo as OWNER/NAME")
    argv = [os.path.realpath(__file__), "recipe", "author", ssh_target(args.host), "--agent", "--here", "--", args.model]
    return open_terminal(argv)
  argv = [os.path.realpath(__file__), args.verb, ssh_target(args.host)]
  argv += [recipe(args.model)] if args.model else []
  argv += ["--replace-engine"] if args.replace_engine else []
  argv += ["--delete-models"] if args.delete_models else []
  argv += ["--remove-packages"] if args.remove_packages else []
  argv += ["--delete-recipes"] if args.delete_recipes else []
  open_terminal(argv)


def open_terminal(argv):
  if DEMO:
    print(f"Demo: would run '{shlex.join(argv[1:])}' in a terminal")
    return
  try:
    os.execvp(LAUNCHER, [LAUNCHER, shlex.join(argv)])
  except OSError as error:
    raise Error(f"Can't open a terminal with {LAUNCHER}: {error.strerror}") from error


def cmd_engine(args):
  if args.json:
    print(json.dumps({"repo": ENGINE_REPO, "tag": ENGINE_TAG}))
  else:
    print(f"{ENGINE_REPO} {ENGINE_TAG}")


# hf search: the anonymous Hugging Face API, read-only, on this computer (no host, no ssh). The base address is
# STARTDGX_HF_BASE: a URL, or a folder of fixtures (api/models.json, api/models/OWNER/NAME/tree/main.json and
# OWNER/NAME/raw/main/config.json) for tests; demo mode always uses the folder in demo/hf and never the network.
HF_DEFAULT_BASE = "https://huggingface.co"
HF_LIMIT = 50
HF_WORKERS = 8
HF_TIMEOUT = 20
HF_CACHE_SECONDS = 3600
KNOWN_FAMILIES = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "known-families.json")
HF_LABEL_RE = re.compile(r"abliterated|uncensored", re.I)


def hf_get(base, path, query=None, strict=True):
  """A JSON document from the Hugging Face API, or None when the repo has no such file. Errors: rate limited, offline,
  and (when strict) any other HTTP error; a per-repo fetch is not strict, so one broken repo is skipped."""
  if not hf_is_network(base):
    local = os.path.join(base.removeprefix("file://"), *path.split("/"))
    try:
      with open(local if local.endswith(".json") else local + ".json") as f:
        return json.load(f)
    except (OSError, ValueError):
      return None
  url = f"{base.rstrip('/')}/{path}" + (f"?{query}" if query else "")
  request = urllib.request.Request(url, headers={"User-Agent": "startdgx", "Accept": "application/json"})
  try:
    with urllib.request.urlopen(request, timeout=HF_TIMEOUT) as response:
      return json.load(response)
  except urllib.error.HTTPError as error:
    if error.code == 429:
      try:
        wait = max(1, -(-int(error.headers.get("Retry-After") or 60) // 60))
      except ValueError:
        wait = 1
      raise Error(f"Hugging Face is limiting requests, try again in {wait} minute{'s' if wait != 1 else ''}") from error
    if error.code in (401, 403, 404) or not strict:
      return None
    raise Error(f"Hugging Face answered {error.code}") from error
  except ValueError:
    return None
  except (urllib.error.URLError, OSError) as error:
    raise Error("Can't reach Hugging Face: check the network") from error


def hf_base():
  """Where the Hugging Face API is read from: the bundled fixtures in demo mode, else STARTDGX_HF_BASE, else Hugging Face."""
  return os.path.join(DEMO_FIXTURES, "hf") if DEMO else os.environ.get("STARTDGX_HF_BASE") or HF_DEFAULT_BASE


def hf_is_network(base):
  return bool(re.match(r"^https?://", base))


def valid_repo(repo):
  """Whether `repo` is a Hugging Face OWNER/NAME that is safe in a URL and a path (no part of only dots)."""
  return isinstance(repo, str) and bool(DRAFT_REPO_RE.fullmatch(repo)) and not any(set(part) == {"."} for part in repo.split("/"))


def hf_known_families():
  with open(KNOWN_FAMILIES) as f:
    return set(json.load(f)["families"])


def hf_is_affine_4bit(config):
  quantization = config.get("quantization") if isinstance(config, dict) else None
  return isinstance(quantization, dict) and quantization.get("mode") == "affine" and quantization.get("bits") == 4


def hf_passes_find(config, known):
  """Whether a repo's config.json is what Find lists: MLX affine 4-bit of an architecture in `known`."""
  archs = config.get("architectures") if isinstance(config, dict) else None
  return hf_is_affine_4bit(config) and isinstance(archs, list) and bool(known.intersection(a for a in archs if isinstance(a, str)))


def hf_weights_bytes(tree):
  """The size of a repo's .safetensors files, from its file tree; 0 when it lists none."""
  return sum(e["size"] for e in (tree if isinstance(tree, list) else []) if isinstance(e, dict) and str(e.get("path", "")).endswith(".safetensors") and isinstance(e.get("size"), int))


def hf_base_model(card):
  """The card's base model (the first of a list), or None."""
  base_model = card.get("base_model")
  return (base_model[0] if base_model else None) if isinstance(base_model, list) else base_model


def hf_row(base, item):
  """A listing item whose config passed, as its row; the weights' size is the repo's .safetensors files."""
  repo = item["id"]
  card = item.get("cardData") or {}
  tree = hf_get(base, f"api/models/{repo}/tree/main", strict=False)
  label = HF_LABEL_RE.search(" ".join([repo, *(item.get("tags") or [])]))
  return {"repo": repo, "params": (item.get("safetensors") or {}).get("total"),
          "size_bytes": hf_weights_bytes(tree) or None,
          "license": card.get("license"), "base_model": hf_base_model(card), "label": label.group(0).lower() if label else None}


def hf_search(base, query):
  known = hf_known_families()
  fields = "".join(f"&expand[]={f}" for f in ("safetensors", "gated", "cardData", "tags"))
  listing = hf_get(base, "api/models", f"filter=mlx&search={urllib.parse.quote(query)}&limit={HF_LIMIT}&sort=downloads&direction=-1{fields}")
  if not isinstance(listing, list):
    raise Error("Hugging Face gave an answer startdgx can't read")
  items = [i for i in listing if isinstance(i, dict) and valid_repo(i.get("id")) and not i.get("gated")]

  def check(item):
    config = hf_get(base, f"{item['id']}/raw/main/config.json", strict=False)
    return hf_row(base, item) if hf_passes_find(config, known) else None

  with concurrent.futures.ThreadPoolExecutor(HF_WORKERS) as pool:
    return [row for row in pool.map(check, items) if row]


def hf_line(row):
  size = f"{row['size_bytes'] / 2**30:.1f} GiB" if row["size_bytes"] else "-"
  params = f"{row['params'] / 1e9:.1f}B" if row["params"] else "-"
  cells = [row["repo"], params, size, row["license"] or "-", row["base_model"] or "-"] + ([f"[{row['label']}]"] if row["label"] else [])
  return "  ".join(cells)


def hf_cache_file(base, query):
  root = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
  return os.path.join(root, "startdgx", "hf-search", hashlib.sha256(f"{base}\n{query}".encode()).hexdigest() + ".json")


def hf_cached_search(base, query):
  """The rows for a query, from the last hour's answer when there is one (network bases only; STARTDGX_HF_NOW holds the
  clock, in seconds, for tests). Only a good answer is cached, never a failure."""
  if not hf_is_network(base):
    return hf_search(base, query)
  now = float(os.environ.get("STARTDGX_HF_NOW") or time.time())
  path = hf_cache_file(base, query)
  try:
    with open(path) as f:
      cached = json.load(f)
    if isinstance(cached.get("rows"), list) and 0 <= now - cached["at"] < HF_CACHE_SECONDS:
      return cached["rows"]
  except (OSError, ValueError, KeyError, TypeError, AttributeError):
    pass
  rows = hf_search(base, query)
  try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as f:
      json.dump({"at": now, "rows": rows}, f)
    os.replace(path + ".tmp", path)
  except OSError:
    pass
  return rows


def cmd_hf_search(args):
  rows = hf_cached_search(hf_base(), args.query)
  if args.json:
    print(json.dumps(rows))
  elif rows:
    print("\n".join(hf_line(row) for row in rows))
  else:
    print("No known-family MLX 4-bit repos matched", file=sys.stderr)


# recipe draft: a complete user recipe for one repo that passes the same checks as a search row, in the shape of the curated
# TensorFold MLX recipes. Every value comes from the Hugging Face API (the pinned commit, the license, the weights' size); the
# variant is `drafted` with its memory placeholders equal to the weights' size, which never count as fitting (ADR 0001).
DRAFT_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
DRAFT_CTX = 8192
DRAFT_FILES = ["*.safetensors", "*.json", "chat_template.jinja", "vocab.json"]
# What a card's license may be to go into a draft: a license id, never free text (it is written into a file the engine reads).
DRAFT_LICENSE_RE = re.compile(r"[A-Za-z0-9._+-]{1,64}")
DRAFT_FREE_LICENSES = re.compile(r"^(apache-2\.0|mit|isc|unlicense|cc0-1\.0|cc-by-4\.0|bsd(-[0-9a-z]+)*|bsl-1\.0|mpl-2\.0)$")
DRAFT_TEMPLATE = """# Drafted by startdgx from {repo}. The memory numbers are placeholders equal to the weights' size and the variant is
# `drafted`, so it never counts as fitting: measure it (recipe measure) or confirm numbers of your own.
name = {name}
summary = {summary}
runtime = "tensorfold"
{vision_input}
[[hardware]]
gpu = "nvidia-gb10"
ram_class = 128

# MLX affine 4-bit export. The server loads the directory.
[[artifacts]]
repo = {repo_q}
revision = "{revision}"
license = {license}
files = {files}
dest = "target"
model = "."

[[variant]]
ctx = {ctx}
peak_ram_gib = {gib}
peak_gpu_gib = {gib}
source = "drafted"
{vision_server}"""


# A repo with a vision_config gets what the curated vision recipes declare: the image input, and the server arguments that load the
# vision tower (TensorFold's --vision, with the curated recipes' limit of 50 images a request). The runtime needs nothing more.
DRAFT_VISION_INPUT = '# Screenshots and photos through the checkpoint\'s vision tower, which --vision loads.\ninput = ["text", "image"]\n'
DRAFT_VISION_SERVER = '\n[server]\nargs = ["--vision", "--vision-max-images", "50"]\n'


def draft_id(repo):
  slug = re.sub(r"[^a-z0-9.]+", "-", repo.split("/", 1)[1].lower())
  slug = re.sub(r"(-\.|\.-|\.\.)+", "-", slug).strip("-.")
  return slug if slug.endswith("tensorfold") else f"{slug}-tensorfold"


def draft_name(repo):
  name = re.sub(r"[-_ ]*MLX[-_ ]*4-?bit.*$", "", repo.split("/", 1)[1], flags=re.I) or repo.split("/", 1)[1]
  return re.sub(r"[-_]+", " ", name).strip()


def draft_license(info):
  card = info.get("cardData") or {}
  value = card.get("license")
  if not isinstance(value, str) or not value.strip():
    value = next((t[len("license:"):] for t in info.get("tags") or [] if isinstance(t, str) and t.startswith("license:")), None)
  return value.strip() if isinstance(value, str) and DRAFT_LICENSE_RE.fullmatch(value.strip()) else None


def toml_str(value):
  """A TOML basic string: JSON's escapes are TOML's, except that TOML forbids a raw DEL and rejects the surrogate pairs JSON
  makes of characters beyond the BMP, so the text is kept as it is (the file is UTF-8)."""
  return json.dumps(value, ensure_ascii=False).replace("\x7f", "\\u007f")


def draft_marker(path):
  return os.path.join(os.path.dirname(path), f".{os.path.basename(path)}.sha256")


def draft_unedited(path):
  """Whether `path` is a draft startdgx wrote and nobody has changed since (its text still has the hash it recorded)."""
  try:
    if os.path.islink(path):
      return False
    with open(draft_marker(path), encoding="ascii") as marker, open(path, "rb") as draft:
      return marker.read().strip() == hashlib.sha256(draft.read()).hexdigest()
  except OSError:
    return False


def draft_discard(path):
  """Removes a draft startdgx wrote and nobody edited, with its hash: a try that failed afterwards leaves nothing to block a retry."""
  if draft_unedited(path):
    for name in (path, draft_marker(path)):
      with contextlib.suppress(OSError):
        os.remove(name)


def hf_draft_source(base, repo):
  """(commit sha, license or None, weights' bytes) of a repo that passes the checks a search row passes, else an Error."""
  info = hf_get(base, f"api/models/{repo}")
  if not isinstance(info, dict) or info.get("id") != repo:
    raise Error(f"{repo} wasn't found on Hugging Face (or needs a login)")
  if info.get("gated"):
    raise Error(f"{repo} is gated: startdgx doesn't use Hugging Face tokens, so it can't download it")
  config = hf_get(base, f"{repo}/raw/main/config.json")
  if not hf_passes_find(config, hf_known_families()):
    raise Error(f"{repo} is outside what Find on Hugging Face lists: its config.json must say MLX affine 4-bit of a known family")
  sha = info.get("sha")
  if not isinstance(sha, str) or not re.match(r"^[0-9a-f]{40}$", sha):
    raise Error(f"Hugging Face gave no commit for {repo}")
  size = hf_weights_bytes(hf_get(base, f"api/models/{repo}/tree/main"))
  if not size:
    raise Error(f"{repo} has no .safetensors weights")
  return sha, draft_license(info), size, config


DRAFT_DRAFTER_RE = re.compile(r"draft|eagle|mtp|speculat", re.I)


def draft_judgement(repo, config):
  """What in this repo the template can't settle, so an agent should look: ["drafter", "server"]. A vision_config is not one:
  the template sets the image input and the vision server arguments itself."""
  why = []
  nextn = config.get("num_nextn_predict_layers")
  if DRAFT_DRAFTER_RE.search(repo.split("/", 1)[1]) or (isinstance(nextn, int) and nextn > 0):
    why.append("drafter")
  if config.get("rope_scaling"):
    why.append("server")
  return why


JUDGEMENT_TEXT = {"drafter": "it is, or carries, a speculative drafter (the template has no field for one)",
                  "server": "its config scales positions (rope_scaling), which may need server arguments the template cannot set"}


def draft_host_ids(host):
  """The ids a machine has, curated and the user's."""
  if DEMO:
    with demo_state() as state:
      return {r["id"] for r in demo_host(state, host)["list"]}
  try:
    rows = json.loads(ssh(target(host), "recipe", "list", "--json", timeout=60).stdout)
    return {r["id"] for r in rows}
  except (ValueError, KeyError, TypeError) as error:
    raise Error(f"{host} gave a recipe list startdgx can't read") from error


def draft_validate(host, rid, text):
  """The host's engine validates the draft (as the Add recipe path does), else an Error with its errors."""
  result = demo_recipe_check(host, "validate", rid, text) if DEMO else recipe_send(target(host), "validate", rid, text, 60)
  if not result["ok"]:
    raise Error(f"{host}'s engine rejects the draft: " + "; ".join(result["errors"]))


def draft_recipe(args, replace=False):
  """Writes the draft and returns its result dict, for cmd_recipe_draft and cmd_recipe_author. With a host, the host's engine
  validates it first, and a draft it rejects is removed. `replace` lets it take the place of a draft startdgx wrote and nobody
  edited, so a try that failed afterwards can be repeated; any other file in the way is never touched."""
  repo = args.repo
  if not valid_repo(repo):
    raise Error("Name the repo as OWNER/NAME, e.g. TensorFold/Qwen3.8-27B-MLX-4bit")
  rid = args.id or draft_id(repo)
  if not RID_RE.match(rid):
    raise Error(f"'{rid}' can't be a recipe id (lower-case letters, digits, dots and dashes): pick one with --id")
  sha, license_id, size, config = hf_draft_source(hf_base(), repo)
  if args.host and rid in draft_host_ids(args.host):
    raise Error(f"{args.host} already has a recipe '{rid}' (curated or yours): pick another id with --id")
  out = args.out or os.path.join(demo_dir() if DEMO else os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                                                                       "startdgx"), "drafts")
  path = os.path.join(out, f"{rid}.toml")
  if os.path.lexists(path) and not (replace and draft_unedited(path)):
    raise Error(f"{path} already exists: pick another id with --id, or delete the file")
  gib = -(-size * 10 // 2**30) / 10
  warnings = []
  if license_id is None:
    warnings.append("License unknown: Hugging Face reports none startdgx can use for this repo, so read its model card before you use it")
  elif not DRAFT_FREE_LICENSES.match(license_id.lower()):
    warnings.append(f"License '{license_id}' may restrict use: read its terms before you use it")
  vision = bool(config.get("vision_config"))
  text = DRAFT_TEMPLATE.format(repo=repo, name=toml_str(draft_name(repo)), repo_q=toml_str(repo), revision=sha,
                               summary=toml_str(f"Drafted from {repo}: MLX 4-bit on TensorFold. The memory numbers are placeholders until it is measured."),
                               license=toml_str(license_id or "unknown"), files=toml_str(DRAFT_FILES), ctx=DRAFT_CTX, gib=gib,
                               vision_input=DRAFT_VISION_INPUT if vision else "", vision_server=DRAFT_VISION_SERVER if vision else "")
  data = text.encode("utf-8")
  try:
    os.makedirs(out, exist_ok=True)
    if os.path.lexists(path):
      os.remove(path)
    with open(path, "xb") as handle:
      handle.write(data)
    with open(draft_marker(path), "w", encoding="ascii") as marker:
      marker.write(hashlib.sha256(data).hexdigest() + "\n")
  except OSError as error:
    for name in (path, draft_marker(path)):
      with contextlib.suppress(OSError):
        os.remove(name)
    raise Error(f"{path} can't be written: {error.strerror}") from error
  if args.host:
    try:
      draft_validate(args.host, rid, text)
    except Error:
      draft_discard(path)
      raise
  result = {"ok": True, "id": rid, "repo": repo, "path": path, "revision": sha, "license": license_id or "unknown", "weights_bytes": size,
            "placeholder_gib": gib, "source": "drafted", "warnings": warnings, "judgement": draft_judgement(repo, config)}
  return result


def print_draft(result):
  print(f"Drafted {result['id']} from {result['repo']} at {result['revision'][:12]}: {result['path']}")
  print(f"  license {result['license']}; weights {size_text(result['weights_bytes'])}; the variant is drafted, with {result['placeholder_gib']} GiB placeholders that never count as fitting")
  for warning in result["warnings"]:
    print(f"  Warning: {warning}")


def cmd_recipe_draft(args):
  result = draft_recipe(args, replace=True)
  if args.json:
    print(json.dumps(result))
    return
  print_draft(result)
  print(f"  next: startdgx recipe add HOST {result['path']}")


# recipe author: the draft, then an agent for what needs judgement (or on request). The agent runs in Omarchy's floating terminal, the
# same launcher `launch` uses, and is given the authoring brief (a plain-text file at the plugin root: the installer drops docs/ and
# *.md) with the host, the repo and the draft's path. The command is `agent_command` in ~/.config/startdgx/config.json (default claude).
AUTHOR_BRIEF = os.path.join(os.path.dirname(os.path.realpath(__file__)), os.pardir, "recipe-authoring-brief.txt")
DEFAULT_AGENT_COMMAND = "claude"


def agent_command():
  path = os.path.join(config_dir(), "config.json")
  try:
    with open(path, encoding="utf-8") as handle:
      value = json.load(handle).get("agent_command", DEFAULT_AGENT_COMMAND)
  except FileNotFoundError:
    return shlex.split(DEFAULT_AGENT_COMMAND)
  except (OSError, ValueError, AttributeError) as error:
    raise Error(f"{path} can't be read as a JSON object") from error
  try:
    words = shlex.split(value) if isinstance(value, str) else []
  except ValueError:
    words = []
  if not words:
    raise Error(f"agent_command in {path} must be a command line, e.g. \"claude\"")
  return words


def author_prompt(host, result):
  try:
    with open(AUTHOR_BRIEF, encoding="utf-8") as handle:
      brief = handle.read()
  except OSError as error:
    raise Error(f"The authoring brief {os.path.normpath(AUTHOR_BRIEF)} can't be read: {error.strerror}") from error
  why = "; ".join(f"{w}: {JUDGEMENT_TEXT[w]}" for w in result["judgement"]) or "none found by the template; the person asked for you"
  return (f"{brief}\nTHIS TASK\nHost: {host}\nRepo: {result['repo']}\nDraft: {result['path']} (recipe id {result['id']})\n"
          f"Why you were started: {why}\n")


def cmd_recipe_author(args):
  agent = agent_command()
  result = draft_recipe(args)
  run = args.agent or bool(result["judgement"])
  if args.json:
    print(json.dumps(dict(result, agent=run)))
  else:
    print_draft(result)
    for w in result["judgement"]:
      print(f"  Needs judgement: {JUDGEMENT_TEXT[w]}")
  if not run:
    if not args.json:
      print(f"  next: startdgx recipe add {args.host} {result['path']}, or start an agent on it: startdgx recipe author {args.host} {args.repo} --id {result['id']} --agent")
    return
  try:
    argv = agent + [author_prompt(args.host, result)]
    if DEMO:
      print(f"Demo: would run '{shlex.join(argv)}' in a terminal")
      return
    sys.stdout.flush()
    try:
      if args.here:
        os.execvp(argv[0], argv)
      os.execvp(LAUNCHER, [LAUNCHER, shlex.join(argv)])
    except OSError as error:
      raise Error(f"Can't start {argv[0] if args.here else LAUNCHER}: {error.strerror}") from error
  except Error:
    draft_discard(result["path"])  # no agent ever saw it, so a retry is not blocked by it
    raise


# Demo mode (STARTDGX_DEMO=1, or the marker file ~/.config/startdgx/demo/ENABLED): the commands serve the fixtures in
# demo/ and change a copy of them under $XDG_STATE_HOME/startdgx-demo, so the panel can be clicked through, and no
# process is ever run. Starts, stops, setups and removals take effect over time, as on a real host: each row is
# advanced from its timestamps whenever it is read, and only the commands that change something write.
DEMO = False
DEMO_FIXTURES = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "demo")
DEMO_RATE = 1_200_000_000  # bytes a second that a demo setup downloads at
DEMO_WAIT_MS = 2000  # how long a demo setup waits before it downloads, as the engine's waits for its lock and unit


def demo_enabled():
  return os.environ.get("STARTDGX_DEMO") == "1" or os.path.exists(os.path.join(config_dir(), "demo", "ENABLED"))


def demo_dir():
  base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
  return os.path.join(base, "startdgx-demo")


def demo_now_ms():
  """The demo's clock; STARTDGX_DEMO_NOW (seconds since the epoch) holds it still, for tests."""
  return int(float(os.environ.get("STARTDGX_DEMO_NOW") or time.time()) * 1000)


def wall():
  """Makes every way to run a process fail with an Error, so a hole in demo mode can't reach a machine."""
  def refused(name):
    def run(*args, **kwargs):
      raise Error(f"demo mode runs nothing ({name})")
    return run
  for name in ("run", "Popen", "call", "check_call", "check_output", "getoutput", "getstatusoutput"):
    setattr(subprocess, name, refused(f"subprocess.{name}"))
  for name in [n for n in dir(os) if n.startswith(("exec", "spawn", "posix_spawn"))] + ["system", "popen", "fork", "forkpty"]:
    if callable(getattr(os, name, None)):
      setattr(os, name, refused(f"os.{name}"))


def read_fixture(*path):
  with open(os.path.join(DEMO_FIXTURES, *path)) as f:
    return json.load(f)


def write_json(path, doc):
  tmp = f"{path}.{os.getpid()}.tmp"
  with open(tmp, "w") as f:
    json.dump(doc, f, indent=2)
    f.write("\n")
  os.replace(tmp, path)


@contextlib.contextmanager
def demo_state(write=False):
  """The demo's machines by short name, each {status, list}; seeded from the fixtures on first use. A machine with
  no state doesn't answer."""
  folder = demo_dir()
  os.makedirs(folder, exist_ok=True)
  with open(os.path.join(folder, ".lock"), "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    path = os.path.join(folder, "state.json")
    try:
      with open(path) as f:
        state = json.load(f)
    except FileNotFoundError:
      state, write = demo_seed(folder), True
    yield state
    if write:
      write_json(path, state)


def demo_seed(folder):
  now = demo_now_ms()
  if not os.path.exists(os.path.join(folder, "hosts.json")):
    write_json(os.path.join(folder, "hosts.json"), read_fixture("hosts.json"))
  state = {"hosts": {}}
  for name in sorted(os.listdir(os.path.join(DEMO_FIXTURES, "hosts"))):
    status, listing = read_fixture("hosts", name, "status.json"), read_fixture("hosts", name, "list.json")
    for rid, row in status["models"].items():
      if row["unit"] == "installing":
        row["since_ms"] = row["since_ms"] or now
        row["_progress_ms"] = now
        row["_then"] = demo_model_row(status, listing, rid)
      elif row["unit"] in ("activating", "deactivating", "removing"):
        row["since_ms"] = row["since_ms"] or now
    # A machine with the file needs-setup has an engine startdgx didn't install, and isn't set up as root.
    needs_setup = os.path.exists(os.path.join(DEMO_FIXTURES, "hosts", name, "needs-setup"))
    state["hosts"][name] = {"status": status, "list": listing, **({"needs_setup": True} if needs_setup else {})}
  return state


def demo_model_row(status, listing, rid):
  """An installed model's row, as the engine's model_record shapes it, for a recipe in the listing; loading."""
  r = next(r for r in listing if r["id"] == rid)
  port = max([row["port"] for row in status["models"].values() if row.get("port")] or [11429]) + 1
  digest = hashlib.sha256(rid.encode()).hexdigest()
  return {"error": "", "fits": True, "fit_reason": "", "shared": False, "recipe": rid, "name": r["name"], "vendor": r["vendor"],
          "runtime": r["runtime"], "image": f"ghcr.io/omacom/{r['runtime']}@sha256:{digest}", "ctx": r["context"],
          "unit": "activating", "sub_state": "start", "result": "success", "port": port, "endpoint": f"http://127.0.0.1:{port}/v1",
          "observed": None, "ram_total_gib": status["ram_total_gib"], "since_ms": None, "expected_load_seconds": 6.0,
          "expected_stop_seconds": 2.0, "expected_remove_seconds": None,
          "_observed": {"load_seconds": 6.0, "ram_used_gib": round((r.get("memory_gib") or 30) * 0.3, 1), "gpu_used_gib": 0.0}}


def demo_advance(row, now):
  """The row as it is at `now`: a download grows, then loads; a load, stop or removal ends once its time is up."""
  row = json.loads(json.dumps(row))
  if row["unit"] == "installing" and row["install"]["phase"] == "waiting":
    begins = (row.get("since_ms") or now) + DEMO_WAIT_MS
    if now < begins:
      return row
    row["install"].update(phase="downloading", rate_bytes_s=DEMO_RATE)
    row["_progress_ms"] = begins
  if row["unit"] == "installing" and row["install"]["phase"] == "downloading":
    install, since = row["install"], row.get("_progress_ms", now)
    left = install["total_bytes"] - install["done_bytes"]
    if install["rate_bytes_s"] * (now - since) // 1000 < left:
      install["done_bytes"] += install["rate_bytes_s"] * (now - since) // 1000
      row["_progress_ms"] = now
      return row
    row = {**row["_then"], "since_ms": since + left * 1000 // max(install["rate_bytes_s"], 1)}
  elapsed = now - (row.get("since_ms") or now)
  if row["unit"] == "activating" and elapsed >= row["expected_load_seconds"] * 1000:
    row.update(unit="active", sub_state="running", since_ms=None, observed=row.get("observed") or row.get("_observed"))
  elif row["unit"] == "deactivating" and elapsed >= (row["expected_stop_seconds"] or 2) * 1000:
    row.update(unit="inactive", sub_state="dead", since_ms=None)
  elif row["unit"] == "removing" and elapsed >= (row["expected_remove_seconds"] or 3) * 1000:
    return None
  return row


def demo_host(state, host):
  """The added host's state, advanced to now; one without state doesn't answer, as an unreachable host doesn't."""
  machine = state["hosts"].get(target(host).rsplit("@", 1)[-1])
  if machine is None:
    raise Error(f"{host} didn't answer in time")
  now = demo_now_ms()
  machine["status"]["models"] = {rid: row for rid, row in ((rid, demo_advance(row, now)) for rid, row in machine["status"]["models"].items())
                                 if row is not None}
  return machine


def public(row):
  return {key: value for key, value in row.items() if not key.startswith("_")}


def demo_status(args):
  with demo_state() as state:
    status = demo_host(state, args.host)["status"]
  print(json.dumps({**status, "models": {rid: public(row) for rid, row in status["models"].items()}}, indent=2))


def demo_list(args):
  with demo_state() as state:
    machine = demo_host(state, args.host)
  models = machine["status"]["models"]
  print(json.dumps([{"user": False, "source": "measured", **public(r), "installed": r["id"] in models and models[r["id"]]["unit"] != "installing",
                     "active": models.get(r["id"], {}).get("unit") == "active"} for r in machine["list"]], indent=2))


def demo_set_up(models, rid):
  row = models.get(recipe(rid))
  if row is None or row["unit"] == "installing":
    raise Error(f"{rid} isn't set up. Run: omarchy agent local use {rid}")
  return row


def demo_start(args):
  with demo_state(write=True) as state:
    status = demo_host(state, args.host)["status"]
    row = demo_set_up(status["models"], args.model)
    if row["unit"] in ("deactivating", "removing"):
      raise Error(f"{args.model} is {'stopping' if row['unit'] == 'deactivating' else 'being removed'}")
    if row["unit"] not in ("active", "activating"):
      if row["fits"] is False:
        raise Error(f"Not enough memory to start model {args.model}: stop another model first")
      row.update(unit="activating", sub_state="start", result="success", error="", since_ms=demo_now_ms())
    status["last"] = args.model
  demo_wait_loaded(args)
  print(f"Started {args.model} at {row['endpoint']}")


def demo_wait_loaded(args):
  """Returns once the model has loaded, as the engine's start does, with the state unlocked meanwhile so a stop
  can come; a model that stops loading (a stop) didn't start. A clock held still (STARTDGX_DEMO_NOW) never moves,
  so then it returns at once."""
  if os.environ.get("STARTDGX_DEMO_NOW"):
    return
  deadline = time.monotonic() + (args.timeout or 600)
  while True:
    with demo_state() as state:
      unit = demo_host(state, args.host)["status"]["models"].get(args.model, {}).get("unit")
    if unit == "active":
      return
    if unit != "activating":
      raise Error(f"{args.model} didn't start: it stopped while it loaded")
    if time.monotonic() >= deadline:
      raise Error(f"{args.host} didn't answer in time")
    time.sleep(0.2)


def demo_stop(args):
  with demo_state(write=True) as state:
    models = demo_host(state, args.host)["status"]["models"]
    if args.model:
      demo_set_up(models, args.model)
    targets = [args.model] if args.model else [rid for rid, row in models.items() if row["unit"] in ("active", "activating")]
    for rid in targets:
      if models[rid]["unit"] in ("active", "activating"):
        models[rid].update(unit="deactivating", sub_state="stop-sigterm", since_ms=demo_now_ms())
  print(f"Stopped {', '.join(targets)}" if targets else "No local model is running")


def demo_share(args):
  rid = recipe(args.model)
  with demo_state(write=True) as state:
    demo_set_up(demo_host(state, args.host)["status"]["models"], rid)["shared"] = not args.off
  print(f"{rid} is no longer shared" if args.off else f"Sharing {rid} on your tailnet (demo)")


def demo_use(args):
  rid = recipe(args.model)
  unit = f"omarchy-agent-local-use-{rid}.service"
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    status, models = machine["status"], machine["status"]["models"]
    r = next((r for r in machine["list"] if r["id"] == rid), None)
    if r is None:
      raise Error(f"No recipe {rid} in the catalog")
    if models.get(rid, {}).get("unit") == "installing":
      print(f"{rid} is already being set up; follow it with: journalctl --user -u {unit} -f")
      return
    if rid in models and args.ctx:
      # A context for a model already set up restarts it with that one, as the engine's re-run of use does.
      if args.ctx not in {v["ctx"] for v in demo_variants_of(machine, rid)}:
        raise Error(f"No measured variant with ctx {args.ctx}")
      now = demo_now_ms()
      models[rid].update(ctx=args.ctx, unit="activating", sub_state="start", result="success", since_ms=now,
                         observed=None, _observed=models[rid].get("observed") or models[rid].get("_observed"))
      print(f"Restarting {rid} with the new setup (its in-flight requests are interrupted)")
      return
    if rid in models:
      raise Error(f"{rid} is already set up: start it with startdgx start {args.host} {rid}")
    if r.get("user") and not args.yes:
      # The engine's own refusal: a recipe of yours downloads what it names and runs it.
      raise Error(f"{rid} is a recipe of yours, so it isn't set up without your say-so: it downloads what the recipe names and runs it. "
                  f"Review it (omarchy agent local measure {rid} --ctx N shows the download size), then run: omarchy agent local use {rid} --yes")
    if not r["available"]:
      raise Error(r["reason"] or f"{rid} can't run on {args.host}")
    if machine.get("needs_setup"):
      # The engine's prepare_host, on a machine whose engine startdgx didn't install and that isn't set up as root.
      raise Error("This machine needs Podman set up as root first: run this same command once in a terminal, where sudo can ask for your password")
    now = demo_now_ms()
    models[rid] = {"error": "", "fits": True, "fit_reason": "", "recipe": rid, "name": r["name"], "vendor": r["vendor"], "runtime": "",
                   "image": "", "ctx": None, "unit": "installing", "sub_state": "", "result": "", "port": None, "endpoint": "",
                   "observed": None, "since_ms": now, "expected_load_seconds": 6.0, "expected_stop_seconds": None,
                   "expected_remove_seconds": None,
                   "install": {"phase": "waiting", "done_bytes": 0, "total_bytes": int((r.get("memory_gib") or 30) * 2**29),
                               "rate_bytes_s": 0},
                   "_progress_ms": now, "_then": demo_model_row(status, machine["list"], rid)}
  print(f"Setting up {rid} in the background; the agents panel shows its progress, or follow it with: journalctl --user -u {unit} -f")


def demo_variants_of(machine, rid):
  """A demo recipe's measured contexts, made from its listing row: the listed context, then half and a quarter of it,
  each needing less memory."""
  r = next((r for r in machine["list"] if r["id"] == rid), None)
  if r is None:
    raise Error(f"{rid} isn't in the catalog")
  if r.get("_variants"):
    return [{**v, "confirmed": v["source"] == "estimated" and bool(r.get("_confirmed"))} for v in sorted(r["_variants"], key=lambda v: -v["ctx"])]
  ctx, ram = int(r.get("context") or 131072), float(r.get("memory_gib") or 30)
  return [{"ctx": ctx // 2**n, "peak_ram_gib": round(ram * (1 - 0.15 * n), 1), "peak_gpu_gib": round(ram * (1 - 0.15 * n) - 2, 1), "source": "measured", "confirmed": False}
          for n in range(3)]


def demo_variants(args):
  rid = recipe(args.model)
  with demo_state() as state:
    machine = demo_host(state, args.host)
  print_variants(demo_variants_of(machine, rid), args.json)


# ---- user recipes, in the demo -----------------------------------------------------------------------------
# The demo engine checks a recipe file against rules of its own that look like the fork's validate_recipe (they are not
# it): a name, a summary, a runtime the machine's catalog has, and variants with a context, memory and a known source. The
# messages and Error: forms are the engine's. A user recipe is a row of the machine's list, with its variants in
# `_variants`, which the listing doesn't show.
VARIANT_SOURCES = ("measured", "estimated", "drafted")


def demo_recipe_errors(machine, rid, text):
  """The demo engine's errors for a recipe file's text, one per entry: [] when it is valid."""
  try:
    recipe_toml = tomllib.loads(text)
  except tomllib.TOMLDecodeError as error:
    return [f"recipes/{rid}: not valid TOML: {error}"]
  if any(r["id"] == rid and not r.get("user") for r in machine["list"]):
    return [f"recipes/{rid}: id clashes with the curated recipe '{rid}'; a user recipe never shadows one, pick another id"]
  errors = [f"recipes/{rid}: missing {key}" for key in ("name", "summary") if not str(recipe_toml.get(key, "")).strip()]
  runtimes = {r["runtime"] for r in machine["list"]}
  if not recipe_toml.get("runtime"):
    errors.append(f"recipes/{rid}: missing runtime")
  elif recipe_toml["runtime"] not in runtimes:
    errors.append(f"recipes/{rid}: runtime '{recipe_toml['runtime']}' isn't one of this engine's: {', '.join(sorted(runtimes))}")
  variants = recipe_toml.get("variant", [])
  if not isinstance(variants, list) or not variants:
    errors.append(f"recipes/{rid}: needs at least one [[variant]]")
    variants = []
  for i, v in enumerate(variants, 1):
    if not isinstance(v.get("ctx"), int) or v["ctx"] <= 0:
      errors.append(f"recipes/{rid}: variant {i}: ctx must be a positive whole number")
    for key in ("peak_ram_gib", "peak_gpu_gib"):
      if not isinstance(v.get(key), (int, float)) or v[key] <= 0:
        errors.append(f"recipes/{rid}: variant {i}: {key} must be a positive number")
    if v.get("source", "measured") not in VARIANT_SOURCES:
      errors.append(f"recipes/{rid}: variant {i}: source must be one of {', '.join(VARIANT_SOURCES)}")
    elif v.get("source", "measured") == "measured":
      # The engine's guard: only its measuring run writes measured numbers; a missing source means measured.
      errors.append(f"recipes/{rid}.variant[{i - 1}].source: a recipe of yours can't claim measured numbers (only `measure` writes them); "
                    'set source = "estimated" or source = "drafted"')
  return errors


def demo_recipe_row(rid, recipe_toml):
  """A user recipe's listing row: it runs the largest variant that isn't drafted (a drafted one never fits; an estimated
  one waits for a confirmation the engine asks for)."""
  variants = sorted(({"ctx": v["ctx"], "peak_ram_gib": float(v["peak_ram_gib"]), "peak_gpu_gib": float(v["peak_gpu_gib"]),
                      "source": v.get("source", "measured")} for v in recipe_toml["variant"]), key=lambda v: -v["ctx"])
  top = next((v for v in variants if v["source"] == "measured"), None)
  shown = top or next((v for v in variants if v["source"] == "estimated"), variants[0])
  if top is None and shown["source"] == "estimated" and recipe_toml.get("_confirmed"):
    top = shown
  reason = "" if top else (f"{rid}'s numbers are estimated: confirm them once with recipe confirm before it counts as fitting"
                           if shown["source"] == "estimated" else f"{rid}'s variants are drafted: they never count as fitting until measured")
  return {"id": rid, "name": recipe_toml["name"], "summary": recipe_toml["summary"], "runtime": recipe_toml["runtime"], "tier": "third-party",
          "publisher": "You", "vendor": recipe_toml.get("vendor", ""), "architecture": recipe_toml.get("architecture", ""),
          "user": True, "source": shown["source"], "installed": False, "available": top is not None, "reason": reason, "best": False,
          "active": False, "memory_gib": shown["peak_ram_gib"], "context": shown["ctx"], "decode_tok_s": None, "prefill_tok_s": None,
          "_variants": variants, **({"_confirmed": True} if recipe_toml.get("_confirmed") else {})}


def demo_recipe_in_use(machine, rid):
  row = machine["status"]["models"].get(rid)
  return None if row is None else f"Recipe {rid} is used by the model {rid} ({row['name']}) set up here; remove it first with: omarchy agent local remove {rid}"


def demo_recipe_check(host, verb, rid, text):
  """The demo engine's validate or add of a recipe's text on a demo host, as recipe_result's dict."""
  adding = verb == "add"
  with demo_state(write=adding) as state:
    machine = demo_host(state, host)
    errors = demo_recipe_errors(machine, rid, text) or ([demo_recipe_in_use(machine, rid)] if adding and demo_recipe_in_use(machine, rid) else [])
    if not errors and adding:
      machine["list"] = [r for r in machine["list"] if r["id"] != rid] + [demo_recipe_row(rid, tomllib.loads(text))]
  return recipe_result(False, rid, errors) if errors else recipe_result(True, rid, message=f"Added recipe {rid}" if adding else f"Recipe {rid} is valid")


def demo_recipe_send(args):
  rid, text = read_recipe_file(args.file)
  return print_recipe_result(demo_recipe_check(args.host, args.verb, rid, text), args.json)


def demo_recipe_list(args):
  demo_list(args)


def demo_recipe_remove(args):
  rid = recipe(args.id)
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid), None)
    if row is None or not row.get("user"):
      raise Error(f"No recipe of yours named '{rid}'" + (" (it is a curated recipe, which can't be removed)" if row else ""))
    if demo_recipe_in_use(machine, rid):
      raise Error(demo_recipe_in_use(machine, rid))
    machine["list"] = [r for r in machine["list"] if r["id"] != rid]
  print(f"Removed recipe {rid}")


def demo_recipe_measure(args):
  """The engine's measure on a demo recipe of yours: its dry-run text, or (--yes) the variant measured, with numbers a
  little under what it expected. (The engine also leaves the model running; the demo doesn't set one up.)"""
  rid = recipe(args.id)
  with demo_state(write=args.yes) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid), None)
    if row is not None and not row.get("user"):
      raise Error(f"{rid} is a curated recipe: it ships its own measurements, and measure only works on your own recipes (add one with: omarchy agent local recipe add FILE)")
    if row is None:
      raise Error(f"No recipe of yours named '{rid}'")
    variant = next((v for v in row["_variants"] if v["ctx"] == args.ctx), None)
    if variant is None:
      raise Error(f"{rid} has no [[variant]] with ctx {args.ctx} (it has: {', '.join(str(v['ctx']) for v in row['_variants'])}); "
                  "add one with source = \"drafted\" or \"estimated\", then measure it")
    print(f"Measure {rid} at context {args.ctx} (now a {variant['source']} variant)")
    print(f"  download: {size_text(int(variant['peak_ram_gib'] * 2**29))} to download")
    print(f"  load: {row['name']} on {row['runtime']}, context {args.ctx}; it expects about {variant['peak_ram_gib']:g} GiB RAM and {variant['peak_gpu_gib']:g} GiB GPU")
    print("  while it runs, every other omarchy agent local command waits for it (the agents panel's start and stop too): typically a few minutes")
    print("  then: restarts the model if it runs, runs the bench (a few minutes), leaves it running, and rewrites this variant")
    if not args.yes:
      print("Nothing was changed. Run again with --yes to do it.")
      return
    variant.update(peak_ram_gib=round(variant["peak_ram_gib"] * 0.9, 1), peak_gpu_gib=round(variant["peak_gpu_gib"] * 0.9, 1), source="measured")
    machine["list"] = [demo_recipe_row(r["id"], {"name": r["name"], "summary": r["summary"], "runtime": r["runtime"], "vendor": r["vendor"],
                                                 "variant": r["_variants"], "_confirmed": r.get("_confirmed")}) if r["id"] == rid else r
                       for r in machine["list"]]
    print(f"Measured {rid} at context {args.ctx}: {variant['peak_ram_gib']:g} GiB RAM, {variant['peak_gpu_gib']:g} GiB GPU")


def demo_recipe_confirm(args):
  rid = recipe(args.id)
  with demo_state(write=True) as state:
    machine = demo_host(state, args.host)
    row = next((r for r in machine["list"] if r["id"] == rid and r.get("user")), None)
    if row is None:
      raise Error(f"No recipe of yours named '{args.id}'")
    estimated = [v for v in row["_variants"] if v["source"] == "estimated"]
    if not estimated:
      raise Error(f"Recipe {rid} has no estimated variant to confirm")
    row["_confirmed"] = True
    row.update(available=True, reason="")
  print(f"Confirmed {len(estimated)} estimated variant(s) of {rid}")


def demo_recipe(args):
  return {"validate": demo_recipe_send, "add": demo_recipe_send, "list": demo_recipe_list, "remove": demo_recipe_remove,
          "measure": demo_recipe_measure, "confirm": demo_recipe_confirm, "draft": cmd_recipe_draft, "author": cmd_recipe_author}[args.verb](args)


def demo_delete(args):
  if args.dry_run:
    rid = recipe(args.model)
    with demo_state() as state:
      machine = demo_host(state, args.host)
    row = machine["status"]["models"].get(rid)
    if row is None:
      raise Error(f"{rid} isn't set up on {args.host}")
    if row["unit"] == "installing":
      plan = {"recipe": rid, "setting_up": True, "bytes": row["install"]["done_bytes"]}
    else:
      # What a demo setup of it downloads (demo_use), so the two agree.
      r = next((r for r in machine["list"] if r["id"] == rid), {})
      plan = {"recipe": rid, "setting_up": False, "bytes": int((r.get("memory_gib") or 30) * 2**29)}
    print_remove_plan(plan, args.json)
    return
  with demo_state(write=True) as state:
    models = demo_host(state, args.host)["status"]["models"]
    if models.get(recipe(args.model), {}).get("unit") == "installing":
      del models[args.model]
      print(f"Cancelled the setup of {args.model}")
      return
    demo_set_up(models, args.model).update(unit="removing", sub_state="dead", since_ms=demo_now_ms(), expected_remove_seconds=3.0)
  print(f"Removed {args.model}")


def demo_peers(user):
  added = set(load_hosts())
  return [{**p, "target": f"{user}@{p['name']}", "added": f"{user}@{p['name']}" in added} for p in read_fixture("discover.json")]


def demo_add(args):
  name = ssh_target(args.host).rsplit("@", 1)[-1]
  with demo_state() as state:
    known = name in state["hosts"]
  if not known:
    peer = next((p for p in read_fixture("discover.json") if p["name"] == name and p["reachable"]), None)
    raise Error(f"{args.host} has no engine: run startdgx install {args.host}" if peer else f"{args.host} didn't answer in time")
  with hosts_changing() as hosts:
    hosts[args.host] = {"profile": next(iter(read_fixture("hosts.json").values()))["profile"]}
  print(f"{args.host} added")


def demo_says(verb):
  def run(args):
    print(f"Demo: would {verb} {ssh_target(args.host)}{' (dry run)' if getattr(args, 'dry_run', False) else ''}")
  return run


def demo_uninstall(args):
  """The uninstall's plan, as an install startdgx made would have it (podman added, the models' weights kept unless
  --delete-models); anything else only says what it would do."""
  if not (args.dry_run and args.json):
    return demo_says("uninstall from")(args)
  with demo_state() as state:
    machine = demo_host(state, args.host)
  installed = [r for r in machine["list"] if r["id"] in machine["status"]["models"]]
  weights = sum(int((r.get("memory_gib") or 30) * 2**29) for r in installed)
  recipes = sum(1 for r in machine["list"] if r.get("user"))
  where = f"~/{ENGINE_DATA} ({size_text(weights)} of model weights"
  steps = ["stop the engine's units (omarchy-agent-local-*.service)", f"remove ~/{QUADLET_DIR}/omarchy-agent-local.network",
           f"remove the podman network {NETWORK}", f"remove the podman secret {SECRET}",
           uninstall_state_text(bool(recipes) and not args.delete_recipes, recipes), f"delete ~/{ENGINE_CONFIG} (the engine's key, overlays and shares)"]
  steps += [f"delete {where})"] if args.delete_models else []
  steps += [f"delete the engine ~/{ENGINE_DIR}", "as root: disable linger for demo", f"as root: remove {AGENT_LINK}"]
  steps += ["as root: remove the packages podman"] if args.remove_packages else []
  steps += [f"delete {MANIFEST} and the backups", f"forget {args.host} here"]
  kept = ([] if args.delete_models else [f"keep {where}; --delete-models deletes them)"])
  kept += [] if args.remove_packages else ["keep the packages podman (the install added them; --remove-packages removes them)"]
  kept += [uninstall_recipes_kept()] if recipes and not args.delete_recipes else []
  print(json.dumps({"host": args.host, "steps": steps, "kept": kept, "manual": manual_steps(args.host), "models_bytes": weights,
                    "packages": ["podman"], "recipes": recipes}))


def demo_logs(args):
  with demo_state() as state:
    status = demo_host(state, args.host)["status"]
  rid = recipe(args.model) if args.model else status["last"]
  error = status["models"].get(rid or "", {}).get("error")
  print(f"Last error: {error}\n" if error else "", end="")
  print(f"Demo: {rid or 'no model'} on {args.host} has no logs")


DEMO_COMMANDS = {"status": demo_status, "list": demo_list, "start": demo_start, "stop": demo_stop, "share": demo_share, "use": demo_use, "variants": demo_variants, "recipe": demo_recipe, "delete": demo_delete,
                 "add": demo_add, "install": demo_says("install on"), "uninstall": demo_uninstall, "logs": demo_logs}


def build_parser():
  p = argparse.ArgumentParser(prog="startdgx", description=__doc__)
  sub = p.add_subparsers(dest="command", required=True)

  def add(name, fn, model=False, optional_model=False, timeout=60, description=None, timeout_help="%(default)s"):
    s = sub.add_parser(name, description=description)
    if name not in ("hosts", "engine"):
      s.add_argument("host")
    if model:
      s.add_argument("model")
    if optional_model:
      s.add_argument("model", nargs="?")
    s.add_argument("--timeout", type=int, default=timeout, help=f"seconds to wait for the host (default: {timeout_help})")
    s.set_defaults(fn=fn)
    return s

  e = sub.add_parser("engine"); e.add_argument("--json", action="store_true"); e.set_defaults(fn=cmd_engine)
  add("add", cmd_add)
  i = add("install", cmd_install, timeout=3600)
  i.add_argument("--dry-run", action="store_true", help="print what would change and change nothing")
  i.add_argument("--engine-path", metavar="DIR", help=f"copy this engine checkout instead of cloning {ENGINE_TAG}")
  i.add_argument("--replace-engine", action="store_true",
                 help=f"replace an engine startdgx didn't install, backing it up to ~/{ENGINE_BACKUP} for uninstall to put back")
  u = add("uninstall", cmd_uninstall, timeout=3600,
          description="Reverse startdgx install from its manifest on the host. The model weights are kept by default "
                      "(--delete-models deletes them). Afterwards, run omarchy agent local forget on each Omarchy machine "
                      "paired with the host; its ~/.ssh/authorized_keys entries are left for you to remove.")
  u.add_argument("--dry-run", action="store_true", help="print what would change and change nothing")
  u.add_argument("--delete-models", action="store_true", help="also delete the downloaded model weights (kept by default)")
  u.add_argument("--remove-packages", action="store_true", help="also remove the packages the install added")
  u.add_argument("--delete-recipes", action="store_true", help="also delete the recipes you added (kept by default)")
  u.add_argument("--json", action="store_true", help="with --dry-run: as {host, steps, kept, manual, models_bytes, packages, recipes}")
  d = sub.add_parser("discover", description="List the tailnet's online Linux machines and probe each over ssh, read-only, "
                     "for a DGX Spark. Installs nothing and adds nothing; it saves the host key of a machine ssh has never seen "
                     "(StrictHostKeyChecking=accept-new).")
  d.add_argument("--json", action="store_true")
  d.add_argument("--user", help="the ssh user on the peers (default: this machine's user)")
  d.add_argument("--timeout", type=int, default=20, help="seconds to wait for each peer")
  d.add_argument("--limit", type=int, default=60, help="seconds the whole discover may take; a peer not heard from by then is unreachable")
  d.set_defaults(fn=cmd_discover)
  add("forget", cmd_remove_host)
  h = sub.add_parser("hosts"); h.add_argument("--json", action="store_true"); h.set_defaults(fn=cmd_hosts)
  add("status", cmd_status)
  add("list", cmd_list)
  # start returns once the model has loaded, which can take minutes.
  add("start", cmd_start, model=True, timeout=600)
  add("stop", cmd_stop, optional_model=True)
  sh = add("share", cmd_share, model=True, timeout=120, description="Share a model with the other machines on the host's tailnet "
           "(the engine publishes it with tailscale serve), or stop with --off.")
  sh.add_argument("--off", action="store_true", help="stop sharing it")
  us = add("use", cmd_use, model=True, timeout=None, timeout_help="3600, or 120 with --detach")
  us.add_argument("--ctx", type=int, help="a context size the recipe has measured (startdgx variants lists them)")
  us.add_argument("--yes", action="store_true", help="confirm setting up a recipe of your own (it downloads and runs what you wrote)")
  us.add_argument("--detach", action="store_true", help="set the model up in the background and return; status shows its progress")
  va = add("variants", cmd_variants, model=True, description="List the context sizes a recipe has measured on the host, with the memory each needs.")
  va.add_argument("--json", action="store_true", help="as [{ctx, peak_ram_gib, peak_gpu_gib}]")
  rp = sub.add_parser("recipe", description="Your own recipes on a host: validate or add a .toml from this computer (the engine's "
                      "errors, one per line), list the host's recipes, or remove one of yours.")
  rv = rp.add_subparsers(dest="verb", required=True, metavar="validate|add|list|remove|measure|confirm|draft|author")
  for verb in ("validate", "add", "list", "remove", "measure", "confirm"):
    r = rv.add_parser(verb)
    r.add_argument("host")
    if verb in ("validate", "add"):
      r.add_argument("file", help="a recipe file on this computer; its name without .toml is the recipe's id")
      r.add_argument("--json", action="store_true", help="as {ok, id, errors, message}; a rejection is an answer, so it exits 0")
    if verb == "list":
      r.add_argument("--json", action="store_true")
    if verb in ("remove", "measure", "confirm"):
      r.add_argument("id")
    if verb == "measure":
      r.add_argument("--ctx", type=int, required=True, help="the context of the variant to measure")
      r.add_argument("--yes", action="store_true", help="download and load it, bench it and record the result; without this nothing changes")
    r.add_argument("--timeout", type=int, default=None if verb == "measure" else 60,
                   help="seconds to wait for the host (default: 60; measure --yes 3600)")
    r.set_defaults(fn=cmd_recipe)
  rd = rv.add_parser("draft", description="Write a user recipe for a Hugging Face repo that passes the Find checks (hf search), from this "
                     "computer, with no model: its pinned commit, license and one drafted variant whose placeholder numbers equal the weights' size.")
  rd.add_argument("repo", help="OWNER/NAME")
  rd.add_argument("--id", help="the recipe id (default: the repo name slugified, owner dropped, plus -tensorfold)")
  rd.add_argument("--out", help="the folder to write ID.toml in (default: ~/.local/state/startdgx/drafts)")
  rd.add_argument("--host", help="also refuse an id this machine's recipes (curated or yours) already have")
  rd.add_argument("--json", action="store_true", help="as {ok, id, repo, path, revision, license, weights_bytes, placeholder_gib, source, warnings}")
  rd.set_defaults(fn=cmd_recipe)
  ra = rv.add_parser("author", description="Draft a recipe for a Hugging Face repo on HOST (as recipe draft), then open a terminal running the "
                     "agent (agent_command in ~/.config/startdgx/config.json, default claude) with the authoring brief, when the draft needs "
                     "judgement (a drafter, rope scaling, server arguments the template cannot set) or with --agent.")
  ra.add_argument("host")
  ra.add_argument("repo", help="OWNER/NAME")
  ra.add_argument("--id", help="the recipe id (default: the repo name slugified, owner dropped, plus -tensorfold)")
  ra.add_argument("--out", help="the folder to write ID.toml in (default: ~/.local/state/startdgx/drafts)")
  ra.add_argument("--agent", action="store_true", help="start the agent even when the draft needs no judgement")
  ra.add_argument("--here", action="store_true", help="run the agent in this terminal instead of opening one")
  ra.add_argument("--json", action="store_true", help="as recipe draft --json plus agent: whether an agent starts")
  ra.set_defaults(fn=cmd_recipe)
  de = add("delete", cmd_delete, model=True)
  de.add_argument("--dry-run", action="store_true", help="print what removing it would free and change nothing")
  de.add_argument("--json", action="store_true", help="with --dry-run: as {recipe, setting_up, bytes}")
  add("logs", passthrough("logs"), optional_model=True, description="Show a model's last error and logs (default: the last one started).")
  hp = sub.add_parser("hf", description="Hugging Face, read-only, from this computer: search the MLX affine 4-bit repos of known families.")
  hv = hp.add_subparsers(dest="verb", required=True, metavar="search")
  hs = hv.add_parser("search", description="List the top 50 mlx repos for QUERY that are affine 4-bit by their config.json, of a "
                     "known family (known-families.json) and not gated. Memory is shown as facts only, never a fit.")
  hs.add_argument("query")
  hs.add_argument("--json", action="store_true", help="as [{repo, params, size_bytes, license, base_model, label}]")
  hs.set_defaults(fn=cmd_hf_search)
  la = sub.add_parser("launch", description="Open a floating terminal running startdgx install HOST, uninstall HOST, "
                      "logs HOST [MODEL] or author HOST REPO (recipe author --agent --here), for the panel: sudo there can ask for a password.")
  la.add_argument("verb", metavar="install|uninstall|logs|author")
  la.add_argument("host")
  la.add_argument("model", nargs="?")
  la.add_argument("--replace-engine", action="store_true", help="with install: replace an engine startdgx didn't install")
  la.add_argument("--delete-models", action="store_true", help="with uninstall: also delete the model weights")
  la.add_argument("--remove-packages", action="store_true", help="with uninstall: also remove the packages the install added")
  la.add_argument("--delete-recipes", action="store_true", help="with uninstall: also delete the recipes you added")
  la.set_defaults(fn=cmd_launch)
  return p


def main(argv):
  global DEMO
  args = build_parser().parse_args(argv)
  for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(signum, stop_children)
  try:
    if demo_enabled():
      DEMO = True
      wall()
      with demo_state():
        pass
      args.fn = DEMO_COMMANDS.get(args.command, args.fn)
    return args.fn(args) or 0
  except Error as error:
    # An error can quote a host (rsync's or git's stderr, a tailnet name): its controls go too.
    print(f"Error: {clean(str(error))}", file=sys.stderr)
    return 1


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
