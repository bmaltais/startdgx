#!/usr/bin/env bash
# The devkit's `qmllint`, run for this checkout (scripts/devkit, a submodule; docs/testing.md).
DEVKIT_APP_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export DEVKIT_APP_ROOT
# qmllint with the Omarchy shell's modules on its import path (scripts/lint/qmllint).
PATH=$DEVKIT_APP_ROOT/scripts/lint:$PATH
kit=$DEVKIT_APP_ROOT/scripts/devkit/bin/qmllint
[[ -x $kit ]] || { echo "scripts/devkit is empty: git submodule update --init scripts/devkit" >&2; exit 1; }
exec "$kit" "$@"
